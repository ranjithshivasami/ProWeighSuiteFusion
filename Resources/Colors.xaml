<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         BRAND THEME — admin-switchable style variables.
         Change via: Configuration -> App Settings -> Brand Theme,
         or edit %AppData%\ProWeighSuitePlatforms\appsettings.json:
           "BrandPrimaryHex": "#086BE8", "BrandThemeName": "Blue"
         ThemeService.Apply() updates all Brand* + legacy keys live.
         XAML MUST use {DynamicResource BrandPrimaryBrush} (not Static)
         for live switching. StaticResource only reads startup value.
         ============================================================ -->

    <!-- Primary Brand (default Orange #FF9F00; overridden at runtime by ThemeService) -->
    <Color x:Key="BrandPrimaryColor">#FF9F00</Color>
    <Color x:Key="BrandPrimaryDarkColor">#D98A00</Color>
    <Color x:Key="BrandPrimaryLightColor">#FFE5CC</Color>
    <Color x:Key="BrandPrimarySoftColor">#FFF3E0</Color>
    <Color x:Key="BrandOnPrimaryColor">#434242</Color>
    <Color x:Key="BrandGradientStartColor">#FFA726</Color>
    <Color x:Key="BrandGradientEndColor">#F59A00</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{StaticResource BrandPrimaryLightColor}"/>
    <SolidColorBrush x:Key="BrandPrimarySoftBrush" Color="{StaticResource BrandPrimarySoftColor}"/>
    <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="{StaticResource BrandOnPrimaryColor}"/>

    <!-- Secondary Brand (accent supplied by the host profile; ThemeService applies it) -->
    <Color x:Key="BrandSecondaryColor">#CDDC39</Color>
    <Color x:Key="BrandSecondaryDarkColor">#A9B62E</Color>
    <Color x:Key="BrandSecondaryLightColor">#EEF4C4</Color>
    <Color x:Key="BrandSecondarySoftColor">#F7FADF</Color>
    <Color x:Key="BrandOnSecondaryColor">#434242</Color>

    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}"/>
    <SolidColorBrush x:Key="BrandSecondaryDarkBrush" Color="{StaticResource BrandSecondaryDarkColor}"/>
    <SolidColorBrush x:Key="BrandSecondaryLightBrush" Color="{StaticResource BrandSecondaryLightColor}"/>
    <SolidColorBrush x:Key="BrandSecondarySoftBrush" Color="{StaticResource BrandSecondarySoftColor}"/>
    <SolidColorBrush x:Key="BrandOnSecondaryBrush" Color="{StaticResource BrandOnSecondaryColor}"/>

    <!-- Legacy aliases — keep old name working; ThemeService keeps them in sync -->
    <Color x:Key="PrimaryOrangeColor">#FF9F00</Color>
    <Color x:Key="PrimaryDarkColor">#434242</Color>
    <Color x:Key="PrimaryBlackColor">#000000</Color>

    <!-- Background Colors -->
    <Color x:Key="BackgroundLightGrayColor">#E6E6E6</Color>
    <Color x:Key="BackgroundWhiteColor">#FFFFFF</Color>
    <Color x:Key="BackgroundDarkGrayColor">#555555</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderGrayColor">#C5C8CC</Color>
    <Color x:Key="BorderLightGrayColor">#DDDDDD</Color>
    <Color x:Key="BorderMediumGrayColor">#E0E0E0</Color>

    <!-- DataGrid Colors -->
    <Color x:Key="DataGridHeaderColor">#F5F5F5</Color>
    <Color x:Key="DataGridTextColor">#424242</Color>
    <Color x:Key="DataGridRowAlternateColor">#FAFAFA</Color>
    <Color x:Key="DataGridHoverColor">#F5F5F5</Color>
    <Color x:Key="DataGridEditableColor">#FFF9E6</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessGreenColor">#4CAF50</Color>
    <Color x:Key="ErrorRedColor">#F44336</Color>
    <Color x:Key="WarningOrangeColor">#FFA500</Color>
    <Color x:Key="InfoBlueColor">#1976D2</Color>
    <Color x:Key="InfoLightBlueColor">#E3F2FD</Color>

    <!-- Accent Colors (mirrors Brand soft/light; kept for compat) -->
    <Color x:Key="AccentLightOrangeColor">#FFF3E0</Color>
    <Color x:Key="AccentMediumOrangeColor">#FFE5CC</Color>

    <!-- Login Screen Colors -->
    <Color x:Key="LoginEllipse1Color">#363636</Color>
    <Color x:Key="LoginEllipse2Color">#626262</Color>
    <Color x:Key="LoginEllipse3Color">#2C2C2C</Color>

    <!-- Semantic surface/text tokens -->
    <Color x:Key="BrandSurfaceColor">#FFFFFF</Color>
    <Color x:Key="BrandSurfaceAltColor">#F7F8FA</Color>
    <Color x:Key="BrandTextPrimaryColor">#26334D</Color>
    <Color x:Key="BrandTextSecondaryColor">#5B6472</Color>
    <Color x:Key="BrandBorderColor">#E7EAEF</Color>
    <Color x:Key="MutedTextColor">#667184</Color>
    <Color x:Key="SidebarTextColor">#3A4250</Color>
    <Color x:Key="SidebarMutedTextColor">#8A93A3</Color>

    <!-- SolidColorBrush Resources -->
    <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="{StaticResource PrimaryOrangeColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryBlackBrush" Color="{StaticResource PrimaryBlackColor}"/>

    <SolidColorBrush x:Key="BackgroundLightGrayBrush" Color="{StaticResource BackgroundLightGrayColor}"/>
    <SolidColorBrush x:Key="BackgroundWhiteBrush" Color="{StaticResource BackgroundWhiteColor}"/>
    <SolidColorBrush x:Key="BackgroundDarkGrayBrush" Color="{StaticResource BackgroundDarkGrayColor}"/>

    <SolidColorBrush x:Key="BorderGrayBrush" Color="{StaticResource BorderGrayColor}"/>
    <SolidColorBrush x:Key="BorderLightGrayBrush" Color="{StaticResource BorderLightGrayColor}"/>
    <SolidColorBrush x:Key="BorderMediumGrayBrush" Color="{StaticResource BorderMediumGrayColor}"/>

    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="{StaticResource DataGridHeaderColor}"/>
    <SolidColorBrush x:Key="DataGridTextBrush" Color="{StaticResource DataGridTextColor}"/>
    <SolidColorBrush x:Key="DataGridRowAlternateBrush" Color="{StaticResource DataGridRowAlternateColor}"/>
    <SolidColorBrush x:Key="DataGridHoverBrush" Color="{StaticResource DataGridHoverColor}"/>
    <SolidColorBrush x:Key="DataGridEditableBrush" Color="{StaticResource DataGridEditableColor}"/>

    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}"/>
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRedColor}"/>
    <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource WarningOrangeColor}"/>
    <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource InfoBlueColor}"/>
    <SolidColorBrush x:Key="InfoLightBlueBrush" Color="{StaticResource InfoLightBlueColor}"/>

    <SolidColorBrush x:Key="AccentLightOrangeBrush" Color="{StaticResource AccentLightOrangeColor}"/>
    <SolidColorBrush x:Key="AccentMediumOrangeBrush" Color="{StaticResource AccentMediumOrangeColor}"/>

    <SolidColorBrush x:Key="LoginEllipse1Brush" Color="{StaticResource LoginEllipse1Color}"/>
    <SolidColorBrush x:Key="LoginEllipse2Brush" Color="{StaticResource LoginEllipse2Color}"/>
    <SolidColorBrush x:Key="LoginEllipse3Brush" Color="{StaticResource LoginEllipse3Color}"/>

    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="{StaticResource BrandSurfaceColor}"/>
    <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="{StaticResource BrandSurfaceAltColor}"/>
    <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="{StaticResource BrandTextPrimaryColor}"/>
    <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="{StaticResource BrandTextSecondaryColor}"/>
    <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorderColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="{StaticResource SidebarMutedTextColor}"/>

</ResourceDictionary>
