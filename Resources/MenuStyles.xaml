<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light sidebar nav (BridgeX look). Active item uses full theme color
         BrandPrimaryBrush / BrandOnPrimaryBrush so theme switching keeps working. -->

    <ControlTemplate x:Key="Menu_Template" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="Transparent" Padding="4,0" Margin="0,1,0,1">
            <Grid Height="40">
                <Border x:Name="ActiveIndicator" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Opacity="0"/>
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="Icon" Content="{TemplateBinding Icon}"
                                      Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource BrandPrimaryBrush}"/>
                    <ContentPresenter x:Name="HeaderHost" ContentSource="Header"
                                      Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                      TextBlock.Foreground="{DynamicResource BrandPrimaryBrush}" TextBlock.FontSize="14" TextBlock.FontWeight="Normal" TextOptions.TextFormattingMode="Display"/>
                    <Border x:Name="Badge" Grid.Column="2" Width="18" Height="18" CornerRadius="9"
                            Background="#e0472f" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="11" FontWeight="Bold" Foreground="White"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                <Setter TargetName="ActiveIndicator" Property="Background" Value="#f4f6fa"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{DynamicResource BrandPrimaryDarkBrush}"/>
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource BrandPrimaryDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="#a7adb8"/>
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="#a7adb8"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                <Setter TargetName="ActiveIndicator" Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                <Setter TargetName="ActiveIndicator" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsHighlighted" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                <Setter TargetName="ActiveIndicator" Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                <Setter TargetName="ActiveIndicator" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Menu_SubMenu_Template" TargetType="{x:Type MenuItem}">
        <Grid>
            <Border x:Name="Border" Background="Transparent" Padding="4,0" Margin="0,1,0,1">
                <Grid Height="40">
                    <Border x:Name="ActiveIndicator" CornerRadius="8" Background="{DynamicResource BrandPrimaryBrush}" Opacity="0"/>
                    <Grid Margin="10,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Icon" Content="{TemplateBinding Icon}"
                                          Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource BrandPrimaryBrush}"/>
                        <ContentPresenter x:Name="HeaderHost" ContentSource="Header"
                                          Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                          TextBlock.Foreground="{DynamicResource BrandPrimaryBrush}" TextBlock.FontSize="14" TextBlock.FontWeight="Normal" TextOptions.TextFormattingMode="Display"/>
                        <Path x:Name="Arrow" Grid.Column="2" Data="M 0 0 L 5 4 L 0 8 Z" Fill="{DynamicResource BrandPrimaryBrush}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Right"
                   HorizontalOffset="4"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade"
                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="White" BorderBrush="#e7eaef" BorderThickness="1"
                        CornerRadius="8" Padding="4" MinWidth="190">
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                <Setter TargetName="ActiveIndicator" Property="Background" Value="#f4f6fa"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{DynamicResource BrandPrimaryDarkBrush}"/>
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource BrandPrimaryDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                <Setter TargetName="ActiveIndicator" Property="Background" Value="#f4f6fa"/>
                <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 4 0 L 8 5 Z"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Sub item (indented, lighter) -->
    <ControlTemplate x:Key="Item_Template" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="Transparent" Padding="4,0" Margin="0,1,0,1">
            <Grid Height="34">
                <Border x:Name="ActiveIndicator" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Opacity="0"/>
                <Grid Margin="30,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="Icon" Content="{TemplateBinding Icon}"
                                      Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource BrandPrimaryBrush}"/>
                    <ContentPresenter x:Name="HeaderHost" ContentSource="Header"
                                      Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                      TextBlock.Foreground="{DynamicResource BrandPrimaryBrush}" TextBlock.FontSize="13" TextBlock.FontWeight="Normal" TextOptions.TextFormattingMode="Display"/>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                <Setter TargetName="ActiveIndicator" Property="Background" Value="#f4f6fa"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{DynamicResource BrandPrimaryDarkBrush}"/>
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource BrandPrimaryDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                <Setter TargetName="ActiveIndicator" Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                <Setter TargetName="ActiveIndicator" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
