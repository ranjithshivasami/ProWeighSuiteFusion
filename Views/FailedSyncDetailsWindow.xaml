<Window x:Class="ProWeighSuitePlatforms.Views.FailedSyncDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sync Item Details"
        Height="600" Width="800"
        MinWidth="620" MinHeight="450" MaxWidth="1000" MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Sync Item Details"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="0,0,0,5"/>
            <Border Background="{Binding StatusColor}"
                    CornerRadius="3"
                    Padding="10,5"
                    HorizontalAlignment="Left">
                <TextBlock Text="{Binding Status}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="14"/>
            </Border>
        </StackPanel>

        <!-- Details ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ID Section -->
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="15"
                        Margin="0,0,0,10"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Item ID:"
                                   Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <TextBox Text="{Binding Id, Mode=OneWay}"
                                 Grid.Row="0" Grid.Column="1"
                                 IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="File Path:"
                                   Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FilePath, Mode=OneWay}"
                                 Grid.Row="1" Grid.Column="1"
                                 IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Timing Section -->
                <TextBlock Text="Timing Information"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,10,0,10"/>
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="15"
                        Margin="0,0,0,10"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Queued At:"
                                   Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding QueuedAtFormatted}"
                                   Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Last Retry At:"
                                   Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding LastRetryAtFormatted}"
                                   Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Retry Count:"
                                   Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                        <TextBlock Text="{Binding RetryCount}"
                                   Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   Foreground="#D32F2F"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- Audit Entry Section -->
                <TextBlock Text="Audit Entry Details"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,10,0,10"/>
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="15"
                        Margin="0,0,0,10"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Action:"
                                   Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Action}"
                                   Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Category:"
                                   Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Category}"
                                   Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Username:"
                                   Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Username}"
                                   Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Details:"
                                   Grid.Row="3" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   VerticalAlignment="Top"/>
                        <TextBox Text="{Binding Details, Mode=OneWay}"
                                 Grid.Row="3" Grid.Column="1"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 MinHeight="60"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <!-- Error Section -->
                <TextBlock Text="Error Information"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,10,0,10"/>
                <Border Background="#FFEBEE"
                        BorderBrush="#D32F2F"
                        BorderThickness="1"
                        Padding="15"
                        CornerRadius="4">
                    <TextBox Text="{Binding LastError, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             Foreground="#D32F2F"
                             FontWeight="Medium"
                             MinHeight="60"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Grid.Row="2"
                Content="Close"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                Click="CloseButton_Click"
                Style="{StaticResource MaterialDesignFlatButton}"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Width="100"/>
    </Grid>
</Window>
