<Window x:Class="ProWeighSuitePlatforms.Views.AuditLogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Audit Log Viewer"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Audit Log Viewer"
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                       Margin="0,0,0,5"/>
            <TextBlock Text="View, search, and export audit logs for compliance and security monitoring"
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Filter Section -->
        <Border Grid.Row="1" 
                Background="White"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,20,12,20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: From Date -->
                <DatePicker Grid.Row="0" Grid.Column="0"
                            SelectedDate="{Binding FromDate}"
                            materialDesign:HintAssist.Hint="From Date"
                            materialDesign:HintAssist.Background="White"
                            Style="{StaticResource FormDatePickerStyle}"
                            Padding="5"
                            Background="White"
                            BorderBrush="#d9dee7"
                            FontSize="14"/>

                <!-- Row 0: To Date -->
                <DatePicker Grid.Row="0" Grid.Column="2"
                            SelectedDate="{Binding ToDate}"
                            materialDesign:HintAssist.Hint="To Date"
                            materialDesign:HintAssist.Background="White"
                            Style="{StaticResource FormDatePickerStyle}"
                            Padding="5"
                            Background="White"
                            BorderBrush="#d9dee7"
                            FontSize="14"/>

                <!-- Row 0: Category -->
                <ComboBox Grid.Row="0" Grid.Column="4"
                          ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory}"
                          materialDesign:HintAssist.Hint="Category"
                          materialDesign:HintAssist.Background="White"
                          Style="{StaticResource FormComboBoxStyle}"
                          Padding="5"
                          Background="White"
                          BorderBrush="#d9dee7"
                          FontSize="14"/>

                <!-- Row 0: Search Button -->
                <Button Grid.Row="0" Grid.Column="6"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        Background="{DynamicResource BrandPrimaryBrush}"
                        BorderBrush="{DynamicResource BrandPrimaryBrush}"
                        Foreground="#434242"
                        Width="120"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>

                <!-- Row 2: Search Text -->
                <TextBox Grid.Row="2" Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search action, username, details..."
                         materialDesign:HintAssist.Background="White"
                         Style="{StaticResource FormTextBoxStyle}"
                         Padding="5"
                         Background="Transparent"
                         BorderBrush="#d9dee7"
                         FontSize="14">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Row 2: Severity -->
                <ComboBox Grid.Row="2" Grid.Column="2"
                          ItemsSource="{Binding SeverityOptions}"
                          SelectedItem="{Binding SelectedSeverity}"
                          materialDesign:HintAssist.Hint="Severity"
                          materialDesign:HintAssist.Background="White"
                          Style="{StaticResource FormComboBoxStyle}"
                          Padding="5"
                          Background="White"
                          BorderBrush="#d9dee7"
                          FontSize="14"/>

                <!-- Row 2: Clear Filters Button -->
                <Button Grid.Row="2" Grid.Column="6"
                        Content="Clear Filters"
                        Command="{Binding ClearFiltersCommand}"
                        Background="#757575"
                        BorderBrush="#757575"
                        Foreground="White"
                        Width="120"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0">
            
            <Grid>
                <!-- Loading Overlay -->
                <Grid Background="#80FFFFFF" 
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                      Panel.ZIndex="999">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True"
                                     Width="50" Height="50"
                                     Margin="0,0,0,10"/>
                        <TextBlock Text="Loading audit logs..." 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid : no hard MinWidth so 1024px square IPC fits;
                     columns scroll horizontally inside the grid when narrow. -->
                <DataGrid ItemsSource="{Binding AuditEntries}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    
                    <DataGrid.Columns>
                        <!-- Timestamp -->
                        <DataGridTextColumn Header="Time" 
                                            Binding="{Binding TimeFormatted}"
                                            Width="100"
                                            MinWidth="100"/>

                        <!-- Severity with Color -->
                        <DataGridTemplateColumn Header="Severity" 
                                                Width="100"
                                                MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding SeverityColor}"
                                            CornerRadius="3"
                                            Padding="6,3">
                                        <TextBlock Text="{Binding Severity}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Category with Icon -->
                        <DataGridTemplateColumn Header="Category" 
                                                Width="150"
                                                MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding CategoryIcon}" 
                                                                 Width="16" Height="16" 
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Category}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action -->
                        <DataGridTextColumn Header="Action" 
                                            Binding="{Binding Action}"
                                            Width="180"
                                            MinWidth="150"/>

                        <!-- Username -->
                        <DataGridTextColumn Header="Username" 
                                            Binding="{Binding Username}"
                                            Width="120"
                                            MinWidth="100"/>

                        <!-- Entity -->
                        <DataGridTemplateColumn Header="Entity" 
                                                Width="180"
                                                MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding EntityType, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" #"/>
                                        <Run Text="{Binding EntityId, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Details -->
                        <DataGridTemplateColumn Header="Details" 
                                                Width="350"
                                                MinWidth="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DetailsTruncated}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Details}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Machine Name -->
                        <DataGridTextColumn Header="Machine" 
                                            Binding="{Binding MachineName}"
                                            Width="140"
                                            MinWidth="120"/>
                    </DataGrid.Columns>

                    <!-- Row Style with Double-Click -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Action Buttons and Status -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Message -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}">
                    <Run Text="Showing "/>
                    <Run Text="{Binding AuditEntries.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=" audit log entries"/>
                </TextBlock>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="View Details"
                        Command="{Binding ViewDetailsCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,10,0"
                        Width="120">
                    <Button.ToolTip>
                        <ToolTip Content="View full details of selected entry"/>
                    </Button.ToolTip>
                </Button>

                <Button Content="Export to CSV"
                        Command="{Binding ExportToCsvCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,10,0"
                        Width="130"
                        Background="#4CAF50"
                        BorderBrush="#4CAF50">
                    <Button.ToolTip>
                        <ToolTip Content="Export filtered results to CSV file"/>
                    </Button.ToolTip>
                </Button>

                <Button Content="Export to Excel"
                        Command="{Binding ExportToExcelCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Width="130"
                        Background="#4CAF50"
                        BorderBrush="#4CAF50">
                    <Button.ToolTip>
                        <ToolTip Content="Export filtered results to Excel-compatible file"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
