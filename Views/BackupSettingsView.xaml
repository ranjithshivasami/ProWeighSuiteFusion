<UserControl x:Class="ProWeighSuitePlatforms.Views.BackupSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
          
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="5">
                    <StackPanel MaxWidth="1200">
                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Database" Width="32" Height="32" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Backup Settings" Style="{StaticResource PageTitleStyle}"/>
                                    <TextBlock Text="Configure local and cloud backups for your database" Style="{StaticResource SubtitleStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" FontSize="12" Foreground="Gray" VerticalAlignment="Center">
                                <Run Text="*" Foreground="Red" FontSize="14"/>
                                <Run Text=" required fields"/>
                            </TextBlock>
                        </Grid>

                        <!-- Form -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Enabled + Local Backup Folder -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Enable Backups" IsChecked="{Binding Settings.Enabled}" VerticalAlignment="Center" />
                                    <TextBlock Text="    " />
                                    <TextBlock Text="Local Backup Folder:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="* " Foreground="Red" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="12,6" />
                                    <TextBox FontSize="16"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             materialDesign:HintAssist.Hint="Local Backup Folder"
                                             materialDesign:HintAssist.Background="White"
                                             Padding="5"
                                             Background="Transparent"
                                             BorderBrush="#d9dee7"
                                             MaxLength="260"
                                             Text="{Binding Settings.BackupFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Text="{Binding BackupFolderError}" FontSize="11" Foreground="Red" Margin="30,3,0,0" Visibility="{Binding BackupFolderError, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Row 1: Schedule and interval -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="20,0,0,12" Background="Transparent">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" ItemHeight="Auto" MinWidth="220">                                    
                                    <ComboBox SelectedValue="{Binding Settings.ScheduleType, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Content"
                                              materialDesign:HintAssist.Hint="Schedule"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              Padding="8"
                                              FontSize="14"
                                              VerticalContentAlignment="Center"
                                              Width="140"
                                              Margin="0,6,8,0">
                                        <ComboBoxItem Content="Manual" />
                                        <ComboBoxItem Content="Minutes" />
                                        <ComboBoxItem Content="Hourly" />
                                        <ComboBoxItem Content="Daily" />
                                        <ComboBoxItem Content="Weekly" />
                                    </ComboBox>

                                    <StackPanel>
                                        <TextBox FontSize="16" 
                                                 materialDesign:HintAssist.Hint="Interval"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 Padding="5"
                                                 Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="140" Margin="0,6,8,0" />
                                        <TextBlock Text="{Binding IntervalError}" FontSize="11" Foreground="Red" Margin="4,2,0,0" Visibility="{Binding IntervalError, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBox FontSize="16" 
                                             Padding="5"
                                             materialDesign:HintAssist.Hint="Time (HH:mm)"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding Settings.TimeOfDay}" Width="140" Margin="0,6,8,0" />

                                    <StackPanel>
                                        <TextBox FontSize="16"
                                                 Padding="5"
                                                 materialDesign:HintAssist.Hint="Retention"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 Text="{Binding RetentionText, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,6,8,0" />
                                        <TextBlock Text="{Binding RetentionError}" FontSize="11" Foreground="Red" Margin="4,2,0,0" Visibility="{Binding RetentionError, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </WrapPanel>
                            </Border>

                            <!-- Row 2: Cloud Backup -->
                            <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Style="{StaticResource SettingsCardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Cloud Backup (OneDrive / Network Share)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                    <CheckBox Content="Enable cloud backup" IsChecked="{Binding Settings.CloudBackupEnabled}" Margin="0,0,0,8" />

                                    <TextBlock Text="{Binding OneDriveStatus}" FontSize="11" Foreground="#888" Margin="0,0,0,8" />

                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseCloudFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="12,6" />
                                        <TextBox FontSize="16"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 materialDesign:HintAssist.Hint="Cloud / Network Backup Folder"
                                                 materialDesign:HintAssist.Background="White"
                                                 Padding="5"
                                                 Background="Transparent"
                                                 BorderBrush="#d9dee7"
                                                 MaxLength="260"
                                                 Text="{Binding Settings.CloudBackupFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding CloudFolderError}" FontSize="11" Foreground="Red" Margin="4,3,0,0" Visibility="{Binding CloudFolderError, Converter={StaticResource NullToVisibilityConverter}}" />

                                    <Border Background="#E3F2FD" CornerRadius="4" Padding="10" Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#1565C0">
                                                <Run FontWeight="SemiBold">How it works:</Run>
                                                <Run Text=" Backups are copied to a machine-specific subfolder ("/>
                                                <Run FontWeight="SemiBold" Text="{Binding Source={x:Static sys:Environment.MachineName}, Mode=OneWay}"
                                                     xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                                                <Run Text=") inside the cloud folder. This allows multiple machines to share the same OneDrive account safely."/>
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#1565C0" Margin="0,4,0,0">
                                                <Run FontWeight="SemiBold">Tip:</Run>
                                                <Run Text=" Use your OneDrive synced folder, a network share (\\server\backups), or any cloud-synced folder (Google Drive, Dropbox)."/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Row 3: Notifications -->
                            <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0" Style="{StaticResource SettingsCardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Notifications" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                    <CheckBox Content="Show system notifications on backup success/failure" IsChecked="{Binding Settings.SystemNotificationEnabled}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                        </Grid>

                        <!-- Info / Status Section -->
                        <Border Background="#FFF8E1" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0" Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#F57C00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#5D4037" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="View Status" Command="{Binding ViewStatusCommand}" Style="{StaticResource InfoButtonStyle}" Margin="0,0,8,0" Padding="12,8" ToolTip="View backup service status and diagnostics">
                            </Button>

                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="12,8">
                            </Button>

                            <Button Content="Run Backup Now" Command="{Binding RunBackupNowCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8">
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>