<UserControl x:Class="ProWeighSuitePlatforms.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:config="clr-namespace:ProWeighSuitePlatforms.Configuration"
             mc:Ignorable="d"
             x:Name="ShellRoot">

    <UserControl.Resources>
        <Style x:Key="ShellNavigationChildItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#009688"/>
            <Setter Property="Header" Value="{Binding Title}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
            <Setter Property="IsCheckable" Value="True"/>
            <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}"/>
            <Setter Property="Icon" Value="{Binding Icon}"/>
            <Setter Property="Template" Value="{StaticResource Item_Template}"/>
            <EventSetter Event="PreviewMouseDown" Handler="MenuItem_PreviewMouseDown"/>
        </Style>
        <Style x:Key="ShellNavigationItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#009688"/>
            <Setter Property="Header" Value="{Binding Title}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
            <Setter Property="IsCheckable" Value="True"/>
            <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}"/>
            <Setter Property="Icon" Value="{Binding Icon}"/>
            <Setter Property="Template" Value="{StaticResource Menu_Template}"/>
            <EventSetter Event="PreviewMouseDown" Handler="MenuItem_PreviewMouseDown"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="Template" Value="{StaticResource Item_Template}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasChildren}" Value="True">
                    <Setter Property="Template" Value="{StaticResource Menu_SubMenu_Template}"/>
                    <Setter Property="IsCheckable" Value="False"/>
                    <Setter Property="ItemsSource" Value="{Binding Children}"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource ShellNavigationChildItemStyle}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Storyboard x:Key="OpenMenu">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Width" Storyboard.TargetName="GridMenu">
                <EasingDoubleKeyFrame KeyTime="0" Value="60"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="220">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="SmallLogoImage" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="LogoImage" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="CloseMenu">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Width" Storyboard.TargetName="GridMenu">
                <EasingDoubleKeyFrame KeyTime="0" Value="220"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="60">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="LogoImage" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="SmallLogoImage" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="ButtonOpenMenu">
            <BeginStoryboard Storyboard="{StaticResource OpenMenu}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="ButtonCloseMenu">
            <BeginStoryboard Storyboard="{StaticResource CloseMenu}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Border Background="{DynamicResource BrandSurfaceBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SIDEBAR : auto-collapses to icon rail on narrow/square IPC screens.
                 Width lives in Style (not a local value) so the <950px trigger can
                 override it. Manual open/close storyboards still animate Width. -->
            <Border x:Name="GridMenu" Grid.Column="0" Grid.RowSpan="3"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="220"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=950}" Value="True">
                                <Setter Property="Width" Value="60"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand : full logo on wide, icon only on narrow/square IPC -->
                    <Grid Grid.Row="0" Margin="0,10,0,10">
                        <Grid x:Name="SmallLogoImage">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=950}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Image Source="{DynamicResource BrandLogoImage}" Width="34" Height="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="LogoImage">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=950}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Image Source="{DynamicResource BrandLogoImage}" Width="40" Height="40"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static config:BrandingInfo.Name}" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                        <TextBlock Text="{x:Static config:BrandingInfo.Suffix}" FontWeight="ExtraBold" FontSize="13" Margin="3,0,0,0" Foreground="{DynamicResource BrandPrimaryDarkBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Static config:BrandingInfo.Tagline}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SidebarMutedTextBrush}" Margin="1,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Nav -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" Background="Transparent">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="4"/>
                                <Setter Property="MinWidth" Value="4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Width" Value="Auto"/>
                                        <Setter Property="Height" Value="4"/>
                                        <Setter Property="MinHeight" Value="4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Width" Value="6"/>
                                        <Setter Property="MinWidth" Value="6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="Thumb" x:Key="{x:Type Thumb}">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#DDE0E6" CornerRadius="2" Margin="1"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <Menu Background="Transparent"
                              Foreground="#009688"
                              ItemsSource="{Binding NavigationItems}"
                              ItemContainerStyle="{StaticResource ShellNavigationItemStyle}">
                            <Menu.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </Menu.ItemsPanel>
                        </Menu>
                    </ScrollViewer>

                    <!-- Secure box : hidden on narrow/square IPC (icon rail has no room) -->
                    <Border Grid.Row="2" Margin="12,6,12,0" Background="#e9f9ee" BorderBrush="#cdeedb" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=950}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="18" Height="18" Foreground="#1fa855" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="System Secure" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandTextPrimaryBrush}"/>
                                <TextBlock Text="All systems operational" FontSize="11" FontWeight="Normal" TextOptions.TextFormattingMode="Display" Foreground="#1fa855"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Version : hidden on narrow/square IPC -->
                    <TextBlock Grid.Row="3" FontSize="11" Foreground="#a7adb8" HorizontalAlignment="Center" Margin="0,10,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=950}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Version "/><Run Text="{StaticResource AppVersion}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- TOPBAR -->
            <Border Grid.Row="0" Grid.Column="1" Height="48" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ButtonOpenMenu" Width="36" Height="36" Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0" Background="Transparent" Click="ButtonOpenMenu_Click" ToolTip="Open menu" Visibility="Collapsed">
                            <materialDesign:PackIcon Kind="Menu" Width="18" Height="18" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                        </Button>
                        <Button x:Name="ButtonCloseMenu" Width="36" Height="36" Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0" Background="Transparent" Click="ButtonCloseMenu_Click" ToolTip="Close menu">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                        </Button>
                        <TextBlock Text="{Binding CurrentContentTitle}" FontSize="16" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding CurrentContentTitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <!-- Velopack Update (SuperAdmin) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Command="{Binding CheckForUpdatesCommand}"
                                ToolTip="{Binding UpdateStatusText}"
                                Padding="10,6" Margin="0,0,8,0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Download" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Update" FontSize="12.5" FontWeight="Normal" TextOptions.TextFormattingMode="Display" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCheckingForUpdate}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Loading" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Checking..." FontSize="12.5" FontWeight="Normal" TextOptions.TextFormattingMode="Display" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding DownloadAndRestartCommand}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Download and restart to apply update"
                                Padding="10,6" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Restart" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="12.5" FontWeight="Normal" TextOptions.TextFormattingMode="Display" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar Width="60" Height="4" Margin="6,0,8,0" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100" Value="{Binding DownloadProgress}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DownloadProgress}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sync counters (hidden while sync is disabled in App Settings) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                    Visibility="{Binding IsSyncUiVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Sync" Width="14" Height="14" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,3,0" ToolTip="Pending Sync"/>
                            <TextBlock Text="{Binding SyncPendingCount}" VerticalAlignment="Center" Foreground="#FF9800" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                            <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,3,0" ToolTip="Synced"/>
                            <TextBlock Text="{Binding SyncSuccessCount}" VerticalAlignment="Center" Foreground="#4CAF50" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                            <materialDesign:PackIcon Kind="CloseCircle" Width="14" Height="14" Foreground="#F44336" VerticalAlignment="Center" Margin="0,0,3,0" ToolTip="Failed Sync"/>
                            <TextBlock Text="{Binding SyncFailedCount}" VerticalAlignment="Center" Foreground="#F44336" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                        </StackPanel>
                        <!-- Internet status -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="{Binding InternetStatusText}">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#d93025"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInternetAvailable}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11" FontWeight="Normal" TextOptions.TextFormattingMode="Display" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding InternetStatusText}"/>
                                        <Setter Property="Foreground" Value="#d93025"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInternetAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=750}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- User -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#e8edfb" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Foreground="{DynamicResource BrandPrimaryDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="8,0,14,0" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=900}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding CurrentUserDisplayName}" FontSize="13" FontWeight="Normal" TextOptions.TextFormattingMode="Display" Foreground="{DynamicResource BrandTextPrimaryBrush}" LineHeight="15"/>
                                <TextBlock Text="{Binding CurrentUserRole}" FontSize="11" Foreground="{DynamicResource BrandTextSecondaryBrush}" LineHeight="13"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Clock: hide on narrow (< 1100px) to save topbar space -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=1100}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CurrentDateTime}" FontSize="12.5" FontWeight="Normal" TextOptions.TextFormattingMode="Display" Foreground="{DynamicResource BrandTextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Width="1" Height="28" Background="{DynamicResource BrandBorderBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource BrandSurfaceAltBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Registry-driven module workspace top-nav. -->
                <Border Grid.Row="0" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,0,0,1"
                        Padding="12,8"
                        Visibility="{Binding IsModuleTopNavVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Responsive: wraps to 2 rows on small screens, vertical scroll if more -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="96">
                    <ItemsControl ItemsSource="{Binding ModuleTopItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Cursor="Hand" Margin="0,0,8,4" Padding="12,7">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Border>
                <ContentControl Grid.Row="2" Content="{Binding CurrentContent}" />
                <Border Grid.Row="0" Grid.RowSpan="3" x:Name="LoadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="10" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="Black" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <Viewbox Width="60" Height="60">
                                <Grid>
                                    <Ellipse Width="60" Height="60" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="4" Opacity="0.3"/>
                                    <Ellipse Width="60" Height="60" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="4" StrokeDashArray="40 20" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="LoadingText" Text="Loading..." FontSize="16" FontWeight="Normal" TextOptions.TextFormattingMode="Display" Foreground="#333" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Internet status + active module -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding InternetStatusText}">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#d93025"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInternetAvailable}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding InternetStatusText}" FontSize="11.5" FontWeight="Normal" TextOptions.TextFormattingMode="Display" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#d93025"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInternetAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border Width="1" Height="14" Background="#d9dde3" Margin="12,0,12,0" VerticalAlignment="Center"/>
                        
                       
                    </StackPanel>
                    <!-- Scale + scanner status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ScaleStatusText}">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#DC3545"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScaleConnected}" Value="True"><Setter Property="Fill" Value="#28A745"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <materialDesign:PackIcon Kind="ScaleBalance" Width="14" Height="14" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ScaleStatusText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#721C24"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScaleConnected}" Value="True"><Setter Property="Foreground" Value="#155724"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="{Binding ScannerStatusDetail}">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#DC3545"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScannerConnected}" Value="True"><Setter Property="Fill" Value="#28A745"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <materialDesign:PackIcon Kind="BarcodeScan" Width="14" Height="14" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ScannerStatusText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#721C24"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScannerConnected}" Value="True"><Setter Property="Foreground" Value="#155724"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='© {0:yyyy} Tamil Automation. All rights reserved.'}" FontSize="11.5" Foreground="#a7adb8" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=ShellRoot, Converter={StaticResource IsLessThanConverter}, ConverterParameter=950}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
