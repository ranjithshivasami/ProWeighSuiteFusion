<UserControl x:Class="ProWeighSuitePlatforms.Views.FusionLiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="BasicTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="KpiIconStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LiveBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#14B8A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="3" Background="Transparent"/>
                                <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LotOutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0E9F6E"/>
            <Setter Property="BorderBrush" Value="#C9E7DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF7F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PageBackgroundStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Margin="10,0,10,6" Style="{DynamicResource ResponsiveForm2Strip}">
                <StackPanel Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Operator" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="150" Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding OperatorNames}" SelectedItem="{Binding OperatorName}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Pills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Display}" Command="{Binding DataContext.SelectBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding BatchNo}" Margin="0,0,6,6" Padding="8,6" FontSize="12" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#374151"/>
                                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="14"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Foreground" Value="#03543F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding PillsNote}" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Padding="12,2" Margin="0,0,0,6" VerticalAlignment="Stretch"
                        Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBox x:Name="ManualEpcBox" Margin="0,8,0,0" Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding ManualEpcText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Scan EPC ID"
                                 ToolTip="Scan the tub EPC, then hit Weigh next tub (or Enter). Empty = auto-pick. Read-only while auto run is ON (scanner fills it)."
                                 IsEnabled="{Binding IsRunning}" IsReadOnly="{Binding IsEpcReadOnly}" KeyDown="ManualEpcBox_KeyDown"/>
                        <TextBlock Text="{Binding ManualEpcError}" FontSize="11" Foreground="#C81E1E" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ManualEpcError, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ManualEpcTubInfo}" FontSize="11" Foreground="#0E9F6E" Margin="0,2,0,0"
                                   Visibility="{Binding ManualEpcTubInfo, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LiveScaleText}" FontSize="60" FontWeight="Bold" Foreground="#1c2430" VerticalAlignment="Center"/>
                            <TextBlock Text="OVER LIMIT" FontSize="14" FontWeight="Bold" Foreground="#C81E1E" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding IsOverLimit, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Margin="10,0,10,6" Padding="10" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#E5E7EB"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BatchStatus}" Value="running">
                                <Setter Property="Background" Value="#10B981"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BatchStatus}" Value="paused">
                                <Setter Property="Background" Value="#D97706"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BatchStatus}" Value="completed">
                                <Setter Property="Background" Value="#6B7280"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding BannerText}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding BannerSub}" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <ItemsControl Grid.Row="2" Margin="10,0,10,6" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Padding="10,6" Margin="0,0,6,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Opacity" Value="0.55"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Background" Value="#DEF7EC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12" Foreground="#374151">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="Title"/>
                                        <Binding Path="Time"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,10,6">
                <Button Margin="0,0,8,4" Style="{StaticResource PrimaryButtonStyle}" Content="Weigh next tub" Command="{Binding WeighNextTubCommand}" ToolTip="Manual: scan EPC then press. Disabled (read-only) while auto run is ON."/>
                <Button Margin="0,0,8,4" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding AutoRunButtonText}" Command="{Binding ToggleAutoRunCommand}" ToolTip="Auto run: RFID scan + weight auto-captures; Weigh button is read-only while ON."/>
                <Button Margin="0,0,8,4" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding PauseResumeButtonText}" Command="{Binding PauseResumeBatchCommand}"/>
                <Button Margin="0,0,8,4" Style="{StaticResource SecondaryButtonStyle}" Content="Complete batch" Command="{Binding CompleteBatchCommand}"/>
                <Button Margin="0,0,8,4" Style="{StaticResource SecondaryButtonStyle}" Content="New batch" Command="{Binding NewBatchCommand}"/>
                <Button Margin="0,0,8,4" Style="{StaticResource SecondaryButtonStyle}" Content="Display mode" Command="{Binding DisplayModeCommand}"/>
                <TextBlock Text="Waiting for zero — remove the tub" FontSize="12" FontWeight="SemiBold" Foreground="#C81E1E" VerticalAlignment="Center" Margin="0,0,8,4"
                           Visibility="{Binding WaitingForZero, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </WrapPanel>

            <UniformGrid Grid.Row="4" Margin="10,0,10,6" Style="{DynamicResource ResponsiveKpi5Strip}">
                <Border Margin="0,0,6,6" Padding="10" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Weight" FontSize="12" Foreground="#8A93A3" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                            <Border Style="{StaticResource KpiIconStyle}" DockPanel.Dock="Left" Background="#10B981">
                                <TextBlock Text="◫" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding KpiWeight}" FontSize="20" FontWeight="Bold" Foreground="#1c2430" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding KpiWeightSub}" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="10" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Coconuts" FontSize="12" Foreground="#8A93A3" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                            <Border Style="{StaticResource KpiIconStyle}" DockPanel.Dock="Left" Background="#34D399">
                                <TextBlock Text="▦" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding KpiNuts}" FontSize="20" FontWeight="Bold" Foreground="#1c2430" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding KpiNutsSub}" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="10" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tubs weighed" FontSize="12" Foreground="#8A93A3" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                            <Border Style="{StaticResource KpiIconStyle}" DockPanel.Dock="Left" Background="#A3A847">
                                <TextBlock Text="◐" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding KpiTubs}" FontSize="20" FontWeight="Bold" Foreground="#1c2430" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding KpiTubsSub}" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="10" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Progress to batch target" FontSize="12" Foreground="#8A93A3" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                            <Border Style="{StaticResource KpiIconStyle}" DockPanel.Dock="Left" Background="#F05252">
                                <TextBlock Text="▲" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding KpiProgress}" FontSize="20" FontWeight="Bold" Foreground="#1c2430" TextWrapping="Wrap"/>
                                <ProgressBar Value="{Binding KpiProgressPct, Mode=OneWay}" Maximum="200" Minimum="0" Width="110" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource LiveBarStyle}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,6" Padding="10" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Turn around time" FontSize="12" Foreground="#8A93A3" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                            <Border Style="{StaticResource KpiIconStyle}" DockPanel.Dock="Left" Background="#38BDF8">
                                <TextBlock Text="◇" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding KpiTat}" FontSize="20" FontWeight="Bold" Foreground="#1c2430" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding KpiTatSub}" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Grid.Row="5" Text="{Binding LotsTitle}" FontWeight="SemiBold" FontSize="14" Foreground="#1c2430" Margin="10,0,10,8"/>

            <Border Grid.Row="6" Margin="10,0,10,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Lots}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E7EB"
                          BorderBrush="#E5E7EB" BorderThickness="0"
                          MinWidth="1190"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderStyle}"/>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                            <Setter Property="MinHeight" Value="46"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="FontSize" Value="12.5"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lot" Binding="{Binding Lot.LotNo}" Width="90" SortMemberPath="Lot.LotNo">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Lot.SupplierName}" Width="110" SortMemberPath="Lot.SupplierName">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="GRN · Bay" Binding="{Binding GrnBayText}" Width="150" SortMemberPath="GrnBayText">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tubs done / plan" Binding="{Binding DonePlanText}" Width="120" SortMemberPath="Lot.DoneTubs">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Coconuts" Binding="{Binding NutsText}" Width="90" SortMemberPath="Lot.DoneTubs">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Weight kg" Binding="{Binding KgText}" Width="90" SortMemberPath="Lot.DoneKg">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Progress" Width="150" IsReadOnly="True" SortMemberPath="ProgressPct">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding ProgressPct, Mode=OneWay}" Maximum="100" Minimum="0" Width="120" Style="{StaticResource LiveBarStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tubs assigned" Binding="{Binding AssignedCount}" Width="100" SortMemberPath="AssignedCount">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Status" Width="110" IsReadOnly="True" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DEF7EC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Background" Value="#FDF1CC"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Background" Value="#EDEFf1"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#03543F"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Foreground" Value="#C28200"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="230" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource LotOutlineButtonStyle}" Margin="0,0,6,4" Content="Pause"
                                                Command="{Binding DataContext.PauseLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource LotOutlineButtonStyle}" Margin="0,0,0,4" Content="Complete lot"
                                                Command="{Binding DataContext.CompleteLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="7" Text="Suppliers" FontWeight="SemiBold" FontSize="14" Foreground="#1c2430" Margin="10,0,10,8"/>

            <ItemsControl Grid.Row="8" Margin="10,0,10,6" ItemsSource="{Binding SupplierCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="380" Margin="0,0,8,8" Padding="10" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <Ellipse Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#f28c1e"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Colour}" Value="Blue"><Setter Property="Fill" Value="#2f7fe0"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Colour}" Value="Virtual"><Setter Property="Fill" Value="#8B5CF6"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Colour}" Value="Mixed"><Setter Property="Fill" Value="#10B981"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Supplier"/>
                                                <Binding Path="Lots"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                        </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#374151" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <ProgressBar Value="{Binding ProgressPct}" Maximum="100" Minimum="0" Style="{StaticResource LiveBarStyle}"/>
                                <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,6,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}Stock balance after deduction: {0:N0} nuts · {1} tubs assigned">
                                            <Binding Path="BalanceNuts"/>
                                            <Binding Path="AssignedCount"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="9" Text="Recent transactions · latest first" FontWeight="SemiBold" FontSize="14" Foreground="#1c2430" Margin="10,0,10,8"/>

            <Border Grid.Row="10" Margin="10,0,10,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding TxRows}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E7EB"
                          BorderBrush="#E5E7EB" BorderThickness="0"
                          MinWidth="1010"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                          MaxHeight="300"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderStyle}"/>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                            <Setter Property="MinHeight" Value="38"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="FontSize" Value="12.5"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tub" Binding="{Binding Tub}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Tub colour" Width="100" MinWidth="90" SortMemberPath="Colour">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#9E9E9E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Colour}" Value="Orange"><Setter Property="Fill" Value="#f28c1e"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Colour}" Value="Blue"><Setter Property="Fill" Value="#2f7fe0"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Colour}" Value="Virtual"><Setter Property="Fill" Value="#8B5CF6"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Colour}" Value="Mixed"><Setter Property="Fill" Value="#10B981"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Colour}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="RFID EPC" Binding="{Binding Epc}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tub cycles" Binding="{Binding Cycles}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="GRN" Binding="{Binding Grn}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Bay" Binding="{Binding Bay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Lot" Binding="{Binding Lot}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:N2}}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Uom" Binding="{Binding Uom}" Width="50" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nuts" Binding="{Binding Nuts}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="11" Margin="10,0,10,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding AddLotVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding AddLotHead}" FontWeight="SemiBold" FontSize="13" Foreground="#1c2430" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="380" Margin="0,0,8,4" Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding CandidateLots}" SelectedValue="{Binding SelectedCandidateGrn}" SelectedValuePath="GrnNo"
                                  materialDesign:HintAssist.Hint="Stock lot (earliest best-before first)">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2} · {3} days left · {4:N0} nuts available">
                                                <Binding Path="GrnNo"/>
                                                <Binding Path="SupplierName"/>
                                                <Binding Path="BayId"/>
                                                <Binding Path="DaysLeft"/>
                                                <Binding Path="BalanceNuts"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Width="180" Margin="0,0,8,4" Style="{StaticResource FormTextBoxStyle}" Text="{Binding NewLotTubs, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tubs to weigh in this lot"/>
                        <Button Margin="0,0,0,4" Style="{StaticResource PrimaryButtonStyle}" Content="Add lot" Command="{Binding AddLotCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding AddLotNote}" FontSize="12" Foreground="#C81E1E" TextWrapping="Wrap"
                               Visibility="{Binding AddLotNote, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="12" Text="{Binding StatusText}" Foreground="#5b6472" Margin="10,0,10,8" TextWrapping="Wrap"/>
        </Grid>
        </ScrollViewer>
    </Border>
</UserControl>

