<Window x:Class="ProWeighSuitePlatforms.Views.UserChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:ProWeighSuitePlatforms.Converters"
        Title="{Binding WindowTitle}"
        Height="460" Width="550" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title and Required Fields Info -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="Change Password" 
                       FontSize="22" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" 
                       FontSize="12" 
                       Foreground="Gray" 
                       VerticalAlignment="Center">
                <Run Text="*" Foreground="Red" FontSize="14"/>
                <Run Text=" indicates required fields"/>
            </TextBlock>
        </Grid>

        <!-- User Banner -->
        <Border Grid.Row="1"
                Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrandPrimaryBrush}" CornerRadius="16" Width="32" Height="32" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="Account" Width="20" Height="20"
                                             Foreground="Black"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Changing password for:" FontSize="11" Foreground="#555"/>
                    <TextBlock Text="{Binding Username}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <Grid Grid.Row="2" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- New Password -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <PasswordBox x:Name="NewPasswordBox"
                                 FontSize="16"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 materialDesign:HintAssist.Hint="New Password"
                                 materialDesign:HintAssist.Background="White"
                                 Padding="5"
                                 BorderBrush="#d9dee7"
                                 PasswordChanged="NewPasswordBox_PasswordChanged"/>
                </DockPanel>
                <TextBlock Text="Minimum 4 characters" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Confirm Password -->
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 FontSize="16"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 materialDesign:HintAssist.Hint="Confirm Password"
                                 materialDesign:HintAssist.Background="White"
                                 Padding="5"
                                 BorderBrush="#d9dee7"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                </DockPanel>
                <TextBlock Text="Must match new password" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Security Notice -->
        <Border Grid.Row="3" 
                Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="2" 
                Padding="15" Margin="0,0,0,10" CornerRadius="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <materialDesign:PackIcon Kind="InformationOutline" 
                                             Width="16" Height="16" 
                                             Foreground="#E65100" 
                                             VerticalAlignment="Center"
                                             Margin="0,0,5,0"/>
                    <TextBlock Text="Security Notice" 
                               FontWeight="Bold" 
                               FontSize="13" 
                               Foreground="#E65100" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12">
                    The password will be changed immediately upon saving. The user will need to use the new password on their next login. Make sure to inform them of the change.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Change Password" 
                    Click="Save_Click" 
                    Margin="6,0"
                    Background="{DynamicResource BrandPrimaryBrush}" 
                    BorderBrush="{DynamicResource BrandPrimaryBrush}" 
                    Foreground="#434242"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Cancel" 
                    Click="Cancel_Click" 
                    Margin="6,0"
                    Background="#555555" 
                    BorderBrush="#555555" 
                    Foreground="White"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
