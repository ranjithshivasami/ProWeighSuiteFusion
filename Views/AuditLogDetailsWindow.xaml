<Window x:Class="ProWeighSuitePlatforms.Views.AuditLogDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Audit Log Details"
        Height="700" Width="850"
        MinWidth="620" MinHeight="450" MaxWidth="1000" MaxHeight="740"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Audit Log Entry Details"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <Border Background="{Binding SeverityColor}"
                        CornerRadius="3"
                        Padding="10,5"
                        Margin="0,0,10,0">
                    <TextBlock Text="{Binding Severity}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                </Border>
                <Border Background="#2196F3"
                        CornerRadius="3"
                        Padding="10,5">
                    <TextBlock Text="{Binding Category}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Details ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Information -->
                <TextBlock Text="Basic Information"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,0,0,10"/>
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="15"
                        Margin="0,0,0,15"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Timestamp:" Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding TimestampFormatted}" Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Action:" Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Action}" Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Username:" Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Username}" Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,10"/>

                        <TextBlock Text="Machine Name:" Grid.Row="3" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding MachineName}" Grid.Row="3" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,10"/>

                        <TextBlock Text="IP Address:" Grid.Row="4" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                        <TextBlock Text="{Binding IpAddress, TargetNullValue='-'}" Grid.Row="4" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                    </Grid>
                </Border>

                <!-- Entity Information -->
                <TextBlock Text="Entity Information"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,10,0,10"/>
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="15"
                        Margin="0,0,0,15"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Entity Type:" Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding EntityType, TargetNullValue='-'}" Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,10"/>

                        <TextBlock Text="Entity ID:" Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                        <TextBlock Text="{Binding EntityId, TargetNullValue='-'}" Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                    </Grid>
                </Border>

                <!-- Details -->
                <TextBlock Text="Details"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,10,0,10"/>
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        Padding="15"
                        Margin="0,0,0,15"
                        CornerRadius="4">
                    <TextBox Text="{Binding Details, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             MinHeight="60"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Old Value -->
                <TextBlock Text="Old Value"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,10,0,10"
                           Visibility="{Binding OldValue, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                <Border Background="#FFEBEE"
                        BorderBrush="#D32F2F"
                        BorderThickness="1"
                        Padding="15"
                        Margin="0,0,0,15"
                        CornerRadius="4"
                        Visibility="{Binding OldValue, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBox Text="{Binding OldValue, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             Foreground="#D32F2F"
                             MinHeight="60"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- New Value -->
                <TextBlock Text="New Value"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,10,0,10"
                           Visibility="{Binding NewValue, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                <Border Background="#E8F5E9"
                        BorderBrush="#4CAF50"
                        BorderThickness="1"
                        Padding="15"
                        CornerRadius="4"
                        Visibility="{Binding NewValue, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBox Text="{Binding NewValue, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             Foreground="#4CAF50"
                             MinHeight="60"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Grid.Row="2"
                Content="Close"
                Click="CloseButton_Click"
                Style="{StaticResource MaterialDesignFlatButton}"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Width="100"/>
    </Grid>
</Window>
