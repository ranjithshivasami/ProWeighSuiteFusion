<Window x:Class="ProWeighSuitePlatforms.Views.FailedSyncViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Failed Transaction Sync Manager - View &amp; Retry"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Failed Transaction Sync Manager"
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                       Margin="0,0,0,5"/>
            <TextBlock Text="View and manage weighing transactions that failed to sync to the server"
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Filter Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Width="120">
                <Button.ToolTip>
                    <ToolTip Content="Reload failed transactions"/>
                </Button.ToolTip>
            </Button>
            
            <Button Content="Retry All"
                    Command="{Binding RetryAllCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Width="120"
                    Background="#4CAF50"
                    BorderBrush="#4CAF50">
                <Button.ToolTip>
                    <ToolTip Content="Retry all failed transactions (re-enqueue for sync)"/>
                </Button.ToolTip>
            </Button>
            
            <Button Content="Clear All"
                    Command="{Binding ClearAllCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Width="120"
                    Background="#D32F2F"
                    BorderBrush="#D32F2F">
                <Button.ToolTip>
                    <ToolTip Content="Delete all failed transactions from dead letter queue"/>
                </Button.ToolTip>
            </Button>
        </StackPanel>

        <!-- Data Grid -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0">
            
            <Grid>
                <!-- Loading Overlay -->
                <Grid Background="#80FFFFFF" 
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                      Panel.ZIndex="999">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True"
                                     Width="50" Height="50"
                                     Margin="0,0,0,10"/>
                        <TextBlock Text="Loading..." 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding FailedItems}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    
                    <DataGrid.Columns>
                        <!-- Transaction ID -->
                        <DataGridTextColumn Header="Trans ID" 
                                            Binding="{Binding TransactionId}"
                                            Width="80"/>

                        <!-- Timestamp -->
                        <DataGridTextColumn Header="Failed At" 
                                            Binding="{Binding TimestampFormatted}"
                                            Width="150"/>

                        <!-- Batch Number -->
                        <DataGridTextColumn Header="Batch Number" 
                                            Binding="{Binding BatchNumber}"
                                            Width="130"/>

                        <!-- Material Code -->
                        <DataGridTextColumn Header="Material Code" 
                                            Binding="{Binding MaterialCode}"
                                            Width="120"/>

                        <!-- Material Name -->
                        <DataGridTextColumn Header="Material Name" 
                                            Binding="{Binding MaterialName}"
                                            Width="150"/>

                        <!-- Weight -->
                        <DataGridTextColumn Header="Actual Weight (kg)" 
                                            Binding="{Binding ActualWeight}"
                                            Width="130"/>

                        <!-- Weighed By -->
                        <DataGridTextColumn Header="Weighed By" 
                                            Binding="{Binding WeighedBy}"
                                            Width="110"/>

                        <!-- Attempt Count -->
                        <DataGridTextColumn Header="Attempts" 
                                            Binding="{Binding AttemptCount}"
                                            Width="95"/>

                        <!-- API URL -->
                        <DataGridTemplateColumn Header="API Endpoint" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ApiUrl}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ApiUrl}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Error Message -->
                        <DataGridTemplateColumn Header="Error / Note" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorNote}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ErrorNote}"
                                               Foreground="#D32F2F"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- Row Style with Double-Click -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Action Buttons and Status -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Message -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}">
                    <Run Text="Selected: "/>
                    <Run Text="{Binding SelectedItem.TransactionId, TargetNullValue='None'}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="View Details"
                        Command="{Binding ViewDetailsCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,10,0"
                        Width="120">
                    <Button.ToolTip>
                        <ToolTip Content="View full transaction details"/>
                    </Button.ToolTip>
                </Button>

                <Button Content="Delete Selected"
                        Command="{Binding DeleteSelectedCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Width="120"
                        Background="#D32F2F"
                        BorderBrush="#D32F2F">
                    <Button.ToolTip>
                        <ToolTip Content="Remove selected transaction from dead letter queue"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
