<UserControl x:Class="ProWeighSuitePlatforms.Views.SupplierMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors"
             xmlns:converters="clr-namespace:ProWeighSuitePlatforms.Converters">
    <UserControl.Resources>
        <Style x:Key="BasicTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="BasicTableHeaderCenterStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KpiIconStyle" TargetType="Border">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TablePagerButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="Background" Value="#E8EEFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PageBackgroundStyle}" Padding="8,12" behaviors:AutoFocusBehavior.IsEnabled="True">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Margin="4,0,4,8">
                <!-- 15" and below: 3 columns. 16"+ (content >= 1280px): 4 columns. Columns via Style setters only. -->
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Columns" Value="4"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                <Setter Property="Columns" Value="3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=650}" Value="True">
                                <Setter Property="Columns" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=450}" Value="True">
                                <Setter Property="Columns" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#10B981">
                            <TextBlock Text="◫" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiSuppliers}" FontSize="22" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="26"/>
                            <TextBlock Text="Suppliers" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#34D399">
                            <TextBlock Text="▦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiGrns}" FontSize="22" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="26"/>
                            <TextBlock Text="GRNs" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#A3A847">
                            <TextBlock Text="◉" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiWbWeight}" FontSize="20" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="WB weight" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#F05252">
                            <TextBlock Text="▼" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiDeductions}" FontSize="20" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="Deductions" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,0,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#38BDF8">
                            <TextBlock Text="◆" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiAvailable}" FontSize="20" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="Available for production" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1" Margin="4,0,4,8" Visibility="{Binding IsFormExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Padding="16,12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="14" Foreground="#111827" Margin="0,0,0,4"/>
                    <UniformGrid>
                        <!-- 16"+ (content >= 1280px): 4 columns (fields + button in one row). Below: 2, stacked below 650px. Columns via Style setters only. -->
                        <UniformGrid.Style>
                            <Style TargetType="UniformGrid">
                                <Setter Property="Columns" Value="4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                        <Setter Property="Columns" Value="2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=650}" Value="True">
                                        <Setter Property="Columns" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </UniformGrid.Style>
                    <StackPanel Margin="6,8,6,8">
                        <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                                 materialDesign:HintAssist.FloatingScale="0.9">
                            <materialDesign:HintAssist.Hint>
                                <TextBlock FontSize="14">
                                    <Run Text="*" Foreground="Red"/>
                                    <Run Text=" Supplier name"/>
                                </TextBlock>
                            </materialDesign:HintAssist.Hint>
                        </TextBox>
                        <TextBlock Text="{Binding NewNameError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding NewNameError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Margin="6,8,6,8">
                        <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding NewLocation, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                                 materialDesign:HintAssist.FloatingScale="0.9">
                            <materialDesign:HintAssist.Hint>
                                <TextBlock FontSize="14">
                                    <Run Text="*" Foreground="Red"/>
                                    <Run Text=" Location"/>
                                </TextBlock>
                            </materialDesign:HintAssist.Hint>
                        </TextBox>
                        <TextBlock Text="{Binding NewLocationError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding NewLocationError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Margin="6,8,6,8">
                        <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" InputScope="TelephoneNumber"
                                 materialDesign:HintAssist.FloatingScale="0.9">
                            <materialDesign:HintAssist.Hint>
                                <TextBlock FontSize="14">
                                    <Run Text=" WhatsApp no (optional)"/>
                                </TextBlock>
                            </materialDesign:HintAssist.Hint>
                        </TextBox>
                        <TextBlock Text="{Binding NewPhoneError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                 Visibility="{Binding NewPhoneError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Margin="6,8,6,8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding SubmitButtonText}" Command="{Binding AddSupplierCommand}"/>
                        <Button Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelEditCommand}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </UniformGrid>
                </StackPanel>
            </Border>
            </Grid>

            <Border Grid.Row="2" Margin="4,0,4,8" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,16,16,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <!-- Large screens only: no gap to the table header. Below 1280px keeps the current spacing. -->
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,0,12,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                            <Setter Property="Margin" Value="0,0,12,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Show" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                            <ComboBox Width="70" Margin="6,0" SelectedValue="{Binding PageSize}" SelectedValuePath="Content" Style="{StaticResource FormComboBoxStyle}" FontSize="12" Padding="4">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="100"/>
                            </ComboBox>
                            <TextBlock Text="entries" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,0,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Search:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchTextBox" MinWidth="140" MaxWidth="220" Style="{StaticResource FormTextBoxStyle}" FontSize="12" Padding="5,4"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search name, location, phone..."
                                     ToolTip="Search name, location, phone..."/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="SupplierGrid" MinWidth="700" MaxHeight="420" VerticalAlignment="Top" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding PagedSuppliers}"
                              SelectedItem="{Binding Selected}"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              BorderBrush="#E5E7EB" BorderThickness="0"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                               EnableRowVirtualization="True" EnableColumnVirtualization="True"
                               FrozenColumnCount="0"
                              Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderStyle}">
                                <Setter Property="Padding" Value="32,10"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                                <Setter Property="MinHeight" Value="32"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                                <Setter Property="Padding" Value="32,4"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="80" MinWidth="70" IsReadOnly="True" Binding="{Binding Id}" SortMemberPath="Id">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Supplier" Width="*" MinWidth="160" IsReadOnly="True" Binding="{Binding Name}" SortMemberPath="Name">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Location" Width="*" MinWidth="140" IsReadOnly="True" Binding="{Binding Location}" SortMemberPath="Location">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="WhatsApp no (optional)" Width="*" MinWidth="130" IsReadOnly="True" Binding="{Binding Phone}" SortMemberPath="Phone">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="110" MinWidth="100" CanUserSort="True" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DEF7EC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Inactive">
                                                            <Setter Property="Background" Value="#FCE8E8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#03543F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="Inactive">
                                                                <Setter Property="Foreground" Value="#C81E1E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="80" MinWidth="70" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderCenterStyle}"/>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowActionButtonStyle}" Content="⋯" Click="RowActionButton_Click"
                                                ToolTip="Actions">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Edit" FontSize="14" Padding="10,8"
                                                              Click="EditMenuItem_Click"/>
                                                    <MenuItem Header="Activate" FontSize="14" Padding="10,8"
                                                              Click="ActivateMenuItem_Click"/>
                                                    <MenuItem Header="Deactivate" FontSize="14" Padding="10,8"
                                                              Click="DeactivateMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ShowingText, Mode=OneWay}" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                            <Button Style="{StaticResource TablePagerButtonStyle}" Content="Previous" Command="{Binding PrevPageCommand}"/>
                            <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Number}" Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TablePagerButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource TablePagerButtonStyle}" Content="Next" Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4" Width="30" Height="30"
                    Command="{Binding ToggleFormCommand}" ToolTip="Show/hide the supplier form">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Content" Value="✕"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormExpanded}" Value="False">
                                <Setter Property="Content" Value="+"/>
                                <Setter Property="FontSize" Value="16"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
     </ScrollViewer>
    </Border>
</UserControl>

