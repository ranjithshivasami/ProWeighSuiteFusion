<UserControl x:Class="ProWeighSuitePlatforms.Views.CompanySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="10">
                    <StackPanel MaxWidth="1200">
                        <!-- Header Section -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Domain" Width="32" Height="32" 
                                                        Foreground="{DynamicResource BrandPrimaryBrush}" 
                                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Company Information" Style="{StaticResource PageTitleStyle}"/>
                                    <TextBlock Text="Configure company details and material code settings" 
                                               Style="{StaticResource SubtitleStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <TextBlock Grid.Column="1" 
                                       FontSize="12" 
                                       Foreground="Gray" 
                                       VerticalAlignment="Center">
                                <Run Text="*" Foreground="Red" FontSize="14"/>
                                <Run Text=" indicates required fields"/>
                            </TextBlock>
                        </Grid>

                        <!-- Form Fields in 2 Columns -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Column 1, Row 1: Company Name -->
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,20">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <StackPanel>                                        
                                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 materialDesign:HintAssist.Hint="Company name"
                                                 materialDesign:HintAssist.Background="White"
                                                 Background="White"
                                                 BorderBrush="#d9dee7"
                                                 FontSize="14"
                                                 Padding="8"
                                                 MaxLength="100"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Must be 2-100 characters" 
                                           FontSize="11" 
                                           Foreground="#888"
                                           Margin="30,3,0,0"/>
                                <TextBlock Text="{Binding CompanyNameError}" 
                                           FontSize="11" 
                                           Foreground="Red"
                                           Margin="30,3,0,0"
                                           Visibility="{Binding CompanyNameError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Column 2, Row 1: Material Code Prefix -->
                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,20">
                                <TextBox Text="{Binding MaterialCodePrefix, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Material code prefix (optional)"
                                         materialDesign:HintAssist.Background="White"
                                         Background="White"
                                         BorderBrush="#d9dee7"
                                         FontSize="14"
                                         Padding="8"
                                         MaxLength="10"/>
                                <TextBlock Text="2-10 characters (e.g., MAT-)" 
                                           FontSize="11" 
                                           Foreground="#888"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding MaterialCodePrefixError}" 
                                           FontSize="11" 
                                           Foreground="Red"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding MaterialCodePrefixError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Column 1, Row 2: GST Number -->
                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="20,0,0,20">
                                <TextBox Text="{Binding GSTNo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="GST number (optional)"
                                         materialDesign:HintAssist.Background="White"
                                         Background="White"
                                         BorderBrush="#d9dee7"
                                         FontSize="14"
                                         Padding="8"
                                         MaxLength="15"
                                         CharacterCasing="Upper"/>
                                <TextBlock Text="Exactly 15 characters (e.g., 22AAAAA0000A1Z5)" 
                                           FontSize="11" 
                                           Foreground="#888"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding GSTNoError}" 
                                           FontSize="11" 
                                           Foreground="Red"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding GSTNoError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Column 2, Row 2: Contact -->
                            <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,20">
                                <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Contact number (optional)"
                                         materialDesign:HintAssist.Background="White"
                                         Background="White"
                                         BorderBrush="#d9dee7"
                                         FontSize="14"
                                         Padding="8"
                                         MaxLength="50"/>
                                <TextBlock Text="10-50 characters (phone/email)" 
                                           FontSize="11" 
                                           Foreground="#888"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding ContactError}" 
                                           FontSize="11" 
                                           Foreground="Red"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding ContactError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Column 1-2, Row 3: Report Email (Full Width) -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="0,0,0,20">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBox Text="{Binding ReportEmail, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource FormTextBoxStyle}"
                                                  materialDesign:HintAssist.Hint="Report email (use comma for multiple)"
                                                  materialDesign:HintAssist.Background="White"
                                                  Background="White"
                                                  BorderBrush="#d9dee7"
                                                  FontSize="14"
                                                  Padding="8"
                                                  MaxLength="500"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Valid email address(es) - separate multiple with comma (e.g., user1@company.com, user2@company.com)" 
                                           FontSize="11" 
                                           Foreground="#888"
                                           Margin="30,3,0,0"/>
                                <TextBlock Text="{Binding ReportEmailError}" 
                                           FontSize="11" 
                                           Foreground="Red"
                                           Margin="30,3,0,0"
                                           Visibility="{Binding ReportEmailError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Column 1-2, Row 4: Address (Full Width) -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3" Margin="20,0,0,20">
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Address (optional)"
                                         materialDesign:HintAssist.Background="White"
                                         Background="White"
                                         BorderBrush="#d9dee7"
                                         FontSize="14"
                                         Padding="8"
                                         MaxLength="500"
                                         MinLines="3"
                                         MaxLines="5"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="10-500 characters" 
                                           FontSize="11" 
                                           Foreground="#888"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding AddressError}" 
                                           FontSize="11" 
                                           Foreground="Red"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding AddressError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Info Section -->
                        <Border Background="#FFF8E1" BorderBrush="#FFC107" BorderThickness="1" 
                                CornerRadius="4" Padding="12" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" 
                                                            Foreground="#F57C00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Important Information" FontWeight="SemiBold" 
                                              FontSize="13" Foreground="#E65100" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#5D4037">
                                    <Run Text="- Company settings can only be modified by administrators."/>
                                    <LineBreak/>
                                    <Run Text="- The material code prefix will be used across the application."/>
                                    <LineBreak/>
                                    <Run Text="- Changes will take effect immediately after saving."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}" 
                                  FontSize="12" 
                                  Foreground="#666" 
                                  Margin="0,0,0,12"
                                  TextWrapping="Wrap"
                                  Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Height="1"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Save Settings"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}"
                                    Padding="20,8"
                                    FontSize="14"
                                    FontWeight="Medium">
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
