<UserControl x:Class="ProWeighSuitePlatforms.Views.ScaleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardBorderStyle}" Padding="24" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title and Required Fields Info -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Weighing Scale Configuration" 
                                       Style="{StaticResource PageTitleStyle}"
                                       VerticalAlignment="Center"/>
                            
                            <TextBlock Grid.Column="1" 
                                       FontSize="12" 
                                       Foreground="Gray" 
                                       VerticalAlignment="Center">
                                <Run Text="*" Foreground="Red" FontSize="14"/>
                                <Run Text=" indicates required fields"/>
                            </TextBlock>
                        </Grid>

                        <!-- Form Fields -->
                        <Grid Grid.Row="1" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Scale Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,28">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <TextBox FontSize="16" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" Background="White" BorderBrush="#d9dee7" MaxLength="100" Text="{Binding ScaleName, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Scale Name" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                </DockPanel>
                                <TextBlock Text="Name for the weighing scale" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 0, Col 2: Location + Scale Code (side by side) -->
                            <Grid Grid.Row="0" Grid.Column="2" Margin="20,0,0,20">
                               

                                <!-- Location -->
                                <StackPanel Grid.Column="0">
                                    <TextBox FontSize="16" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" Background="White" BorderBrush="#d9dee7" MaxLength="100" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Location (Optional)" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                    <TextBlock Text="Physical location of the scale" 
                                               FontSize="11" 
                                               Foreground="Gray"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                               
                            </Grid>

                            <!-- Row 1: Connection Type (full width) -->
                            <!-- Scale Code -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <DockPanel LastChildFill="True" >
                                    <TextBlock DockPanel.Dock="Left"
                    Text="* "
                    Foreground="Red"
                    FontSize="20"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"/>
                                    <TextBox FontSize="16" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" Background="White" BorderBrush="#d9dee7" MaxLength="4" Text="{Binding ScaleCode, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ScaleCode_PreviewTextInput">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Scale No" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                </DockPanel>
                                <TextBlock Text="No. 1 – 9999"
                FontSize="11"
                Foreground="Gray"
                Margin="20,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,28">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <ComboBox FontSize="16" Style="{StaticResource FormComboBoxStyle}" Foreground="#212121" materialDesign:HintAssist.Background="White" Padding="5" Background="White" BorderBrush="#d9dee7" ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding ConnectionType}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Connection Type" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </ComboBox>
                                </DockPanel>
                                <TextBlock Text="Choose SerialPort or TCP connection" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 2: Port (Serial only) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,28"
                                        Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <ComboBox FontSize="16" Style="{StaticResource FormComboBoxStyle}" Foreground="#212121" materialDesign:HintAssist.Background="White" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" Padding="5">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="COM Port" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </ComboBox>
                                </DockPanel>
                                <TextBlock Text="Serial port for scale connection" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 2: Baud Rate (Serial only) -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,28"
                                        Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <ComboBox FontSize="16" Style="{StaticResource FormComboBoxStyle}" Foreground="#212121" materialDesign:HintAssist.Background="White" SelectedValue="{Binding BaudRate}" SelectedValuePath="Content" Padding="5">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Baud Rate" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        <ComboBoxItem Content="1200"/>
                                        <ComboBoxItem Content="2400"/>
                                        <ComboBoxItem Content="4800"/>
                                        <ComboBoxItem Content="9600"/>
                                        <ComboBoxItem Content="19200"/>
                                        <ComboBoxItem Content="38400"/>
                                        <ComboBoxItem Content="57600"/>
                                        <ComboBoxItem Content="115200"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Text="Communication speed" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 2: IP Address (TCP only) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,28"
                                        Visibility="{Binding IsTcp, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <TextBox FontSize="16" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" Background="White" BorderBrush="#d9dee7" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="IP Address" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                </DockPanel>
                                <TextBlock Text="IP address of the scale (e.g., 192.168.1.100)" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 2: TCP Port (TCP only) -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,28"
                                        Visibility="{Binding IsTcp, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <TextBox FontSize="16" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" Background="White" BorderBrush="#d9dee7" Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="TCP Port" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                </DockPanel>
                                <TextBlock Text="TCP port number (typically 5000)" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 3: Parity (Serial only) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,28"
                                        Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <ComboBox FontSize="16" Style="{StaticResource FormComboBoxStyle}" Foreground="#212121" materialDesign:HintAssist.Background="White" SelectedValue="{Binding Parity}" SelectedValuePath="Tag" Padding="5">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Parity" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        <ComboBoxItem Tag="{x:Static ports:Parity.None}" Content="None"/>
                                        <ComboBoxItem Tag="{x:Static ports:Parity.Odd}" Content="Odd"/>
                                        <ComboBoxItem Tag="{x:Static ports:Parity.Even}" Content="Even"/>
                                        <ComboBoxItem Tag="{x:Static ports:Parity.Mark}" Content="Mark"/>
                                        <ComboBoxItem Tag="{x:Static ports:Parity.Space}" Content="Space"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Text="Error checking method" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 3: Data Bits (Serial only) -->
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,28"
                                        Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <ComboBox FontSize="16" Style="{StaticResource FormComboBoxStyle}" Foreground="#212121" materialDesign:HintAssist.Background="White" SelectedValue="{Binding DataBits}" SelectedValuePath="Content" Padding="5">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Data Bits" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        <ComboBoxItem Content="7"/>
                                        <ComboBoxItem Content="8"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Text="Number of data bits" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 4: Stop Bits (Serial only) -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,28"
                                        Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <ComboBox FontSize="16" Style="{StaticResource FormComboBoxStyle}" Foreground="#212121" materialDesign:HintAssist.Background="White" SelectedValue="{Binding StopBits}" SelectedValuePath="Tag" Padding="5">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Stop Bits" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        <ComboBoxItem Tag="{x:Static ports:StopBits.One}" Content="One"/>
                                        <ComboBoxItem Tag="{x:Static ports:StopBits.Two}" Content="Two"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Text="Number of stop bits" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 4: Request Mode -->
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,28">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" 
                                               Text="* " 
                                               Foreground="Red" 
                                               FontSize="20" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <ComboBox FontSize="16" Style="{StaticResource FormComboBoxStyle}" Foreground="#212121" materialDesign:HintAssist.Background="White" SelectedValue="{Binding Mode}" SelectedValuePath="Content" Padding="5">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Request Mode" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        <ComboBoxItem Content="Continuous"/>
                                        <ComboBoxItem Content="SICS"/>
                                        <ComboBoxItem Content="ID510"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Text="Scale request mode" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="20,3,0,0"/>
                            </StackPanel>

                            <!-- Row 5: Zero Return -->
                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,28">
                                <TextBlock Text="Zero Return" 
                                           FontSize="16" 
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="True" 
                                                 FontSize="14"
                                                 Margin="0,0,20,0"
                                                 IsChecked="{Binding ZeroReturn}"
                                                 GroupName="ZeroReturn"/>
                                    <RadioButton Content="False" 
                                                 FontSize="14"
                                                 IsChecked="{Binding ZeroReturn, Converter={StaticResource InverseBooleanConverter}}"
                                                 GroupName="ZeroReturn"/>
                                </StackPanel>
                                <TextBlock Text="Enable or disable zero return on the scale" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Row 5: Zero Return Tolerance - (minus) -->
                            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,28"
                                        Visibility="{Binding ZeroReturn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tolerance - -->
                                    <StackPanel Grid.Column="0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" 
                                                       Text="* " 
                                                       Foreground="Red" 
                                                       FontSize="20" 
                                                       Margin="0,0,5,0" 
                                                       VerticalAlignment="Center"/>
                                            <TextBox FontSize="16" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" Background="White" BorderBrush="#d9dee7" MaxLength="2" Text="{Binding ZeroReturnToleranceMinus, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Tolerance - %" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                        </DockPanel>
                                        <TextBlock Text="Tolerance (1–99)" 
                                                   FontSize="11" 
                                                   Foreground="Gray"
                                                   Margin="20,3,0,0"/>
                                    </StackPanel>

                                    <!-- Tolerance + -->
                                    <StackPanel Grid.Column="2">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" 
                                                       Text="* " 
                                                       Foreground="Red" 
                                                       FontSize="20" 
                                                       Margin="0,0,5,0" 
                                                       VerticalAlignment="Center"/>
                                            <TextBox FontSize="16" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" Background="White" BorderBrush="#d9dee7" MaxLength="2" Text="{Binding ZeroReturnTolerancePlus, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Tolerance + %" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                        </DockPanel>
                                        <TextBlock Text="Tolerance (1–99)" 
                                                   FontSize="11" 
                                                   Foreground="Gray"
                                                   Margin="20,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Row 6: Weight Capture moved to App Settings (global) — removed from Scale Settings -->

                            <!-- Row 8: Test Data Preview (Full Width) -->
                            <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,28">
                                <TextBlock Text="Scale Data Preview" 
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,8"/>
                                <Border Padding="10" 
                                        Style="{StaticResource SettingsCardBorderStyle}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                                  Height="120">
                                        <TextBlock Text="{Binding ReceivedData}" 
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Text="Test connection to view received data from scale" 
                                           FontSize="11" 
                                           Foreground="Gray"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Row 7: Action Buttons -->
                            <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Right" 
                                        Margin="0,20,0,0">

                                <Button Command="{Binding TestConnectionCommand}" 
                                        Margin="6,0"
                                        Padding="15,8"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Test scale connection and view data">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Connection" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Command="{Binding SaveScaleSettingsCommand}" 
                                        Margin="6,0"
                                        Padding="15,8"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        ToolTip="Save scale configuration">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
