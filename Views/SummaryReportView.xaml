<UserControl x:Class="ProWeighSuitePlatforms.Views.SummaryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            

            <!-- Filter Bar -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12, 30, 12, 20" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Date range filters, Filter-by and Group-By -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <ComboBox ItemsSource="{Binding DateTypeOptions}"
                                      SelectedItem="{Binding SelectedDateType, Mode=TwoWay}"
                                      Width="100"
                                      FontSize="13"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="Filter by"
                                      materialDesign:HintAssist.Background="White"
                                      Background="Transparent"
                                      BorderBrush="{StaticResource InputBorderBrush}"
                                      Padding="5"
                                      ToolTip="Choose which date field the From/To range applies to" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="From date"
                                        materialDesign:HintAssist.Background="Transparent"
                                        Width="110" Style="{StaticResource FormDatePickerStyle}"
                                        Padding="5"
                                        Background="White"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        FontSize="14" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="To date"
                                        materialDesign:HintAssist.Background="Transparent"
                                        Background="White"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        Width="110" Style="{StaticResource FormDatePickerStyle}"
                                        Padding="5"
                                        FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <ComboBox ItemsSource="{Binding GroupByOptions}"
                                      SelectedItem="{Binding SelectedGroupBy, Mode=TwoWay}"
                                      Width="130"
                                      FontSize="14"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="Group By"
                                      materialDesign:HintAssist.Background="White"
                                      Padding="5"
                                      Background="White"
                                      BorderBrush="{StaticResource InputBorderBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                      Width="100"
                                      FontSize="13"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="Status"
                                      materialDesign:HintAssist.Background="White"
                                      Background="Transparent"
                                      BorderBrush="{StaticResource InputBorderBrush}"
                                      Padding="5"
                                      ToolTip="Filter by result status (OK / OVER / UNDER)" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions menu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton x:Name="ActionsMenuButton"
                                      Width="28" Height="28"
                                      Margin="0,0,5,0"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      IsChecked="False"
                                      ToolTip="Report actions">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1A000000"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#33000000"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#26000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <materialDesign:PackIcon Kind="DotsVertical" Width="18" Height="18" Foreground="#424242"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ActionsMenuButton}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                               StaysOpen="False"
                               PopupAnimation="Fade"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#CCC"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MinWidth="140"
                                    Effect="{StaticResource MaterialDesignShadowDepth3}">
                                <StackPanel>
                                    <MenuItem Header="Filter"
                                              Command="{Binding FilterReportCommand}"
                                              Icon="{materialDesign:PackIcon Kind=FilterVariant}"
                                              Foreground="#424242"/>
                                    <Separator/>
                                    <MenuItem Header="Email"
                                              Command="{Binding EmailReportCommand}"
                                              Icon="{materialDesign:PackIcon Kind=Email}"
                                              Foreground="#424242"
                                              Visibility="{Binding CanExportReports, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <MenuItem Header="Export"
                                              Command="{Binding ExportToExcelCommand}"
                                              Icon="{materialDesign:PackIcon Kind=FileExcel}"
                                              Foreground="#424242"
                                              Visibility="{Binding CanExportReports, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Search box -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180"
                                 MinWidth="120"
                                 HorizontalAlignment="Left"
                                 FontSize="14"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 materialDesign:HintAssist.Hint="Search all columns"                                                          
                                 Padding="5"
                                 materialDesign:HintAssist.Background="White"
                                 Background="White"
                                 BorderBrush="{StaticResource InputBorderBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary DataGrid -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
                <DataGrid AutoGenerateColumns="False" 
                          Width="Auto"
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding SummaryItems}"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          FontSize="11"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          materialDesign:DataGridAssist.CellPadding="8 6 8 6"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 8 8 8"
                          Style="{StaticResource AppDataGridStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderCenterStyle}">
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sl.No" Binding="{Binding SlNo}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="Auto"
                                            Visibility="{Binding DataContext.ShowCategoryColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Variant" Binding="{Binding VariantName}" Width="Auto"
                                            Visibility="{Binding DataContext.ShowVariantColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Material Code" Binding="{Binding MaterialCode}" Width="Auto"
                                            Visibility="{Binding DataContext.ShowMaterialColumns, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Material Name" Binding="{Binding MaterialName}" Width="Auto"
                                            Visibility="{Binding DataContext.ShowMaterialColumns, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Achieved Weight" Binding="{Binding TotalWeight, StringFormat={}{0:0.000}}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="UOM" Binding="{Binding UOM}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Summary Totals Bar -->
            <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock Text="Total Transactions: " FontSize="13" FontWeight="SemiBold" Foreground="#333" />
                        <TextBlock Text="{Binding TotalTransactions}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Achieved Weight: " FontSize="13" FontWeight="SemiBold" Foreground="#333" />
                        <TextBlock Text="{Binding TotalWeight, StringFormat={}{0:0.000}}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
