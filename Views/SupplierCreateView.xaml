<UserControl x:Class="ProWeighSuitePlatforms.Views.SupplierCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors"
             mc:Ignorable="d">
    <Grid Margin="10" behaviors:AutoFocusBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Required fields note (title now shown in top bar dynamically) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="Gray" VerticalAlignment="Center">
                <Run Text="*" Foreground="Red" FontSize="14"/>
                <Run Text=" indicates required fields"/>
            </TextBlock>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,5">

                <!-- Basic Information -->
                <TextBlock Text="Basic Information" FontSize="16" FontWeight="Bold" Margin="0,5,0,10"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Code + auto -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="* " Foreground="Red" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="30" Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}">
                                    <materialDesign:HintAssist.Hint><TextBlock Text="Supplier Code" FontSize="14"/></materialDesign:HintAssist.Hint>
                                </TextBox>
                                <Button Grid.Column="1" Content="Auto" Margin="6,0,0,0" Padding="10,0" Command="{Binding AutoGenerateCodeCommand}" ToolTip="Auto-generate next supplier code"/>
                            </Grid>
                        </DockPanel>
                        <TextBlock Text="Unique, auto-generated or manual" FontSize="11" Foreground="Gray" Margin="20,3,0,0"/>
                        <TextBlock Text="{Binding CodeError}" FontSize="11" Foreground="Red" Margin="20,2,0,0" Visibility="{Binding CodeError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="* " Foreground="Red" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="150" Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}">
                                <materialDesign:HintAssist.Hint><TextBlock Text="Supplier Name (Legal/business name)" FontSize="14"/></materialDesign:HintAssist.Hint>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Text="{Binding NameError}" FontSize="11" Foreground="Red" Margin="20,2,0,0" Visibility="{Binding NameError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Display Name -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="100" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="20,0,0,0">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Display Name (Short name for UI)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                    </StackPanel>

                    <!-- Supplier Type (Optional) -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <ComboBox FontSize="15" Style="{StaticResource FormComboBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7"
                                  ItemsSource="{Binding SupplierTypes}" SelectedItem="{Binding SupplierType, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Supplier Type (Optional)" IsEditable="False"/>
                        <TextBlock Text="Manufacturer, Distributor, Service Provider, Trader" FontSize="11" Foreground="Gray" Margin="5,3,0,0"/>
                        <TextBlock Text="{Binding TypeError}" FontSize="11" Foreground="Red" Margin="5,2,0,0" Visibility="{Binding TypeError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Business Category + Status -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                        <ComboBox FontSize="15" Style="{StaticResource FormComboBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7"
                                  ItemsSource="{Binding BusinessCategories}" SelectedItem="{Binding BusinessCategory, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Business Category (Optional)" IsEditable="True" Margin="20,0,0,0"/>
                        <TextBlock Text="Raw Material, IT, Logistics, etc." FontSize="11" Foreground="Gray" Margin="25,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Active" FontSize="15" IsChecked="{Binding Status}" VerticalAlignment="Center"/>
                        <TextBlock Text="Active / Inactive" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Business / Legal Details -->
                <TextBlock Text="Business / Legal Details" FontSize="16" FontWeight="Bold" Margin="0,10,0,10"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                        <ComboBox FontSize="15" Style="{StaticResource FormComboBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7"
                                  ItemsSource="{Binding LegalEntityTypes}" SelectedItem="{Binding LegalEntityType, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Legal Entity Type (Optional)" IsEditable="True" Margin="20,0,0,0"/>
                        <TextBlock Text="Pvt Ltd, LLP, Partnership, Proprietorship" FontSize="11" Foreground="Gray" Margin="25,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="50" Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Registration Number (CIN / Company Reg. No.)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="30" Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Tax ID / GSTIN / VAT (Optional)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                        <TextBlock Text="For tax compliance" FontSize="11" Foreground="Gray" Margin="5,3,0,0"/>
                        <TextBlock Text="{Binding TaxError}" FontSize="11" Foreground="Red" Margin="5,2,0,0" Visibility="{Binding TaxError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="200" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Website (https://...)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                        <TextBlock Text="{Binding WebsiteError}" FontSize="11" Foreground="Red" Margin="5,2,0,0" Visibility="{Binding WebsiteError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- Contact Information -->
                <TextBlock Text="Contact Information" FontSize="16" FontWeight="Bold" Margin="0,10,0,10"/>
                <Grid Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,10,0,10">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="100" Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Primary Contact Person (Optional)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                        <TextBlock Text="{Binding ContactError}" FontSize="11" Foreground="Red" Margin="5,2,0,0" Visibility="{Binding ContactError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,10,0,10">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="100" Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Designation (Job title)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,10">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="20" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Phone with country code (Optional)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                        <TextBlock Text="{Binding PhoneError}" FontSize="11" Foreground="Red" Margin="5,2,0,0" Visibility="{Binding PhoneError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,10">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="20" Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Mobile (Optional)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,10">
                        <TextBox FontSize="15" Style="{StaticResource FormTextBoxStyle}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="150" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:HintAssist.Hint><TextBlock Text="Email / Primary email (Optional)" FontSize="14"/></materialDesign:HintAssist.Hint>
                        </TextBox>
                        <TextBlock Text="{Binding EmailError}" FontSize="11" Foreground="Red" Margin="5,2,0,0" Visibility="{Binding EmailError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="6,0" Background="{DynamicResource BrandPrimaryBrush}" BorderBrush="{DynamicResource BrandPrimaryBrush}" Foreground="#000000">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Update" Command="{Binding UpdateCommand}" Margin="6,0" Background="{DynamicResource BrandPrimaryBrush}" BorderBrush="{DynamicResource BrandPrimaryBrush}" Foreground="#434242">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0" Background="#555555" BorderBrush="#555555" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
