<UserControl x:Class="ProWeighSuitePlatforms.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12, 30, 12, 20" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: date range filter -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
                        <!-- Column Selector Toggle Button with Popup -->
                        <ToggleButton x:Name="ColumnToggleButton"
                                      Width="28" Height="28"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Top"
                                      IsChecked="False"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      ToolTip="Columns">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1A000000"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#33000000"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#26000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <materialDesign:PackIcon Kind="ViewColumn" Width="16" Height="16" Foreground="#424242"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ColumnToggleButton}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ColumnToggleButton}"
                               StaysOpen="False"
                               PopupAnimation="Fade"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#CCC"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    MaxHeight="400"
                                    Effect="{StaticResource MaterialDesignShadowDepth3}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding SelectAllColumns}"
                                              Content="Select All"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="#555"
                                              Margin="0,0,0,6"/>
                                    <Separator Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding AvailableColumns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Content="{Binding DisplayName}"
                                                          FontSize="13"
                                                          Margin="2,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <StackPanel Orientation="Vertical"  Margin="0,0,6,0">
                            <ComboBox ItemsSource="{Binding DateTypeOptions}"
                                      SelectedItem="{Binding SelectedDateType, Mode=TwoWay}"
                                      Width="100"
                                      FontSize="13"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="Filter by"
                                      materialDesign:HintAssist.Background="White"
                                      Background="Transparent"
                                      BorderBrush="{StaticResource InputBorderBrush}"
                                      Padding="5"
                                      ToolTip="Choose which date field the From/To range applies to" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="From date"
                                        materialDesign:HintAssist.Background="Transparent"
                                        Width="120" Style="{StaticResource FormDatePickerStyle}"
                                        Padding="5"
                                        Background="White"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        FontSize="14" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="To date"
                                        materialDesign:HintAssist.Background="Transparent"
                                         Background="White"
                                         BorderBrush="{StaticResource InputBorderBrush}"
                                        Width="120"  Style="{StaticResource FormDatePickerStyle}"
                                        Padding="5"
                                        FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                      Width="75"
                                      FontSize="13"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="Status"
                                      materialDesign:HintAssist.Background="White"
                                      Background="Transparent"
                                      BorderBrush="{StaticResource InputBorderBrush}"
                                      Padding="5"
                                      ToolTip="Filter by result status (OK / OVER / UNDER)" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Column 2: actions menu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
                        <ToggleButton x:Name="ActionsMenuButton"
                                      Width="28" Height="28"
                                      Margin="0,0,5,0"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      IsChecked="False"
                                      ToolTip="Report actions">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1A000000"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#33000000"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#26000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <materialDesign:PackIcon Kind="DotsVertical" Width="18" Height="18" Foreground="#424242"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ActionsMenuButton}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                               StaysOpen="False"
                               PopupAnimation="Fade"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#CCC"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MinWidth="140"
                                    Effect="{StaticResource MaterialDesignShadowDepth3}">
                                <StackPanel>
                                    <MenuItem Header="Filter"
                                              Command="{Binding FilterReportCommand}"
                                              Icon="{materialDesign:PackIcon Kind=FilterVariant}"
                                              Foreground="#424242"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding EmailButtonText}"
                                              Command="{Binding EmailReportCommand}"
                                              Icon="{materialDesign:PackIcon Kind=Email}"
                                              Foreground="#424242"
                                              Visibility="{Binding CanExportReports, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <MenuItem Header="Export"
                                              Command="{Binding ExportToExcelCommand}"
                                              Icon="{materialDesign:PackIcon Kind=FileExcel}"
                                              Foreground="#424242"
                                              Visibility="{Binding CanExportReports, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Column 3: search bar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180"
                                 MinWidth="120"
                                 HorizontalAlignment="Left"
                                 FontSize="14"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 materialDesign:HintAssist.Hint="Search all columns"                                                          
                                 Padding="5"
                                 materialDesign:HintAssist.Background="White"
                                 Background="White"
                                 BorderBrush="{StaticResource InputBorderBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
                <DataGrid x:Name="ReportDataGrid"
                          AutoGenerateColumns="False" 
                          Width="Auto"
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Transactions}"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          FontSize="11"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          materialDesign:DataGridAssist.CellPadding="6 3 6 3"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 6 8 6"
                          Style="{StaticResource AppDataGridStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderCenterStyle}">
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sl.No" Binding="{Binding SlNo}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding WeighedDate, StringFormat={}{0:dd-MM-yyyy}}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Time" Binding="{Binding WeighedDate, StringFormat={}{0:HH:mm}}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Transaction UUID" Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TransactionIdUpperCase}" 
                                               Padding="6,3,6,3" 
                                               FontSize="11" 
                                               HorizontalAlignment="Center"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu Padding="0">
                                                <MenuItem Header="Copy" 
                                                          Command="{Binding PlacementTarget.Tag.CopyTransactionIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding}"
                                                          Padding="6,1,6,1"
                                                          Height="20"
                                                          MinHeight="20">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Batch No" Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BatchNumber}" 
                                               Padding="6,3,6,3" 
                                               FontSize="11" 
                                               HorizontalAlignment="Center"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu Padding="0">
                                                <MenuItem Header="Copy" 
                                                          Command="{Binding PlacementTarget.Tag.CopyBatchNumberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding}"
                                                          Padding="6,1,6,1"
                                                          Height="20"
                                                          MinHeight="20">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Material Code" Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MaterialCode}" 
                                               Padding="6,3,6,3" 
                                               FontSize="11" 
                                               HorizontalAlignment="Center"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu Padding="0">
                                                <MenuItem Header="Copy" 
                                                          Command="{Binding PlacementTarget.Tag.CopyMaterialCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding}"
                                                          Padding="6,1,6,1"
                                                          Height="20"
                                                          MinHeight="20">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Material Name" Binding="{Binding MaterialName}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Target Weight" Binding="{Binding TargetWeight}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Preset Tare" Binding="{Binding TareWeight}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="UOM" Binding="{Binding Unit}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Status" Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="10" Height="10"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                             ToolTip="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Equipment ID" Binding="{Binding EquipmentId}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Weighed By" Binding="{Binding Login}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Manufacturing Date" Binding="{Binding ManufacturingDate}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pagination bar -->
            <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding PageInfo}"
                               FontSize="12" Foreground="#555"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding FirstPageCommand}"
                                Style="{StaticResource PaginationButtonStyle}"
                                Padding="6,4" Margin="2,0"
                                ToolTip="First page">
                            <materialDesign:PackIcon Kind="PageFirst" Width="18" Height="18" />
                        </Button>
                        <Button Command="{Binding PrevPageCommand}"
                                Style="{StaticResource PaginationButtonStyle}"
                                Padding="6,4" Margin="2,0"
                                ToolTip="Previous page">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" />
                        </Button>

                        <TextBlock Text="{Binding CurrentPage}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Text="/" FontSize="13" Foreground="#999"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalPages}" FontSize="13"
                                   VerticalAlignment="Center" Margin="8,0" />

                        <Button Command="{Binding NextPageCommand}"
                                Style="{StaticResource PaginationButtonStyle}"
                                Padding="6,4" Margin="2,0"
                                ToolTip="Next page">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
                        </Button>
                        <Button Command="{Binding LastPageCommand}"
                                Style="{StaticResource PaginationButtonStyle}"
                                Padding="6,4" Margin="2,0"
                                ToolTip="Last page">
                            <materialDesign:PackIcon Kind="PageLast" Width="18" Height="18" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Rows:" FontSize="11" Foreground="#888"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                  Width="65" FontSize="12" Padding="4,2"
                                  Style="{StaticResource MaterialDesignComboBox}">
                            <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Int32>
                            <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">50</sys:Int32>
                            <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">100</sys:Int32>
                            <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">200</sys:Int32>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
