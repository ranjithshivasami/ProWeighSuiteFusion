<UserControl x:Class="ProWeighSuitePlatforms.Views.FusionReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border Background="#e6e6e6" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12, 30, 12, 20" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: date range filter -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
                        <!-- Column Selector Toggle Button with Popup -->
                        <ToggleButton x:Name="ColumnToggleButton"
                                      Width="28" Height="28"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Top"
                                      IsChecked="False"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      ToolTip="Columns">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1A000000"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#33000000"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#26000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <materialDesign:PackIcon Kind="ViewColumn" Width="16" Height="16" Foreground="#424242"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ColumnToggleButton}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ColumnToggleButton}"
                               StaysOpen="False"
                               PopupAnimation="Fade"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#CCC"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    MaxHeight="400"
                                    Effect="{StaticResource MaterialDesignShadowDepth3}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding SelectAllColumns}"
                                              Content="Select All"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="#555"
                                              Margin="0,0,0,6"/>
                                    <Separator Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding AvailableColumns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Content="{Binding DisplayName}"
                                                          FontSize="13"
                                                          Margin="2,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <StackPanel Orientation="Vertical"  Margin="0,0,6,0">
                            <DatePicker SelectedDate="{Binding From, Mode=TwoWay}"
                                      materialDesign:HintAssist.Hint="From date"
                                      materialDesign:HintAssist.Background="Transparent"
                                      Width="120" Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                      Padding="5"
                                      Background="White"
                                      BorderBrush="#c5c8cc"
                                      FontSize="14" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <DatePicker SelectedDate="{Binding To, Mode=TwoWay}"
                                      materialDesign:HintAssist.Hint="To date"
                                      materialDesign:HintAssist.Background="Transparent"
                                       Background="White"
                                       BorderBrush="#c5c8cc"
                                      Width="120"  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                      Padding="5"
                                      FontSize="14"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Column 2: actions menu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
                        <ToggleButton x:Name="ActionsMenuButton"
                                      Width="28" Height="28"
                                      Margin="0,0,5,0"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      IsChecked="False"
                                      ToolTip="Report actions">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1A000000"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#33000000"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#26000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <materialDesign:PackIcon Kind="DotsVertical" Width="18" Height="18" Foreground="#424242"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ActionsMenuButton}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                               StaysOpen="False"
                               PopupAnimation="Fade"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#CCC"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MinWidth="140"
                                    Effect="{StaticResource MaterialDesignShadowDepth3}">
                                <StackPanel>
                                    <MenuItem Header="Refresh"
                                              Command="{Binding RefreshCommand}"
                                              Icon="{materialDesign:PackIcon Kind=Refresh}"
                                              Foreground="#424242"/>
                                    <Separator/>
                                    <MenuItem Header="Export CSV"
                                              Command="{Binding ExportCsvCommand}"
                                              Icon="{materialDesign:PackIcon Kind=FileExport}"
                                              Foreground="#424242"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Column 3: search bar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180"
                                 MinWidth="120"
                                 HorizontalAlignment="Left"
                                 FontSize="14"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Search all columns"                                                          
                                 Padding="5"
                                 materialDesign:HintAssist.Background="White"
                                 Background="White"
                                 BorderBrush="#c5c8cc" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10">
                <DataGrid x:Name="ReportDataGrid"
                          AutoGenerateColumns="False" 
                          Width="Auto"
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding ReportData}"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          BorderThickness="1"
                          BorderBrush="#CCCCCC"
                          AlternatingRowBackground="#F5F5F5"
                          RowBackground="White"
                          FontSize="11"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          materialDesign:DataGridAssist.CellPadding="6 3 6 3"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 6 8 6"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#555555" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="BorderBrush" Value="#CCCCCC" />
                            <Setter Property="Padding" Value="8" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <!-- S.No: dynamic 1-based row index, bound to the SNo column -->
                        <DataGridTextColumn Header="S.No" Binding="{Binding SNo}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Remaining columns are generated dynamically in code-behind from fusion_transactions schema -->
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pagination bar -->
            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                               FontSize="12" Foreground="#555"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="6,4" Margin="2,0"
                                ToolTip="Refresh">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Rows:" FontSize="11" Foreground="#888"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ReportData.Count}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
