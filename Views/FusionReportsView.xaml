<UserControl x:Class="ProWeighSuitePlatforms.Views.FusionReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Style="{StaticResource PageBackgroundStyle}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="1" Margin="10,0,10,10" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker Width="140" Margin="0,0,8,4" Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding From, Mode=TwoWay}" materialDesign:HintAssist.Hint="From"/>
                    <DatePicker Width="140" Margin="0,0,8,4" Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding To, Mode=TwoWay}" materialDesign:HintAssist.Hint="To"/>
                    <Button Margin="0,0,8,4" Style="{StaticResource PrimaryButtonStyle}" Content="Load" Command="{Binding RefreshCommand}"/>
                    <Button Margin="0,0,0,4" Style="{StaticResource SecondaryButtonStyle}" Content="Export CSV" Command="{Binding ExportCsvCommand}"/>
                </WrapPanel>
            </Border>
            <Border Grid.Row="2" Margin="10,0,10,10" Padding="8" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="120" ItemsSource="{Binding Rows}"
                          ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*"/>
                        <DataGridTextColumn Header="Tub" Binding="{Binding TubId}" Width="*"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="kg" Binding="{Binding WeightKg}" Width="*"/>
                        <DataGridTextColumn Header="At" Binding="{Binding RecordedAt}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="#5b6472" Margin="10,0,10,8"/>
        </Grid>
      </ScrollViewer>
    </Border>
</UserControl>

