<Window x:Class="ProWeighSuitePlatforms.Views.BatchLotDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding LotPopupTitle}"
        Width="1000" Height="700"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding LotPopupTitle}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Lot details for the selected batch"
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Lot list -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ItemsSource="{Binding Lots}"
                      ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}"
                      Style="{StaticResource AppDataGridStyle}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                        <Setter Property="MinHeight" Value="30"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="FontSize" Value="12.5"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lot" Binding="{Binding LotNo}" Width="110"/>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="GRN" Binding="{Binding GrnNo}" Width="130"/>
                    <DataGridTextColumn Header="Bay" Binding="{Binding BayId}" Width="90"/>
                    <DataGridTextColumn Header="Best before" Binding="{Binding BestBefore}" Width="130"/>
                    <DataGridTextColumn Header="Tubs" Binding="{Binding Tubs}" Width="80"/>
                    <DataGridTextColumn Header="Nuts" Binding="{Binding Nuts}" Width="80"/>
                    <DataGridTextColumn Header="Weight kg" Binding="{Binding WeightKg, StringFormat=N3}" Width="110"/>
                    <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="110"/>
                    <DataGridTextColumn Header="Done tubs" Binding="{Binding DoneTubs}" Width="95"/>
                    <DataGridTextColumn Header="Done kg" Binding="{Binding DoneKg, StringFormat=N3}" Width="105"/>
                    <DataGridCheckBoxColumn Header="Paused" Binding="{Binding IsPaused}" Width="85"/>
                    <DataGridCheckBoxColumn Header="Completed" Binding="{Binding IsCompleted}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Lots.Count, StringFormat='{}{0} lot(s)'}" FontSize="12" Foreground="#5b6472" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Width="80" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
