<UserControl x:Class="ProWeighSuitePlatforms.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors"
             xmlns:config="clr-namespace:ProWeighSuitePlatforms.Configuration"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#26334d"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
        <Style x:Key="CleanPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#26334d"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#29344d"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="InputIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Full-width white canvas (like BridgeX maximized window); content centered at 900 -->
    <Grid Background="{DynamicResource BrandSurfaceBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid Background="{DynamicResource BrandSurfaceBrush}" Width="900" VerticalAlignment="Center" HorizontalAlignment="Center"
          MouseLeftButtonDown="OnDragWindow"
          behaviors:AutoFocusBehavior.IsEnabled="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Grid Grid.Column="0" Margin="24,18,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Heading + slogan: [logo] Name / Suffix, slogan underneath -->
            <StackPanel Grid.Row="1" Margin="10,35,10,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource BrandLogoImage}" Height="92" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static config:BrandingInfo.Name}" FontSize="38" FontWeight="Bold"
                                   Foreground="{DynamicResource BrandPrimaryDarkBrush}" TextOptions.TextFormattingMode="Display"/>
                        <TextBlock Text="{x:Static config:BrandingInfo.Suffix}" FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,2,0,0"
                                   TextOptions.TextFormattingMode="Display"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{x:Static config:BrandingInfo.Tagline}" Foreground="{DynamicResource MutedTextBrush}" FontSize="15" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- Poster -->
            <Border Grid.Row="2" Margin="0,8,0,0" ClipToBounds="True">
                <Image Source="{DynamicResource BrandLoginBannerImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Feature cards -->
            <Border Grid.Row="3" Height="108" Margin="0,8,0,0" BorderBrush="#e0e6ee" BorderThickness="1" CornerRadius="14" Background="{DynamicResource BrandSurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="#142a4b" BlurRadius="16" ShadowDepth="5" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="34" Height="34" Margin="0,0,0,7">
                                <Grid Width="48" Height="48">
                                    <Ellipse Width="26" Height="26" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="10" Height="10" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path Data="M 24 4 V 12 M 24 36 V 44 M 4 24 H 12 M 36 24 H 44" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock TextAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource BrandTextPrimaryBrush}" TextOptions.TextFormattingMode="Display"><Run Text="Accurate"/><LineBreak/><Run Text="Weighing"/></TextBlock>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="1" BorderBrush="#dce2eb" BorderThickness="1,0,0,0"/>
                    <Grid Grid.Column="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="34" Height="34" Margin="0,0,0,7">
                                <Grid Width="48" Height="48">
                                    <Path Data="M 24 5 L 39 11 V 22 C 39 32 32.6 39 24 43 C 15.4 39 9 32 9 22 V 11 L 24 5 Z" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                    <Path Data="M 16 24 L 21 29 L 32 17" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock TextAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource BrandTextPrimaryBrush}" TextOptions.TextFormattingMode="Display"><Run Text="Secure &amp;"/><LineBreak/><Run Text="Reliable"/></TextBlock>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="2" BorderBrush="#dce2eb" BorderThickness="1,0,0,0"/>
                    <Grid Grid.Column="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="34" Height="34" Margin="0,0,0,7">
                                <Grid Width="48" Height="48">
                                    <Path Data="M 8 40 V 28 H 16 V 40 H 8 Z M 20 40 V 18 H 28 V 40 H 20 Z M 32 40 V 8 H 40 V 40 H 32 Z" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock TextAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource BrandTextPrimaryBrush}" TextOptions.TextFormattingMode="Display"><Run Text="Real-time"/><LineBreak/><Run Text="Analytics"/></TextBlock>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="3" BorderBrush="#dce2eb" BorderThickness="1,0,0,0"/>
                    <Grid Grid.Column="3">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="34" Height="34" Margin="0,0,0,7">
                                <Grid Width="48" Height="48">
                                    <Ellipse Width="14" Height="14" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="32" Height="32" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path Data="M 24 6 V 12 M 24 36 V 42 M 6 24 H 12 M 36 24 H 42 M 11.3 11.3 L 15.5 15.5 M 32.5 32.5 L 36.7 36.7 M 36.7 11.3 L 32.5 15.5 M 15.5 32.5 L 11.3 36.7" Stroke="{DynamicResource BrandPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock TextAlignment="Center" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource BrandTextPrimaryBrush}" TextOptions.TextFormattingMode="Display"><Run Text="Smart"/><LineBreak/><Run Text="Automation"/></TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,10,8,0">
                <materialDesign:PackIcon Kind="Diamond" Width="10" Height="10" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,7,0"/>
                <TextBlock Foreground="{DynamicResource BrandTextSecondaryBrush}" FontSize="11" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='© {0:yyyy} Tamil Automation. All rights reserved.'}"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT PANEL - LOGIN -->
        <Grid Grid.Column="1" Margin="0,18,8,14">
            <Border CornerRadius="19" BorderBrush="#e1e6ed" BorderThickness="1" Background="{DynamicResource BrandSurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="#142a4b" BlurRadius="18" ShadowDepth="5" Opacity="0.10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="29,20,29,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Image Source="/ProWeighSuitePlatforms.Core;component/Images/ta-logo.jpeg" Margin="0,0,0,0" HorizontalAlignment="Center" Stretch="Uniform" MaxHeight="55"/>
                        <TextBlock Grid.Row="1" Text="Sign In" FontSize="32" FontWeight="Bold" Foreground="#111d3a" TextAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Text="{x:Static config:BrandingInfo.AccountPrompt}" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" TextAlignment="Center" Margin="0,8,0,22"/>

                        <!-- Credentials step -->
                        <StackPanel Grid.Row="3">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOtpStep}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Height="44" CornerRadius="9" Background="{DynamicResource BrandSurfaceBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#d9dee7"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=UsernameTextBox}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="AccountOutline" Margin="18,0,0,0" Style="{StaticResource InputIconStyle}"/>
                                    <TextBox x:Name="UsernameTextBox" Grid.Column="1" Style="{StaticResource CleanTextBoxStyle}" Margin="14,0,12,0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnUsernameKeyDown"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Username is required" Foreground="#d32f2f" FontSize="12" Margin="4,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasTriedLogin}" Value="True"/>
                                                    <Condition Binding="{Binding Username}" Value=""/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Margin="0,15,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOtpStep}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Height="44" CornerRadius="9" Background="{DynamicResource BrandSurfaceBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#d9dee7"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=pwd}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="LockOutline" Margin="18,0,0,0" Style="{StaticResource InputIconStyle}"/>
                                    <PasswordBox x:Name="pwd" Grid.Column="1" Style="{StaticResource CleanPasswordBoxStyle}" Margin="14,0,12,0" PasswordChanged="OnPasswordChanged" KeyDown="OnPasswordKeyDown"/>
                                    <TextBox x:Name="pwdText" Grid.Column="1" Style="{StaticResource CleanTextBoxStyle}" Margin="14,0,12,0" Visibility="Collapsed" TextChanged="OnPasswordTextChanged"/>
                                    <Button Grid.Column="2" Click="OnTogglePassword" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Show / hide password">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"><ContentPresenter/></Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon x:Name="eyeIcon" Kind="Eye" Width="21" Height="21" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- OTP step (ProWeighSuitePlatforms SuperAdmin flow, styled to match) -->
                        <StackPanel Grid.Row="4" Margin="0,15,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOtpStep}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding OtpMessage}" TextWrapping="Wrap" FontSize="12" Foreground="#333333" Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" Margin="0,0,0,4" Foreground="#444444">
                                <Run Text="Time remaining: "/>
                                <Run Text="{Binding TimeRemaining, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Text="One-Time Password" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Height="44" CornerRadius="9" Background="{DynamicResource BrandSurfaceBrush}" BorderBrush="#d9dee7" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ShieldKeyOutline" Margin="18,0,0,0" Style="{StaticResource InputIconStyle}"/>
                                    <TextBox x:Name="OtpTextBox" Grid.Column="1" Style="{StaticResource CleanTextBoxStyle}" Margin="14,0,12,0"
                                             Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"
                                             IsEnabled="{Binding OtpExpired, Converter={StaticResource InverseBoolConverter}}"
                                             KeyDown="OnOtpKeyDown"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button Content="Verify OTP" Click="OnOtpVerifyClick" IsEnabled="{Binding CanVerify}"
                                        Height="40" Padding="16,0" Cursor="Hand"
                                        Foreground="{DynamicResource BrandOnPrimaryBrush}"
                                        Background="{DynamicResource BrandPrimaryBrush}"
                                        BorderBrush="{DynamicResource BrandPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <Button Content="Resend" Command="{Binding ResendOtpCommand}"
                                        Height="40" Padding="14,0" Margin="10,0,0,0" Cursor="Hand"
                                        Background="#555555" Foreground="White" BorderBrush="#555555" FontSize="13"/>
                                <Button Content="Back" Command="{Binding CancelOtpCommand}"
                                        Height="40" Padding="14,0" Margin="10,0,0,0" Cursor="Hand"
                                        Background="Transparent" Foreground="#666666" BorderBrush="#666666" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="5" Margin="0,15,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Button Grid.Row="6" Height="46" Command="{Binding LoginCommand}" Click="OnLoginClick" Cursor="Hand" Content="Sign In">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="17"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}">
                                                    <Grid>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="→" FontSize="24" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.75"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOtpStep}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Grid Grid.Row="7" MinHeight="30">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#d32f2f" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" TextWrapping="Wrap" TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="1" Height="58" BorderBrush="#e6e9ef" BorderThickness="0,1,0,0" Background="#fdfefe" CornerRadius="0,0,19,19">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#687384"/>
                                <TextBlock Foreground="{DynamicResource BrandTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0"><Run Text="Version "/><Run Text="{StaticResource AppVersion}"/></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusEllipse" Width="12" Height="12" Fill="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="System Status:" Foreground="{DynamicResource BrandTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock x:Name="StatusText" Text="Checking..." Foreground="#0aa84a" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Signing-in overlay -->
                    <Grid Grid.RowSpan="2" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.15" To="1.0" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0"/>
                                        <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.15" To="1.0" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.15" To="1.0" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Border Background="#CCE6E6E6" CornerRadius="19"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="Dot1" Width="12" Height="12" Fill="{DynamicResource BrandPrimaryBrush}" Margin="0,0,8,0"/>
                                <Ellipse x:Name="Dot2" Width="12" Height="12" Fill="{DynamicResource BrandPrimaryBrush}" Margin="0,0,8,0"/>
                                <Ellipse x:Name="Dot3" Width="12" Height="12" Fill="{DynamicResource BrandPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Signing in..." FontSize="14" Foreground="#555555" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
