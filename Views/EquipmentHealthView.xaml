<UserControl x:Class="ProWeighSuitePlatforms.Views.EquipmentHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Style="{StaticResource PageBackgroundStyle}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>            
            <Border Grid.Row="1" Margin="10,0,10,10" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="120" Margin="0,0,8,4" Style="{StaticResource FormTextBoxStyle}" Text="{Binding EquipId, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Equipment ID"/>
                    <TextBox Width="180" Margin="0,0,8,4" Style="{StaticResource FormTextBoxStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Name"/>
                    <TextBox Width="110" Margin="0,0,8,4" Style="{StaticResource FormTextBoxStyle}" Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Status"/>
                    <Button Margin="0,0,8,4" Style="{StaticResource PrimaryButtonStyle}" Content="Save" Command="{Binding SaveCommand}"/>
                    <Button Margin="0,0,8,4" Style="{StaticResource SecondaryButtonStyle}" Content="Delete" Command="{Binding DeleteCommand}"/>
                    <Button Margin="0,0,0,4" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Command="{Binding RefreshCommand}"/>
                </WrapPanel>
            </Border>
            <Border Grid.Row="2" Margin="10,0,10,10" Padding="8" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="120" ItemsSource="{Binding Rows}"
                          ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="#5b6472" Margin="10,0,10,8"/>
        </Grid>
      </ScrollViewer>
    </Border>
</UserControl>

