<UserControl x:Class="ProWeighSuitePlatforms.Views.UserCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:ProWeighSuitePlatforms.Models"
             xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10" behaviors:AutoFocusBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Required fields note (title now shown in top bar dynamically) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock HorizontalAlignment="Right"
                       Style="{StaticResource SubtitleStyle}"
                       VerticalAlignment="Center">
                <Run Text="*" Foreground="{DynamicResource BrandPrimaryBrush}" FontSize="14"/>
                <Run Text=" indicates required fields"/>
            </TextBlock>
        </Grid>

        <!-- Form Fields -->
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Username -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Style="{StaticResource RequiredMarkStyle}"
                               VerticalAlignment="Center"/>
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Username"
                             MaxLength="50"
                             IsReadOnly="{Binding IsEditMode}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Margin="30,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FormCaptionStyle}">
                            <Setter Property="Text" Value="Must be unique"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Text" Value="Username cannot be changed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Row 0: Role -->
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Style="{StaticResource RequiredMarkStyle}"
                               VerticalAlignment="Center"/>
                    <ComboBox Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="User Role"
                              ItemsSource="{Binding AvailableRoles}"
                              SelectedItem="{Binding SelectedRole}"
                              IsEnabled="{Binding CanChangeRole}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="SuperAdmin">
                                                        <Setter Property="Fill" Value="#FF5252"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Admin">
                                                        <Setter Property="Fill" Value="#2196F3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Operator">
                                                        <Setter Property="Fill" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Converter={StaticResource RoleToStringConverter}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <TextBlock Margin="30,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FormCaptionStyle}">
                            <Setter Property="Text" Value="Select appropriate role for this user"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanChangeRole}" Value="False">
                                    <Setter Property="Text" Value="You do not have permission to change roles"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Row 1: Email -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Style="{StaticResource RequiredMarkStyle}"
                               VerticalAlignment="Center"/>
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Email"
                             MaxLength="100"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource FormCaptionStyle}" Margin="30,3,0,0"
                           Text="Must be unique. Used for Super Admin OTP login."/>
            </StackPanel>

            <!-- Row 2: Password (Only for Create) -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Style="{StaticResource RequiredMarkStyle}"
                               VerticalAlignment="Center"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 materialDesign:HintAssist.Hint="Password"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                </DockPanel>
                <TextBlock Text="Minimum 4 characters" 
                           Style="{StaticResource FormCaptionStyle}"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Row 2: Confirm Password (Only for Create) -->
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Style="{StaticResource RequiredMarkStyle}"
                               VerticalAlignment="Center"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 materialDesign:HintAssist.Hint="Confirm Password"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                </DockPanel>
                <TextBlock Text="Must match password" 
                           Style="{StaticResource FormCaptionStyle}"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Row 3: Password Change Note (Only for Edit) - Spans both columns -->
            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" 
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    Padding="15" Margin="0,0,0,20" CornerRadius="8"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                 Width="16" 
                                                 Height="16" 
                                                 Foreground="{DynamicResource BrandPrimaryBrush}" 
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,5,0"/>
                        <TextBlock Text="Password Change" 
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SubtitleStyle}" FontSize="12">
                        To change the password for this user, use the "Password" button in the user list.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Row 4: Role Information - Spans both columns -->
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    Padding="15" CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                 Width="16" 
                                                 Height="16" 
                                                 Foreground="{DynamicResource BrandPrimaryBrush}" 
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,5,0"/>
                        <TextBlock Text="Role Descriptions" 
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Ellipse Width="8" Height="8" Fill="#FF5252" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontWeight="Bold" Foreground="#FF5252" Margin="0,0,5,0">Super Admin:</TextBlock>
                        <TextBlock Style="{StaticResource FormCaptionStyle}" FontSize="12">Full system access</TextBlock>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Ellipse Width="8" Height="8" Fill="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontWeight="Bold" Foreground="#2196F3" Margin="0,0,5,0">Admin:</TextBlock>
                        <TextBlock Style="{StaticResource FormCaptionStyle}" FontSize="12">Create/Edit only (no delete)</TextBlock>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,5,0">Operator:</TextBlock>
                        <TextBlock Style="{StaticResource FormCaptionStyle}" FontSize="12">Weighing operations only</TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding SubmitButtonText}" 
                    Command="{Binding SubmitCommand}" 
                    Margin="6,0"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    Margin="6,0"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
