<UserControl x:Class="ProWeighSuitePlatforms.Views.AppSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100">
    <Border Style="{StaticResource PageBackgroundStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="5">
                <Grid Margin="10" Width="Auto" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Tune" Width="32" Height="32" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Application Settings" Style="{StaticResource PageTitleStyle}"/>
                                    <TextBlock Text="Configure weighing unit, recording rules and printer triggers" Style="{StaticResource SubtitleStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock FontSize="12" Foreground="#999" Margin="0,8,0,0">
                            <Run Text="All fields are required."/><Run Text=" *" Foreground="#F44336" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Target UOM -->
                    <Border Grid.Row="1" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Target UOM" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="count" FontSize="14" Margin="0,0,20,0"
                                             IsChecked="{Binding TargetUomIsCount}" GroupName="TargetUom"/>
                                <RadioButton Content="kg" FontSize="14"
                                             IsChecked="{Binding TargetUomIsKg}" GroupName="TargetUom"/>
                            </StackPanel>
                            <TextBlock Text="Unit of measure for target weight (count or kg)" FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Weights to be Recorded -->
                    <Border Grid.Row="2" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Weights to be Recorded" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <CheckBox Content="Accept (within acceptable range)" FontSize="14" Margin="0,4,0,4"
                                       IsChecked="{Binding RecordAtAccept}"/>
                            <CheckBox Content="Under Weight (below minimum)" FontSize="14" Margin="0,4,0,4"
                                       IsChecked="{Binding RecordAtUnderWeight}"/>
                            <CheckBox Content="Over Weight (above maximum)" FontSize="14" Margin="0,4,0,4"
                                       IsChecked="{Binding RecordAtOverWeight}"/>
                            <TextBlock Text="Only the selected weight results can be recorded as transactions. Select at least one." FontSize="11" Foreground="Gray" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Product Presence Threshold -->
                    <Border Grid.Row="3" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Product Presence Threshold" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <TextBlock FontSize="13" Foreground="#333" Margin="0,0,0,4">
                                <Run Text=" *" Foreground="#F44336" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBox Width="220" HorizontalAlignment="Left" FontSize="14" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="7" VerticalContentAlignment="Center" PreviewTextInput="NumericOnly_PreviewTextInput" Text="{Binding PresenceThresholdText, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Presence Threshold (kg)" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                            <TextBlock Text="{Binding PresenceThresholdError}"
                                       FontSize="11"
                                       Foreground="#F44336"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasPresenceThresholdError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="Minimum weight (in kg) at which a product is considered present. Readings below this value are reported as &quot;NO PRODUCT&quot; and skip the under/over weight checks. Example: 0.050 kg = 50 g." FontSize="11" Foreground="Gray" Margin="0,15,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Scale Limits -->
                    <Border Grid.Row="4" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Scale Limits" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                            <!-- Scale Resolution -->
                            <TextBlock FontSize="13" Foreground="#333" Margin="0,6,0,4"><Run Foreground="#FFF44336" Text=" *"/></TextBlock>
                            <TextBox Width="220" HorizontalAlignment="Left" FontSize="14" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="10" VerticalContentAlignment="Center" ToolTip="Minimum Weight, which is the smallest measurable value of the weighing machine and the software application." PreviewTextInput="NumericOnly_PreviewTextInput" Text="{Binding ScaleResolutionText, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Scale Resolution (kg)" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                            <TextBlock Text="{Binding ScaleResolutionError}"
                                       FontSize="11"
                                       Foreground="#F44336"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasScaleResolutionError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="Minimum Weight, which is the smallest measurable value of the weighing machine and the software application."
                                       FontSize="11" Foreground="Gray" Margin="0,15,0,0" TextWrapping="Wrap"/>

                            <!-- Maximum Weight -->
                            <TextBlock FontSize="13" Foreground="#333" Margin="0,14,0,4">
                                <Run Text=" *" Foreground="#F44336" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBox Width="220" HorizontalAlignment="Left" FontSize="14" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="10" VerticalContentAlignment="Center" ToolTip="The maximum capacity of the weighing scale. Any weight above this value should be considered an error or overflow." PreviewTextInput="NumericOnly_PreviewTextInput" Text="{Binding MaxWeightText, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Maximum Weight (kg)" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                            <TextBlock Text="{Binding MaxWeightError}"
                                       FontSize="11"
                                       Foreground="#F44336"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasMaxWeightError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="The maximum capacity of the weighing scale. Any weight above this value should be considered an error or overflow."
                                       FontSize="11" Foreground="Gray" Margin="0,15,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Security -->
                    <Border Grid.Row="5" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Security" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <CheckBox Content="Enable OTP for Super Admin login" FontSize="14" Margin="0,4,0,4"
                                       IsChecked="{Binding EnableOTP}"/>
                            <TextBlock Text="When enabled, Super Admins sign in with a one-time password sent to their email (valid for 5 minutes) instead of their regular password. All other roles use their standard credentials." FontSize="11" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Weight Capture (moved from Scale Settings → App Settings, global) -->
                    <Border Grid.Row="6" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Weight Capture" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Manual" FontSize="14" Margin="0,0,20,0"
                                             IsChecked="{Binding IsCaptureManual}"
                                             GroupName="AppCaptureMode"/>
                                <RadioButton Content="Auto" FontSize="14" Margin="0,0,20,0"
                                             IsChecked="{Binding IsCaptureAuto}"
                                             GroupName="AppCaptureMode"/>
                                <RadioButton Content="Hybrid" FontSize="14"
                                             IsChecked="{Binding IsCaptureHybrid}"
                                             GroupName="AppCaptureMode"/>
                            </StackPanel>
                            <TextBlock Text="Manual = operator presses Accept. Auto = weight is captured automatically after the interval. Hybrid = Checkweigher  OR Integrated PLC workflow." FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsCaptureAuto, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="* " Foreground="Red" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox Width="220" HorizontalAlignment="Left" FontSize="14" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="5" Margin="0, 0, 0, 15" Text="{Binding CaptureIntervalText, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Interval (ms)" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                </DockPanel>
                                <TextBlock Text="{Binding CaptureIntervalError}" Foreground="#F44336" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasCaptureIntervalError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="Min: 100, Max: 60000 ms — used by Batch Weighing auto-capture." FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Product Scan — shown only when Hybrid (Checkweigher or Integrate PLC) -->
                            <Border Margin="0,14,0,0" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="4" Padding="12"
                                    Visibility="{Binding IsHybrid, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Product Scan" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Content="Manual" FontSize="13" Margin="0,0,20,0"
                                                     IsChecked="{Binding IsScanManual}" GroupName="HybridScanMode"/>
                                        <RadioButton Content="Auto" FontSize="13"
                                                     IsChecked="{Binding IsScanAuto}" GroupName="HybridScanMode"/>
                                    </StackPanel>
                                    <TextBlock Text="Scan Mode — how product barcode/scan is triggered in Hybrid workflow." FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="* " Foreground="Red" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBox Width="220" HorizontalAlignment="Left" FontSize="14" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" materialDesign:HintAssist.Background="White" Padding="5" BorderBrush="#d9dee7" MaxLength="5" Margin="0,0,0,15" Text="{Binding ScanIntervalText, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="Product Scan Interval (ms)" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                    </DockPanel>
                                    <TextBlock Text="{Binding ScanIntervalError}" Foreground="#F44336" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasScanIntervalError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="Min: 100, Max: 60000 ms — scan trigger interval when Hybrid Auto." FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Industrial Scanner – decoupled via DI, brand selectable (Zebra SDK article 000034194) -->
                    <Border Grid.Row="7" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Industrial Scanner" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Used when Weight Capture is Auto or Hybrid. Each brand requires its SDK to send trigger commands (Zebra CoreScanner, Honeywell, Datalogic)." Style="{StaticResource SubtitleStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="Brand" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                            <ComboBox Width="260" HorizontalAlignment="Left" FontSize="13"
                                      ItemsSource="{Binding ScannerBrands}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                      SelectedValue="{Binding ScannerBrand, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding ScannerBrandDisplay, StringFormat=Selected: {0}}" FontSize="11" Foreground="#666" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Auto-trigger on scan" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox IsChecked="{Binding ScannerAutoTrigger}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="When enabled and Scan Mode is Auto, the scanner is triggered via SDK (Zebra DEVICE_PULL_TRIGGER 2011) on PLC scan rising." FontSize="11" Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Scanner ID Filter (optional – serial/model)" FontSize="12" Foreground="#333" Margin="0,0,0,4"/>
                                <TextBox Width="260" HorizontalAlignment="Left" FontSize="13" Style="{StaticResource FormTextBoxStyle}" Foreground="#212121" CaretBrush="#212121" SelectionBrush="{DynamicResource BrandPrimaryBrush}" Text="{Binding ScannerIdFilter, UpdateSourceTrigger=PropertyChanged}">
                                            <materialDesign:HintAssist.Hint>
                                                <TextBlock Text="e.g. DS3608 serial or leave empty for first scanner" FontSize="15" />
                                            </materialDesign:HintAssist.Hint>
                                        </TextBox>
                                <TextBlock Text="Filters GetScanners result when multiple Zebra scanners are connected." FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                                <TextBlock FontSize="11" Foreground="#795548" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="Zebra:"/> Install Zebra_Scanner_SDK_(64bit)_v3.07+ and put scanner in USB SNAPI mode. HID Keyboard mode supports data only – no trigger control. See support.zebra.com/article/000034194.
                                </TextBlock>
                            </Border>
                            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#1976D2" Text="Use Configuration → Scanner Settings to Discover and Test scan (10s)."/>
                        </StackPanel>
                    </Border>

                    <!-- Printer Options -->
                    <Border Grid.Row="8" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Printer Options" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <CheckBox Content="Print label at Accept" FontSize="14" Margin="0,4,0,4"
                                       IsChecked="{Binding PrintAtAccept}"/>
                            <CheckBox Content="Print label at Under Weight" FontSize="14" Margin="0,4,0,4"
                                       IsChecked="{Binding PrintAtUnderWeight}"/>
                            <CheckBox Content="Print label at Over Weight" FontSize="14" Margin="0,4,0,4"
                                       IsChecked="{Binding PrintAtOverWeight}"/>
                            <TextBlock Text="A label is printed automatically when the recorded result matches a selected status." FontSize="11" Foreground="Gray" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sync -->
                    <Border Grid.Row="9" Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Sync" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Content="Enable Sync Setting" FontSize="14" IsChecked="{Binding EnableSync}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="When unchecked, background sync is paused: transaction and audit uploads stop, and queued items stay pending until sync is enabled again. Nothing is lost."
                                       FontSize="11" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="15,8">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Border>
</UserControl>
