<UserControl x:Class="ProWeighSuitePlatforms.Views.BatchStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PageBackgroundStyle}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Margin="10,0,10,10" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Click a batch to see its lot details" FontSize="13" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,4"/>
                    <Button Margin="0,0,0,4" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Command="{Binding RefreshCommand}"/>
                </WrapPanel>
            </Border>

            <Border Grid.Row="2" Margin="10,0,10,10" Padding="8" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="150"
                          ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch, Mode=TwoWay}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Batch No" Binding="{Binding BatchNo}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="Target kg" Binding="{Binding TargetKg}" Width="*"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="*"/>
                        <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt}" Width="*"/>
                        <DataGridTextColumn Header="Operator" Binding="{Binding OperatorName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="3" Margin="10,0,10,10" Padding="8" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding LotsHeader}" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="2,2,2,6"/>
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="100"
                              ItemsSource="{Binding Lots}"
                              ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lot" Binding="{Binding LotNo}" Width="*"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                            <DataGridTextColumn Header="GRN" Binding="{Binding GrnNo}" Width="*"/>
                            <DataGridTextColumn Header="Bay" Binding="{Binding BayId}" Width="*"/>
                            <DataGridTextColumn Header="Best before" Binding="{Binding BestBefore}" Width="*"/>
                            <DataGridTextColumn Header="Tubs" Binding="{Binding Tubs}" Width="*"/>
                            <DataGridTextColumn Header="Nuts" Binding="{Binding Nuts}" Width="*"/>
                            <DataGridTextColumn Header="Weight kg" Binding="{Binding WeightKg}" Width="*"/>
                            <DataGridTextColumn Header="Colour" Binding="{Binding Colour}" Width="*"/>
                            <DataGridTextColumn Header="Done tubs" Binding="{Binding DoneTubs}" Width="*"/>
                            <DataGridTextColumn Header="Done kg" Binding="{Binding DoneKg}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Paused" Binding="{Binding IsPaused}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Completed" Binding="{Binding IsCompleted}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
     </ScrollViewer>
    </Border>
</UserControl>
