<UserControl x:Class="ProWeighSuitePlatforms.Views.TraceabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Style="{StaticResource PageBackgroundStyle}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Traceability" FontSize="18" FontWeight="Bold" Foreground="#1c2430" Margin="10,4,10,8"/>
            <Border Grid.Row="1" Margin="10,0,10,10" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="180" Margin="0,0,8,4" Style="{StaticResource FormTextBoxStyle}" Text="{Binding TubId, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tub ID"/>
                    <Button Margin="0,0,0,4" Style="{StaticResource PrimaryButtonStyle}" Content="Trace" Command="{Binding SearchCommand}"/>
                </WrapPanel>
            </Border>
            <Border Grid.Row="2" Margin="10,0,10,10" Padding="8" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="120" ItemsSource="{Binding Events}"
                          ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="Auto"/>
                        <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="*"/>
                        <DataGridTextColumn Header="Weight kg" Binding="{Binding WeightKg}" Width="*"/>
                        <DataGridTextColumn Header="At" Binding="{Binding CreatedAt}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="#5b6472" Margin="10,0,10,8"/>
        </Grid>
      </ScrollViewer>
    </Border>
</UserControl>

