<UserControl x:Class="ProWeighSuitePlatforms.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}">
        <!-- Vertical scroll: 7 cards + 2 charts exceed 768px square-IPC height -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Title + Welcome ────────────────────────────────────────── -->
            <TextBlock Grid.Row="0"
                       Text="{Binding WelcomeMessage}"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,8"/>

            <!-- ── Filter bar (wraps on square IPC) ─────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,8">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding DateTypeOptions}"
                              SelectedItem="{Binding SelectedDateType, Mode=TwoWay}"
                              Width="100"
                              Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Filter by"
                              materialDesign:HintAssist.Background="White"
                              Padding="5"
                              Margin="0,0,8,0"
                              ToolTip="Choose which date field the From/To range applies to" />
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                materialDesign:HintAssist.Hint="From date"
                                materialDesign:HintAssist.Background="White"
                                Style="{StaticResource FormDatePickerStyle}"
                                Width="140" Padding="5"
                                Margin="0,0,8,4"/>
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                materialDesign:HintAssist.Hint="To date"
                                materialDesign:HintAssist.Background="White"
                                Style="{StaticResource FormDatePickerStyle}"
                                Width="140" Padding="5"
                                Margin="0,0,8,4"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                              Width="100"
                              Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Status"
                              materialDesign:HintAssist.Background="White"
                              Padding="5"
                              Margin="0,0,8,0"
                              ToolTip="Filter by result status (OK / OVER / UNDER)" />
                    <Button Command="{Binding FilterCommand}"
                            Content="Filter" Width="80" Height="30"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource SubtitleStyle}"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               Margin="8,4,0,4"/>
                </WrapPanel>
            </Border>

            <!-- ── Summary cards : fixed 3-column grid for 15" square IPC ────── -->
            <UniformGrid Grid.Row="2" Margin="0,0,0,2" Columns="3">

                <!-- Today Transactions -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,6,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="CalendarToday" Width="18" Height="18"
                                                      Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Today Txns" Style="{StaticResource SubtitleStyle}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTransactions}" FontSize="19"
                                   FontWeight="Bold" Foreground="#434242" TextAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Today Weight -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,6,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="Weight" Width="18" Height="18"
                                                      Foreground="#42A5F5" VerticalAlignment="Center"/>
                            <TextBlock Text="Today Wt (kg)" Style="{StaticResource SubtitleStyle}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayWeight, StringFormat='{}{0:N1}'}" FontSize="19"
                                   FontWeight="Bold" Foreground="#434242"  TextAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Filtered Transactions -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,6,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="FormatListNumbered" Width="18" Height="18"
                                                      Foreground="#66BB6A" VerticalAlignment="Center"/>
                            <TextBlock Text="Total Txns" Style="{StaticResource SubtitleStyle}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FilteredTransactions}" FontSize="19"
                                   FontWeight="Bold" Foreground="#434242" TextAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Filtered Weight -->
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,6,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="ScaleBalance" Width="18" Height="18"
                                                      Foreground="#EF5350" VerticalAlignment="Center"/>
                            <TextBlock Text="Total Wt (kg)" Style="{StaticResource SubtitleStyle}"  TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FilteredWeight, StringFormat='{}{0:N1}'}" FontSize="19"
                                   FontWeight="Bold"  TextAlignment="Right" Foreground="#434242"/>
                    </StackPanel>
                </Border>

                <!-- Unique Materials -->
                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,6,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="Package" Width="18" Height="18"
                                                      Foreground="#AB47BC" VerticalAlignment="Center"/>
                            <TextBlock Text="Materials" Style="{StaticResource SubtitleStyle}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalMaterials}" FontSize="19"
                                   FontWeight="Bold" Foreground="#434242" TextAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Average Weight -->
                <Border Grid.Column="5" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,6,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="ChartLine" Width="18" Height="18"
                                                      Foreground="#26C6DA" VerticalAlignment="Center"/>
                            <TextBlock Text="Avg Wt (kg)" Style="{StaticResource SubtitleStyle}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AvgWeight, StringFormat='{}{0:N3}'}" FontSize="19"
                                   FontWeight="Bold"  TextAlignment="Right" Foreground="#434242"/>
                    </StackPanel>
                </Border>

                <!-- Failed Syncs - same UI as Average Weight card, only value blinks when >1.
                     Hidden while sync is disabled in App Settings. -->
                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,6,6"
                        Cursor="Hand" ToolTip="Click to view failed transactions (is_synced=0)"
                        Visibility="{Binding IsSyncUiVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToFailedSyncsCommand}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="SyncAlert" Width="18" Height="18"
                                                      Foreground="#F44336" VerticalAlignment="Center"/>
                            <TextBlock Text="Failed Syncs" Style="{StaticResource SubtitleStyle}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FailedSyncCount}" FontSize="19"
                                   FontWeight="Bold" TextAlignment="Right" Foreground="#434242">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#434242"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailedSyncBlink}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="BlinkValue">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.5"/>
                                                        <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" From="#434242" To="#F44336" Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="BlinkValue"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Charts ─────────────────────────────────────────────────── -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top row: Daily weight trend (full width) -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Daily Weight &amp; Transaction Trend" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding DailyWeightSeries}"
                                            XAxes="{Binding DailyWeightXAxes}"
                                            YAxes="{Binding DailyWeightYAxes}"
                                            TooltipPosition="Top"
                                            ZoomMode="Both"
                                            ZoomingSpeed="3"
                                            MinHeight="160"/>
                    </Grid>
                </Border>

                <!-- Bottom row: Material donut chart (full width) -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Weight by Material" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                        <lvc:PieChart Grid.Row="1"
                                      Series="{Binding MaterialPieSeries}"
                                      TooltipPosition="Top"
                                      LegendPosition="Right"
                                      MinHeight="200"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Border>
</UserControl>