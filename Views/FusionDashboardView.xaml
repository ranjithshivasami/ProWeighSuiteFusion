<UserControl x:Class="ProWeighSuitePlatforms.Views.FusionDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Style="{StaticResource PageBackgroundStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PanningMode="VerticalOnly">
            <Grid Margin="10,4,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter + export row -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <DatePicker Width="130" Margin="0,0,8,6" Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding From, Mode=TwoWay}" materialDesign:HintAssist.Hint="From"/>
                    <DatePicker Width="130" Margin="0,0,8,6" Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding To, Mode=TwoWay}" materialDesign:HintAssist.Hint="To"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Load" Command="{Binding RefreshCommand}" Margin="0,0,12,6"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Export dashboard as image" Command="{Binding ExportDashboardImageCommand}" Margin="0,0,8,6"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Export dashboard as PDF" Command="{Binding ExportDashboardPdfCommand}" Margin="0,0,0,6"/>
                </WrapPanel>

                <!-- KPI cards -->
                <UniformGrid Grid.Row="1" Margin="0,0,0,10" Style="{DynamicResource ResponsiveKpi6Strip}">
                    <Border CornerRadius="12" Padding="16,12" Margin="0,0,6,6" Background="#6366F1">
                        <StackPanel>
                            <TextBlock Text="Total transactions" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TodayCount}" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="net of reversals" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="16,12" Margin="0,0,6,6" Background="#10B981">
                        <StackPanel>
                            <TextBlock Text="Total weight" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TodayKg, StringFormat='{}{0:0,#}'}" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text=" kg" FontSize="16" Foreground="White" VerticalAlignment="Bottom" Margin="2,0,0,4" TextWrapping="Wrap"/>
                            </WrapPanel>
                            <TextBlock FontSize="11" Foreground="White" TextWrapping="Wrap">
                                <Run Text="target "/><Run Text="{Binding TargetKg, Mode=OneWay, StringFormat='{}{0:0,#}'}"/><Run Text=" kg"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="16,12" Margin="0,0,6,6" Background="#D946EF">
                        <StackPanel>
                            <TextBlock Text="Active batches" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ActiveBatches}" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="none running" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="16,12" Margin="0,0,6,6" Background="#F59E0B">
                        <StackPanel>
                            <TextBlock Text="Active tubs" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ActiveTubs}" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock FontSize="11" Foreground="White" TextWrapping="Wrap">
                                <Run Text="of "/><Run Text="{Binding TotalTubs, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="16,12" Margin="0,0,6,6" Background="#14B8A6">
                        <StackPanel>
                            <TextBlock Text="Available tubs" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding AvailableTubs}" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="ready to assign" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="16,12" Margin="0,0,0,6" Background="#0EA5E9">
                        <StackPanel>
                            <TextBlock Text="Completed tubs" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CompletedToday}" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="weighed in range" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Charts row 1 -->
                <UniformGrid Grid.Row="2" Margin="0,0,0,10" Style="{DynamicResource ResponsiveCards3Strip}">
                    <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Supplier share (kg)" FontWeight="Bold" Foreground="#1c2430"/>
                                    <TextBlock Text="{Binding SupplierSubtitle}" FontSize="11" Foreground="#5b6472"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="PNG" Command="{Binding ExportChartPngCommand}" CommandParameter="supplier" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button Content="PDF" Command="{Binding ExportChartPdfCommand}" CommandParameter="supplier" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2"/>
                                </StackPanel>
                            </DockPanel>
                            <lvc:PieChart Grid.Row="1" Series="{Binding SupplierSeries}" LegendPosition="Bottom" MinHeight="240"/>
                        </Grid>
                    </Border>
                    <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Production vs target" FontWeight="Bold" Foreground="#1c2430"/>
                                    <TextBlock Text="{Binding TargetSubtitle}" FontSize="11" Foreground="#5b6472"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="PNG" Command="{Binding ExportChartPngCommand}" CommandParameter="target" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button Content="PDF" Command="{Binding ExportChartPdfCommand}" CommandParameter="target" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2"/>
                                </StackPanel>
                            </DockPanel>
                            <lvc:PieChart Grid.Row="1" Series="{Binding TargetSeries}" LegendPosition="Hidden" MinHeight="240"/>
                        </Grid>
                    </Border>
                    <Border Margin="0,0,0,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Hourly production (kg)" FontWeight="Bold" Foreground="#1c2430"/>
                                    <TextBlock Text="{Binding HourlySubtitle}" FontSize="11" Foreground="#5b6472"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="PNG" Command="{Binding ExportChartPngCommand}" CommandParameter="hourly" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button Content="PDF" Command="{Binding ExportChartPdfCommand}" CommandParameter="hourly" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2"/>
                                </StackPanel>
                            </DockPanel>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding HourlySeries}" XAxes="{Binding HourlyX}" YAxes="{Binding HourlyY}" MinHeight="240"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Charts row 2 -->
                <UniformGrid Grid.Row="3" Margin="0,0,0,10" Style="{DynamicResource ResponsiveCards3Strip}">
                    <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Production trend, 7 days (kg)" FontWeight="Bold" Foreground="#1c2430"/>
                                    <TextBlock Text="{Binding TrendSubtitle}" FontSize="11" Foreground="#5b6472"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="PNG" Command="{Binding ExportChartPngCommand}" CommandParameter="trend" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button Content="PDF" Command="{Binding ExportChartPdfCommand}" CommandParameter="trend" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2"/>
                                </StackPanel>
                            </DockPanel>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding TrendSeries}" XAxes="{Binding TrendX}" YAxes="{Binding TrendY}" MinHeight="220"/>
                        </Grid>
                    </Border>
                    <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Batch-wise production (kg)" FontWeight="Bold" Foreground="#1c2430"/>
                                    <TextBlock Text="{Binding BatchSubtitle}" FontSize="11" Foreground="#5b6472"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="PNG" Command="{Binding ExportChartPngCommand}" CommandParameter="batch" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button Content="PDF" Command="{Binding ExportChartPdfCommand}" CommandParameter="batch" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2"/>
                                </StackPanel>
                            </DockPanel>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding BatchSeries}" XAxes="{Binding BatchX}" YAxes="{Binding BatchY}" MinHeight="220"/>
                        </Grid>
                    </Border>
                    <Border Margin="0,0,0,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Bay-wise production (kg)" FontWeight="Bold" Foreground="#1c2430"/>
                                    <TextBlock Text="{Binding BaySubtitle}" FontSize="11" Foreground="#5b6472"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="PNG" Command="{Binding ExportChartPngCommand}" CommandParameter="bay" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button Content="PDF" Command="{Binding ExportChartPdfCommand}" CommandParameter="bay" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2"/>
                                </StackPanel>
                            </DockPanel>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding BaySeries}" XAxes="{Binding BayX}" YAxes="{Binding BayY}" MinHeight="220"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <TextBlock Grid.Row="4" Text="{Binding StatusText}" Foreground="#5b6472"/>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>

