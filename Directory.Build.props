<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Transitive deps of LiveChartsCore (OpenTK, OpenTK.GLWpfControl,
         SkiaSharp.Views.WPF) only ship .NET Framework assets but work correctly
         in a self-contained net8.0-windows app, so NU1701 is noise here. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
</Project>
