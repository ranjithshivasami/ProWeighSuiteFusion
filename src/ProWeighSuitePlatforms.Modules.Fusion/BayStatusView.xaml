<UserControl x:Class="ProWeighSuitePlatforms.Modules.Fusion.BayStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors;assembly=ProWeighSuitePlatforms.Core"
             xmlns:converters="clr-namespace:ProWeighSuitePlatforms.Converters;assembly=ProWeighSuitePlatforms.Core"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="BasicTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <!-- Wraps header text instead of trimming it with an ellipsis when columns are tight. -->
        <Style x:Key="WrappingTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="WrapWithOverflow" TextTrimming="None"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiIconStyle" TargetType="Border">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OccupancyBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="3" Background="Transparent"/>
                                <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="Background" Value="#E8EEFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PageBackgroundStyle}" Padding="8,12" behaviors:AutoFocusBehavior.IsEnabled="True">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Margin="4,0,4,8">
                <!-- 5 cards: 4 columns on wide, 3 below 1280px, 2 below 650px, 1 below 450px. Columns via Style setters only. -->
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Columns" Value="4"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                <Setter Property="Columns" Value="3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=650}" Value="True">
                                <Setter Property="Columns" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=450}" Value="True">
                                <Setter Property="Columns" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#10B981">
                            <TextBlock Text="▦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiBays}" FontSize="22" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="26"/>
                            <TextBlock Text="Bays" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#34D399">
                            <TextBlock Text="◉" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiMaxCapacity}" FontSize="20" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="Max capacity" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#A3A847">
                            <TextBlock Text="◐" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiOccupied}" FontSize="20" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="Occupied" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#F05252">
                            <TextBlock Text="▲" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiAvailable}" FontSize="20" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="Available" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,0,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#38BDF8">
                            <TextBlock Text="◆" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiCongested}" FontSize="22" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="26"/>
                            <TextBlock Text="Nearly full or full" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1" Margin="4,0,4,8" Visibility="{Binding IsFormExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Padding="16,12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="14" Foreground="#111827" Margin="0,0,0,4"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="6,8,6,8">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding NewBayId, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                                         materialDesign:HintAssist.FloatingScale="0.9">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Bay"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </TextBox>
                                <TextBlock Text="{Binding NewBayIdError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding NewBayIdError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding NewCapacityText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="9" InputScope="Number"
                                         behaviors:NumericInputBehavior.Mode="Integer"
                                         materialDesign:HintAssist.FloatingScale="0.9">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Max capacity (count)"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </TextBox>
                                <TextBlock Text="{Binding NewCapacityError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding NewCapacityError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding SubmitButtonText}" Command="{Binding AddBayCommand}"/>
                                <Button Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelEditCommand}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Command="{Binding RefreshCommand}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="4,0,4,8" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,16,16,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Coconut store bays" FontWeight="SemiBold" FontSize="14" Foreground="#111827" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1" x:Name="BayGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding Rows}"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              BorderBrush="#E5E7EB" BorderThickness="0"
                              MaxHeight="420" VerticalAlignment="Top"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource WrappingTableHeaderStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                                <Setter Property="MinHeight" Value="32"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                                <Setter Property="Padding" Value="10,4"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bay" Binding="{Binding BayId}" IsReadOnly="True" Width="0.6*" MinWidth="55" SortMemberPath="BayId">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Max capacity (nuts)" Width="1*" MinWidth="90" IsReadOnly="True" SortMemberPath="MaxCapacityNuts">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F3F4F6" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" MinWidth="70">
                                            <TextBox Text="{Binding CapacityText, UpdateSourceTrigger=Explicit}"
                                                     Background="Transparent" BorderThickness="0" FontSize="12.5"
                                                     VerticalAlignment="Center" HorizontalContentAlignment="Left"
                                                     LostFocus="CapacityTextBox_LostFocus" Tag="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Occupied (nuts)" Binding="{Binding OccupiedNuts, StringFormat=N0}" IsReadOnly="True" Width="0.9*" MinWidth="85" SortMemberPath="OccupiedNuts">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Occupied %" Width="1.1*" MinWidth="95" IsReadOnly="True" SortMemberPath="OccupiedPct">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" MinWidth="80">
                                            <ProgressBar Value="{Binding OccupiedPct}" Maximum="100" Minimum="0" Style="{StaticResource OccupancyBarStyle}"/>
                                            <TextBlock Text="{Binding OccupiedPct, StringFormat={}{0:N0}% occupied}" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Available (nuts)" Binding="{Binding AvailableNuts, StringFormat=N0}" IsReadOnly="True" Width="0.9*" MinWidth="85" SortMemberPath="AvailableNuts">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="0.8*" MinWidth="75" IsReadOnly="True" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DEF7EC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Nearly full"><Setter Property="Background" Value="#FDF1CC"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Full"><Setter Property="Background" Value="#FCE8E8"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="No capacity"><Setter Property="Background" Value="#EDEFf1"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inactive"><Setter Property="Background" Value="#FCE8E8"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#03543F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Nearly full"><Setter Property="Foreground" Value="#C28200"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Full"><Setter Property="Foreground" Value="#C81E1E"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="No capacity"><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inactive"><Setter Property="Foreground" Value="#C81E1E"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="GRNs in bay" Binding="{Binding GrnsDisplay}" IsReadOnly="True" Width="1.3*" MinWidth="110" SortMemberPath="GrnsDisplay">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Condition (nuts)" Width="1.5*" MinWidth="115" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding FreshNuts, StringFormat=N0}" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                            <TextBlock Text="·" FontSize="12" Foreground="#9CA3AF" Margin="6,0" VerticalAlignment="Center"/>
                                            <Ellipse Width="9" Height="9" Fill="#EAB308" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding NearNuts, StringFormat=N0}" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                            <TextBlock Text="·" FontSize="12" Foreground="#9CA3AF" Margin="6,0" VerticalAlignment="Center"/>
                                            <Ellipse Width="9" Height="9" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding ExpiredNuts, StringFormat=N0}" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active" Width="0.8*" MinWidth="75" IsReadOnly="True" SortMemberPath="ActiveText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DEF7EC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveText}" Value="Inactive">
                                                            <Setter Property="Background" Value="#FCE8E8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ActiveText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#03543F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveText}" Value="Inactive">
                                                                <Setter Property="Foreground" Value="#C81E1E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="70" MinWidth="60" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource WrappingTableHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowActionButtonStyle}" Content="⋯" Click="RowActionButton_Click"
                                                ToolTip="Actions">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Edit" FontSize="14" Padding="10,8"
                                                              Click="EditMenuItem_Click"/>
                                                    <MenuItem Header="Activate" FontSize="14" Padding="10,8"
                                                              Click="ActivateMenuItem_Click"/>
                                                    <MenuItem Header="Deactivate" FontSize="14" Padding="10,8"
                                                              Click="DeactivateMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4" Width="30" Height="30"
                    Command="{Binding ToggleFormCommand}" ToolTip="Show/hide the bay form">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Content" Value="✕"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormExpanded}" Value="False">
                                <Setter Property="Content" Value="+"/>
                                <Setter Property="FontSize" Value="16"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
           
        </Grid>
      </ScrollViewer>
    </Border>
</UserControl>

