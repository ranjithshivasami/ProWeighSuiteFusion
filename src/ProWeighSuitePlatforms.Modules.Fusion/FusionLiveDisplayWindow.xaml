<Window x:Class="ProWeighSuitePlatforms.Modules.Fusion.FusionLiveDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Display" WindowStyle="None" WindowState="Maximized"
        Background="#111827" Foreground="White">
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="40"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsLessThanConverter}, ConverterParameter=700}" Value="True">
                        <Setter Property="Margin" Value="16"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Exit display mode (Esc)" Padding="16,10" FontSize="16" Cursor="Hand" Click="Exit_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#1F2937"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#374151"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="{Binding BannerText}" FontSize="44" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SubText}" FontSize="20" Foreground="#9CA3AF" Margin="0,6,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Margin="0,24,0,0">
            <UniformGrid.Style>
                <Style TargetType="UniformGrid">
                    <Setter Property="Columns" Value="4"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsLessThanConverter}, ConverterParameter=900}" Value="True">
                            <Setter Property="Columns" Value="2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsLessThanConverter}, ConverterParameter=560}" Value="True">
                            <Setter Property="Columns" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </UniformGrid.Style>
            <StackPanel Margin="0,0,6,6">
                <TextBlock Text="WEIGHT" FontSize="16" Foreground="#9CA3AF"/>
                <TextBlock Text="{Binding WeightText}" FontSize="56" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Margin="0,0,6,6">
                <TextBlock Text="TUBS" FontSize="16" Foreground="#9CA3AF"/>
                <TextBlock Text="{Binding TubsText}" FontSize="56" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Margin="0,0,6,6">
                <TextBlock Text="COCONUTS" FontSize="16" Foreground="#9CA3AF"/>
                <TextBlock Text="{Binding NutsText}" FontSize="56" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="TURN AROUND" FontSize="16" Foreground="#9CA3AF"/>
                <TextBlock Text="{Binding TatText}" FontSize="56" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
            </StackPanel>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ProgressPct, StringFormat={}{0:F1}%}" FontSize="72" FontWeight="Bold" Foreground="#10B981"/>
            <ProgressBar Grid.Row="1" Value="{Binding ProgressPct, Mode=OneWay}" Maximum="100" Minimum="0" Height="18" Background="#1F2937" Foreground="#10B981" BorderThickness="0"/>
            <ScrollViewer Grid.Row="2" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Lots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <UniformGrid Margin="0,0,0,12">
                                <UniformGrid.Style>
                                    <Style TargetType="UniformGrid">
                                        <Setter Property="Columns" Value="3"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsLessThanConverter}, ConverterParameter=1050}" Value="True">
                                                <Setter Property="Columns" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsLessThanConverter}, ConverterParameter=700}" Value="True">
                                                <Setter Property="Columns" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UniformGrid.Style>
                                <TextBlock Text="{Binding Lot}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,6"/>
                                <ProgressBar Value="{Binding Pct}" Maximum="100" Minimum="0" Height="14" Background="#1F2937" Foreground="#10B981" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <TextBlock Text="{Binding DonePlan}" FontSize="24" Foreground="#D1D5DB" VerticalAlignment="Center" TextAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </UniformGrid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="4" Text="PROWEIGH FUSION · LIVE" FontSize="14" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </Grid>
</Window>

