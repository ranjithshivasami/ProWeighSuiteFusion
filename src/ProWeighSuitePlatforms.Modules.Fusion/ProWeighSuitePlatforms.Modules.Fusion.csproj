<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fusion product module: live weighing, batches/lots, inward stock,
    traceability, bay/tub/supplier screens, Fusion reports and data access.
    References only the consolidated Core library.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>ProWeighSuitePlatforms.Modules.Fusion</RootNamespace>
    <AssemblyName>ProWeighSuitePlatforms.Modules.Fusion</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProWeighSuitePlatforms.Core\ProWeighSuitePlatforms.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="MaterialDesignColors" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
  </ItemGroup>

</Project>
