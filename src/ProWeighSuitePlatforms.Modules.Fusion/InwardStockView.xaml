<UserControl x:Class="ProWeighSuitePlatforms.Modules.Fusion.InwardStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors;assembly=ProWeighSuitePlatforms.Core"
             xmlns:converters="clr-namespace:ProWeighSuitePlatforms.Converters;assembly=ProWeighSuitePlatforms.Core">
    <UserControl.Resources>
        <Style x:Key="BasicTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="TablePagerButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KpiIconStyle" TargetType="Border">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="Background" Value="#E8EEFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PageBackgroundStyle}" Padding="8,12" behaviors:AutoFocusBehavior.IsEnabled="True">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="1" Margin="4,0,4,8">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Columns" Value="4"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                <Setter Property="Columns" Value="3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=650}" Value="True">
                                <Setter Property="Columns" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=450}" Value="True">
                                <Setter Property="Columns" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#10B981">
                            <TextBlock Text="▦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiStock}" FontSize="22" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="26"/>
                            <TextBlock Text="Stock" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#34D399">
                            <TextBlock Text="◉" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiNuts}" FontSize="22" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="26"/>
                            <TextBlock Text="Coconuts" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,6,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#A3A847">
                            <TextBlock Text="◐" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiUsable}" FontSize="20" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="Usable nuts" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,0,6" Padding="12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Style="{StaticResource KpiIconStyle}" Background="#F05252">
                            <TextBlock Text="▲" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding KpiExpired}" FontSize="20" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Text="Expired nuts" FontSize="13" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="4,0,4,8" Visibility="{Binding IsFormExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Padding="16,12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="14" Foreground="#111827" Margin="0,0,0,4"/>
                        <UniformGrid>
                            <!-- 4 columns on 15" and above, 2 below 650px, 1 below 450px. Columns via Style setters only. -->
                            <UniformGrid.Style>
                                <Style TargetType="UniformGrid">
                                    <Setter Property="Columns" Value="4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=650}" Value="True">
                                            <Setter Property="Columns" Value="2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=450}" Value="True">
                                            <Setter Property="Columns" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Style>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" MaxLength="30" Text="{Binding TicketNo, UpdateSourceTrigger=PropertyChanged}">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Ticket no (unique)"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </TextBox>
                                <TextBlock Text="{Binding TicketNoError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding TicketNoError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding InwardDate}">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Inward date"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </DatePicker>
                                <TextBlock Text="{Binding InwardDateError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding InwardDateError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding SupplierNames}" SelectedItem="{Binding SupplierName}">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Supplier"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </ComboBox>
                                <TextBlock Text="{Binding SupplierNameError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding SupplierNameError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding MaterialNames}" SelectedItem="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Material"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </ComboBox>
                                <TextBlock Text="{Binding MaterialNameError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding MaterialNameError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <ComboBox Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding BayNames}" SelectedItem="{Binding BayId}">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Bay"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </ComboBox>
                                <TextBlock Text="{Binding BayIdError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding BayIdError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding ShelfLifeText, Mode=OneWay}" IsReadOnly="True" materialDesign:HintAssist.Hint="Shelf life (auto)" ToolTip="Shelf life fetched from materials master"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding WeightKgText, UpdateSourceTrigger=PropertyChanged}">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Weight (kg)"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </TextBox>
                                <TextBlock Text="{Binding WeightKgTextError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding WeightKgTextError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}">
                                    <materialDesign:HintAssist.Hint>
                                        <TextBlock FontSize="14">
                                            <Run Text="*" Foreground="Red"/>
                                            <Run Text=" Coconut count"/>
                                        </TextBlock>
                                    </materialDesign:HintAssist.Hint>
                                </TextBox>
                                <TextBlock Text="{Binding CountTextError}" FontSize="11" Foreground="#C81E1E" Margin="4,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding CountTextError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding ApwText, Mode=OneWay}" IsReadOnly="True" materialDesign:HintAssist.Hint="APW (calc)"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding BestBeforeText, Mode=OneWay}" IsReadOnly="True" materialDesign:HintAssist.Hint="Best before (calc)"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding NextGrnText, Mode=OneWay}" IsReadOnly="True" materialDesign:HintAssist.Hint="GRN (auto)"/>
                            </StackPanel>
                            <StackPanel Margin="6,8,6,8" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding ConditionText, Mode=OneWay}" IsReadOnly="True" materialDesign:HintAssist.Hint="Condition (calc)"/>
                            </StackPanel>
                        </UniformGrid>
                        <DockPanel LastChildFill="False" Margin="6,4,6,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                                <Button VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding SubmitButtonText}" Command="{Binding SaveCommand}"/>
                                <Button Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelEditCommand}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Command="{Binding RefreshCommand}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <WrapPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,8">
                <TextBlock Text="Inward register (supplier accounts) —" FontWeight="SemiBold" FontSize="14" Foreground="#1c2430" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                    <Ellipse Width="10" Height="10" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding LegendFreshText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#17915a" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                    <Ellipse Width="10" Height="10" Fill="#EAB308" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding LegendNearText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#C28200" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                    <Ellipse Width="10" Height="10" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding LegendExpiredText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#E5484D" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Ellipse Width="10" Height="10" Fill="#6B7280" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Consumed" FontSize="13" FontWeight="SemiBold" Foreground="#6F7F79" VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>

            <Border Grid.Row="4" Margin="4,0,4,8" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,16,16,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,0,12,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                            <Setter Property="Margin" Value="0,0,12,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Show" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                            <ComboBox Width="70" Margin="6,0" SelectedValue="{Binding PageSize}" SelectedValuePath="Content" Style="{StaticResource FormComboBoxStyle}" FontSize="12" Padding="4">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="100"/>
                            </ComboBox>
                            <TextBlock Text="entries" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,0,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1280}" Value="True">
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Search:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchTextBox" MinWidth="140" MaxWidth="220" Style="{StaticResource FormTextBoxStyle}" FontSize="12" Padding="5,4"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search GRN, supplier, material, bay..."
                                     ToolTip="Search GRN, supplier, material, bay, ticket, condition..."/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" MaxHeight="420" VerticalAlignment="Top" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding PagedRows}"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              BorderBrush="#E5E7EB" BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              FrozenColumnCount="0"
                              Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderStyle}">
                                <Setter Property="Padding" Value="32,10"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                                <Setter Property="MinHeight" Value="32"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                                <Setter Property="Padding" Value="32,4"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GRN" Binding="{Binding GrnNo}" Width="100" MinWidth="70" SortMemberPath="GrnNo">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Date" Binding="{Binding InwardDate}" Width="110" MinWidth="100" SortMemberPath="InwardDate">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNo}" Width="90" MinWidth="100" SortMemberPath="TicketNo">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="110" MinWidth="110" SortMemberPath="SupplierName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="120" MinWidth="120" SortMemberPath="MaterialName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Bay" Binding="{Binding BayId}" Width="80" MinWidth="70" SortMemberPath="BayId">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Shelf" Binding="{Binding ShelfLifeDays}" Width="110" MinWidth="60" SortMemberPath="ShelfLifeDays">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Best before" Binding="{Binding BestBefore}" Width="110" MinWidth="100" SortMemberPath="BestBefore">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Days left" Binding="{Binding DaysLeft}" Width="90" MinWidth="80" SortMemberPath="DaysLeft">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Weight kg" Binding="{Binding WeightKg, StringFormat=N0}" Width="110" MinWidth="80" SortMemberPath="WeightKg">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nuts" Binding="{Binding CoconutCount, StringFormat=N0}" Width="90" MinWidth="80" SortMemberPath="CoconutCount">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="APW" Binding="{Binding ApwKg, StringFormat=N3}" Width="80" MinWidth="70" SortMemberPath="ApwKg">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Bal kg" Binding="{Binding BalanceKg, StringFormat=N0}" Width="110" MinWidth="80" SortMemberPath="BalanceKg">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Bal nuts" Binding="{Binding BalanceNuts, StringFormat=N0}" Width="150" MinWidth="80" SortMemberPath="BalanceNuts">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Condition" Width="150" MinWidth="130" CanUserSort="True" SortMemberPath="Condition">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DEF7EC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Condition}" Value="Near expiry"><Setter Property="Background" Value="#FDF1CC"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Condition}" Value="Expired"><Setter Property="Background" Value="#FCE8E8"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Condition}" Value="Consumed"><Setter Property="Background" Value="#EDEFf1"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#22C55E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Condition}" Value="Near expiry"><Setter Property="Fill" Value="#EAB308"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Condition}" Value="Expired"><Setter Property="Fill" Value="#EF4444"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Condition}" Value="Consumed"><Setter Property="Fill" Value="#6B7280"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Fresh"/>
                                                            <Setter Property="Foreground" Value="#03543F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Condition}" Value="Near expiry"><Setter Property="Text" Value="Near Expiry"/><Setter Property="Foreground" Value="#C28200"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Condition}" Value="Expired"><Setter Property="Text" Value="Expired"/><Setter Property="Foreground" Value="#C81E1E"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Condition}" Value="Consumed"><Setter Property="Text" Value="Consumed"/><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="80" MinWidth="70" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderStyle}">
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowActionButtonStyle}" Content="?" Click="RowActionButton_Click"
                                                HorizontalAlignment="Center" ToolTip="Actions">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Edit" FontSize="14" Padding="10,8"
                                                              Click="EditMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ShowingText, Mode=OneWay}" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                            <Button Style="{StaticResource TablePagerButtonStyle}" Content="Previous" Command="{Binding PrevPageCommand}"/>
                            <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Number}" Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TablePagerButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource TablePagerButtonStyle}" Content="Next" Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="5" Text="{Binding StatusText}" Foreground="#5b6472" Margin="4,0,4,4" TextWrapping="Wrap"/>

            <Button Grid.Row="1" Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4" Width="30" Height="30"
                    Command="{Binding ToggleFormCommand}" ToolTip="Show/hide the inward form">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Content" Value="✕"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormExpanded}" Value="False">
                                <Setter Property="Content" Value="+"/>
                                <Setter Property="FontSize" Value="16"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
      </ScrollViewer>
    </Border>
</UserControl>

