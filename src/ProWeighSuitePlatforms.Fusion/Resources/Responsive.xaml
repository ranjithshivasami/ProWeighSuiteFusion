<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:ProWeighSuitePlatforms.Converters;assembly=ProWeighSuitePlatforms.Core">

    <!-- Responsive layout primitives (WPF media queries).
         Same idea as CSharpDesignPro/WPF-Responsive-UI-Design:
         switch layout by ActualWidth. Uses x:Static to the converter
         singletons (same as the reference repo) so this dictionary is
         fully self-contained: no StaticResource ordering dependency on
         App.xaml (merged dictionaries load before the outer keys exist,
         which is why StaticResource IsLessThanConverter threw here). -->

    <!-- Responsive layout primitives (WPF media queries).
         Same idea as CSharpDesignPro/WPF-Responsive-UI-Design:
         switch layout by ActualWidth via IsLessThanConverter.

         IMPORTANT: when applying these styles, do NOT also set the
         same property locally (e.g. Columns on UniformGrid): a local
         value outranks Style triggers (WPF DP precedence) and freezes
         the layout. Columns come from the Style setters below only.

         Bindings use RelativeSource AncestorType=UserControl so the
         styles work in any view without an x:Name.
         -->

    <!-- KPI strips -->
    <Style x:Key="ResponsiveKpi5Strip" TargetType="UniformGrid">
        <Setter Property="Columns" Value="5"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1150}" Value="True">
                <Setter Property="Columns" Value="3"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=850}" Value="True">
                <Setter Property="Columns" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=560}" Value="True">
                <Setter Property="Columns" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResponsiveKpi6Strip" TargetType="UniformGrid">
        <Setter Property="Columns" Value="6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1250}" Value="True">
                <Setter Property="Columns" Value="4"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=900}" Value="True">
                <Setter Property="Columns" Value="3"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=650}" Value="True">
                <Setter Property="Columns" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=450}" Value="True">
                <Setter Property="Columns" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResponsiveKpi4Strip" TargetType="UniformGrid">
        <Setter Property="Columns" Value="4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=900}" Value="True">
                <Setter Property="Columns" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=560}" Value="True">
                <Setter Property="Columns" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResponsiveKpi3Strip" TargetType="UniformGrid">
        <Setter Property="Columns" Value="3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=850}" Value="True">
                <Setter Property="Columns" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=560}" Value="True">
                <Setter Property="Columns" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Wide chart/card rows (need more room than KPIs) -->
    <Style x:Key="ResponsiveCards3Strip" TargetType="UniformGrid">
        <Setter Property="Columns" Value="3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1050}" Value="True">
                <Setter Property="Columns" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=700}" Value="True">
                <Setter Property="Columns" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Form grids -->
    <Style x:Key="ResponsiveForm6Strip" TargetType="UniformGrid">
        <Setter Property="Columns" Value="6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=1200}" Value="True">
                <Setter Property="Columns" Value="4"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=900}" Value="True">
                <Setter Property="Columns" Value="3"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=650}" Value="True">
                <Setter Property="Columns" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=450}" Value="True">
                <Setter Property="Columns" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResponsiveForm3Strip" TargetType="UniformGrid">
        <Setter Property="Columns" Value="3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=900}" Value="True">
                <Setter Property="Columns" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=600}" Value="True">
                <Setter Property="Columns" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResponsiveForm2Strip" TargetType="UniformGrid">
        <Setter Property="Columns" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:IsLessThanConverter.Instance}, ConverterParameter=650}" Value="True">
                <Setter Property="Columns" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
