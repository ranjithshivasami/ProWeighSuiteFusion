<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ProWeigh Fusion desktop application (WinExe).
    Owns branding, version, icon, installer identity and the composition root.
    References the consolidated Core library and the Fusion product module.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>ProWeighSuitePlatforms.Fusion.Host.Program</StartupObject>
    <AssemblyName>ProWeighSuitePlatforms.Fusion</AssemblyName>
    <RootNamespace>ProWeighSuitePlatforms</RootNamespace>
    <HostFlavor>Fusion</HostFlavor>
    <BrandName>ProWeigh</BrandName>
    <BrandSuffix> Fusion</BrandSuffix>
    <BrandTagline>Intelligent Weighing Management System</BrandTagline>
    <HostRepoRoot>$(MSBuildProjectDirectory)\..\..</HostRepoRoot>
    <HostBrandDir>$(MSBuildProjectDirectory)\..\..\branding\Fusion</HostBrandDir>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <Import Project="$(HostBrandDir)\Version.props" />
  <Import Project="..\..\Branding.targets" />

  <ItemGroup>
    <AssemblyMetadata Include="ProWeighFlavor" Value="$(HostFlavor)" />
    <AssemblyMetadata Include="BrandName" Value="$(BrandName)" />
    <AssemblyMetadata Include="BrandSuffix" Value="$(BrandSuffix)" />
    <AssemblyMetadata Include="BrandTagline" Value="$(BrandTagline)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProWeighSuitePlatforms.Core\ProWeighSuitePlatforms.Core.csproj" />
    <ProjectReference Include="..\ProWeighSuitePlatforms.Modules.Fusion\ProWeighSuitePlatforms.Modules.Fusion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
