<UserControl x:Class="ProWeighSuitePlatforms.Views.ModuleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PageBackgroundStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="10,20,10,10">
                <DockPanel>
                    <TextBlock Text="Module Management" Style="{StaticResource PageTitleStyle}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"
                    Padding="12" Margin="10,0,10,10">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SubtitleStyle}" FontSize="13">
                    Core modules are always on (checked, readonly). Weighing family uses the Active radio — only one transaction at a time. Inventory group uses checkboxes (multi). Future dependent modules attach under a parent and require it.
                </TextBlock>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}"
                    Margin="10,0,10,10" Padding="0">
                <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Rows}"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" HeadersVisibility="Column"
                          SelectionMode="Single" IsReadOnly="False"
                          Style="{StaticResource AppDataGridStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Module" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource GridCellTextLeftStyle}"/>
                        <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource GridCellTextLeftStyle}"/>
                        <DataGridTemplateColumn Header="SuperAdmin" Width="110" HeaderStyle="{StaticResource AppDataGridHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding SuperAdminEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsCore, Converter={StaticResource InverseBoolConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Admin" Width="90" HeaderStyle="{StaticResource AppDataGridHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding AdminEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsCore, Converter={StaticResource InverseBoolConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Operator" Width="90" HeaderStyle="{StaticResource AppDataGridHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding OperatorEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsCore, Converter={StaticResource InverseBoolConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Active" Width="80" HeaderStyle="{StaticResource AppDataGridHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="WeighingActive"
                                                 IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsWeighing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="3" Margin="10,0,10,10" Style="{StaticResource SubtitleStyle}" FontSize="13"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
