<UserControl x:Class="ProWeighSuitePlatforms.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="30"
                    HorizontalAlignment="Left" Width="550">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" FontSize="26"
                               Text="{Binding CompanyName}" Margin="0,0,0,5"/>
                    <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="14"
                               Text="{Binding Description}" Margin="0,0,0,25"/>

                    <Separator Margin="0,0,0,20"/>

                    <TextBlock Text="Application" Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" 
                                   Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ApplicationName}" 
                                   Style="{StaticResource GridCellTextLeftStyle}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:" 
                                   Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Source={StaticResource AppVersion}, StringFormat=v{0}}"
                                   Style="{StaticResource GridCellTextLeftStyle}"
                                   ToolTip="{Binding Source={StaticResource AppVersion}, StringFormat=Version {0}}"/>
                    </Grid>

                    <Separator Margin="0,20,0,20"/>

                    <TextBlock Text="Developer" Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Company:" 
                                   Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompanyName}" 
                                   Style="{StaticResource GridCellTextLeftStyle}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Address:" 
                                   Style="{StaticResource FieldLabelStyle}" Margin="0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Address}" 
                                   Style="{StaticResource GridCellTextLeftStyle}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Contact:" 
                                   Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Contact}" 
                                   Style="{StaticResource GridCellTextLeftStyle}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Email:" 
                                   Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Email}" 
                                   Style="{StaticResource GridCellTextLeftStyle}"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Website:" 
                                   Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Website}" 
                                   Style="{StaticResource GridCellTextLeftStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
