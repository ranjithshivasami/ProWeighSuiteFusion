<UserControl x:Class="ProWeighSuitePlatforms.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ProWeighSuitePlatforms.Views"
             xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}" behaviors:AutoFocusBehavior.IsEnabled="True">
        <Grid>
            <!-- List mode: single white card -->
            <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Show entries | Search + config + New -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                            <ComboBox Width="70" Margin="6,0" SelectedValue="{Binding PageSize}" SelectedValuePath="Content" Style="{StaticResource FormComboBoxStyle}" FontSize="12" Padding="4">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="100"/>
                            </ComboBox>
                            <TextBlock Text="entries" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Search:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchTextBox" Width="180" Style="{StaticResource FormTextBoxStyle}" FontSize="12" Padding="5,4"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search"
                                     ToolTip="Filter by product name, code, category or variant"/>
                            <Button x:Name="MaterialConfigButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="MaterialConfigButton_Click" Content="⋮" Padding="10,2" ToolTip="Template / Import / Export">
                                <Button.ContextMenu>
                                    <ContextMenu Padding="4" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Template" Command="{Binding DownloadTemplateCommand}"
                                                  Visibility="{Binding CanDownloadMaterialTemplate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <MenuItem Header="Import" Command="{Binding ImportCsvCommand}"
                                                  Visibility="{Binding CanImportMaterial, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <MenuItem Header="Export" Command="{Binding ExportMaterialsCommand}"
                                                  Visibility="{Binding CanExportMaterial, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="New" Padding="14,4" FontSize="12"
                                    Command="{Binding StartCreateCommand}"
                                    Visibility="{Binding CanCreateMaterial, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Table -->
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding PagedMaterials}"
                              SelectedItem="{Binding Selected}"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              BorderBrush="#E5E7EB" BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource AppDataGridStyle}" SelectionChanged="DataGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BasicTableHeaderStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                                <Setter Property="MinHeight" Value="38"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                                <Setter Property="Padding" Value="20,8"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="S No" Width="60" IsReadOnly="True" Binding="{Binding SerialNumber}" SortMemberPath="SerialNumber">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderCenterStyle}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Image" Width="70" IsReadOnly="True" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderCenterStyle}"/>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="44" Height="44" CornerRadius="6" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Stretch="UniformToFill" Width="44" Height="44" Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <materialDesign:PackIcon Kind="ImageOutline" Width="20" Height="20" Foreground="#BDBDBD" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Product Name" Width="*" MinWidth="150" IsReadOnly="True" Binding="{Binding ProductName}" SortMemberPath="ProductName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Code" Width="Auto" MinWidth="110" IsReadOnly="True" CanUserSort="True" SortMemberPath="ProductCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductCode}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource IconActionButtonStyle}"
                                                    ToolTip="Copy Code"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding ProductCode}">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Foreground="#666"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category" Width="Auto" MinWidth="100" IsReadOnly="True" Binding="{Binding CategoryName}" SortMemberPath="CategoryName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Variant" Width="Auto" MinWidth="100" IsReadOnly="True" Binding="{Binding VariantName}" SortMemberPath="VariantName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Target Weight" Width="Auto" MinWidth="110" IsReadOnly="True" Binding="{Binding TargetWeight, StringFormat={}{0:N2} kg}" SortMemberPath="TargetWeight">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Min Weight" Width="Auto" MinWidth="100" IsReadOnly="True" Binding="{Binding MinWeight, StringFormat={}{0:N2} kg}" SortMemberPath="MinWeight">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Max Weight" Width="Auto" MinWidth="100" IsReadOnly="True" Binding="{Binding MaxWeight, StringFormat={}{0:N2} kg}" SortMemberPath="MaxWeight">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="110" CanUserSort="True" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DEF7EC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Inactive">
                                                            <Setter Property="Background" Value="#FCE8E8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#03543F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="Inactive">
                                                                <Setter Property="Foreground" Value="#C81E1E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="80" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderCenterStyle}"/>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowActionButtonStyle}" Content="⋯" Click="RowActionButton_Click"
                                                ToolTip="Actions"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Edit" FontSize="14" Padding="10,8"
                                                              Command="{Binding PlacementTarget.Tag.StartUpdateRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.Tag.CanEditMaterial, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <MenuItem Header="Delete" FontSize="14" Padding="10,8"
                                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.Tag.CanDeleteMaterial, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer: showing text + First/Previous / numbers / Next/Last -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ShowingText, Mode=OneWay}" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TablePagerButtonStyle}" Content="First" Command="{Binding FirstPageCommand}" ToolTip="First page"/>
                            <Button Style="{StaticResource TablePagerButtonStyle}" Content="Previous" Command="{Binding PrevPageCommand}"/>
                            <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Number}" Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TablePagerButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource TablePagerButtonStyle}" Content="Next" Command="{Binding NextPageCommand}"/>
                            <Button Style="{StaticResource TablePagerButtonStyle}" Content="Last" Command="{Binding LastPageCommand}" ToolTip="Last page"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Create / edit mode -->
            <views:MaterialsCreateView DataContext="{Binding CreateViewModel}">
                <views:MaterialsCreateView.Style>
                    <Style TargetType="views:MaterialsCreateView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsCreating, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:MaterialsCreateView.Style>
            </views:MaterialsCreateView>
        </Grid>
    </Border>
</UserControl>
