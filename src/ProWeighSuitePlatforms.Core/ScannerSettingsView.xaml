<UserControl x:Class="ProWeighSuitePlatforms.Views.ScannerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border Style="{StaticResource PageBackgroundStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="BarcodeScan" Width="28" Height="28" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Scanner Settings" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Select brand in App Settings, then test here. Zebra requires CoreScanner 64-bit v3.07+ and USB SNAPI mode (support.zebra.com/article/000034194)." Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="Brand" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox Width="300" HorizontalAlignment="Left" ItemsSource="{Binding Brands}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormComboBoxStyle}" Padding="8"/>
                        <TextBlock Text="HID Keyboard mode = data only, no trigger. Use SNAPI for SDK control." FontSize="11" Foreground="#795548" Margin="0,4,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Scanner ID Filter (optional serial/model)" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Width="300" HorizontalAlignment="Left" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Padding="8" materialDesign:HintAssist.Hint="Leave empty for first scanner"/>

                        <CheckBox Content="Auto-trigger on PLC scan (Hybrid Auto)" IsChecked="{Binding AutoTrigger}" Margin="0,10,0,0"/>

                        <!-- SRK-SYMD6L UHF connection (visible only when Brand=Srk) -->
                        <Border Background="#FFF8E1" CornerRadius="4" Padding="10" Margin="0,12,0,0" Visibility="{Binding IsSrk, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="SRK-SYMD6L UHF – LAN / RS232 / RS485 (EPC C1 GEN2)" FontSize="12" FontWeight="SemiBold" Foreground="#5D4037" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="Connection" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding ConnectionType, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource FormComboBoxStyle}" Padding="8">
                                            <ComboBoxItem Content="LAN"/><ComboBoxItem Content="RS232"/><ComboBoxItem Content="RS485"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8" Visibility="{Binding IsLan, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="IP Address" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Padding="8" materialDesign:HintAssist.Hint="192.168.1.250"/>
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,12,8" Visibility="{Binding IsLan, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="TCP Port" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Padding="8" materialDesign:HintAssist.Hint="60000"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,12,8" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="COM Port" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Padding="8" materialDesign:HintAssist.Hint="COM1"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,12,8" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Baud Rate" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Padding="8" materialDesign:HintAssist.Hint="115200"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,12,8">
                                        <TextBlock Text="Mode (Active/Answer)" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding InventoryMode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource FormComboBoxStyle}" Padding="8">
                                            <ComboBoxItem Content="Continuous"/><ComboBoxItem Content="Triggered"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,12,8">
                                        <TextBlock Text="Power (0-30 dBm)" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding PowerDbm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Padding="8"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,12,8">
                                        <TextBlock Text="Dedup (ms)" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DedupMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Padding="8" materialDesign:HintAssist.Hint="2000"/>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,12,8">
                                        <TextBlock Text="EPC Prefix Filter (optional)" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EpcFilterPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Padding="8" materialDesign:HintAssist.Hint="e.g. 3034"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="LAN: set reader static IP via vendor tool, ping it first. Serial: match COM + baud (default 115200 8N1 – same as Hercules). Mode Continuous = reader ActiveMode (spontaneous push); Triggered = AnswerMode (poll per trigger). Test auto-saves current COM/IP first." FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Discover" Command="{Binding RefreshCommand}" Style="{StaticResource InfoButtonStyle}" Margin="0,0,8,8" Height="36" Padding="16,0"/>
                            <Button Content="Test Scan (10s)" Command="{Binding TestScanCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Height="36" Padding="16,0"/>
                            <Button Content="Trigger" Command="{Binding TriggerCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Height="36" Padding="16,0"/>
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="16,0"/>
                        </WrapPanel>

                        <Border Background="#2c2c2c" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="STATUS" FontSize="10" Foreground="#9E9E9E"/>
                                <TextBlock Text="{Binding Status}" Foreground="#FFD54F" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="LAST BARCODE" FontSize="10" Foreground="#9E9E9E"/>
                                <TextBox Text="{Binding LastLabel, Mode=OneWay}" IsReadOnly="True" Background="#1e1e1e" Foreground="#4CAF50" FontFamily="Consolas" FontSize="14" Padding="6" BorderThickness="0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tag inventory (test-only, styled like the vendor reader tool) -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Tag Inventory (test)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="TagCnt.:" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding TagCnt, Mode=OneWay}" IsReadOnly="True" Width="70" FontSize="12" FontFamily="Consolas" Padding="4" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Count" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding TotalTagReads, Mode=OneWay}" IsReadOnly="True" Width="70" FontSize="12" FontFamily="Consolas" Padding="4" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                                    <Button Content="Get" Command="{Binding GetTagsCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="70" Margin="0,0,8,0" Height="30"/>
                                    <Button Content="Stop" Command="{Binding StopTagsCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="70" Margin="0,0,8,0" Height="30"/>
                                    <Button Content="Clear" Command="{Binding ClearTagsCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="70" Margin="0,0,8,0" Height="30"/>
                                    <Button Content="Export" Command="{Binding ExportTagsCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="70" Margin="0,0,8,0" Height="30"/>
                                </WrapPanel>
                                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding InventoryWarning}" FontSize="12" Foreground="#C62828" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Visibility="{Binding InventoryWarning, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ShowMode:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Width="110" FontSize="12" ItemsSource="{Binding ShowModes}" SelectedItem="{Binding ShowMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding TagRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}"
                                          HeadersVisibility="Column" GridLinesVisibility="All" FontSize="12" Margin="0,8,0,0"
                                          FontFamily="Consolas" MinHeight="120" MaxHeight="220" VerticalAlignment="Top"
                                          CanUserResizeRows="False"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                          MinRowHeight="32">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="MinHeight" Value="32"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="4,4"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Index" Binding="{Binding Index, StringFormat={}{0:D3}}" Width="60" MinWidth="60"/>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90" MinWidth="80"/>
                                        <DataGridTextColumn Header="TagID" Binding="{Binding TagId}" Width="*" MinWidth="200"/>
                                        <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="70" MinWidth="65"/>
                                        <DataGridTextColumn Header="Ant." Binding="{Binding Antenna}" Width="60" MinWidth="55"/>
                                        <DataGridTextColumn Header="Cnt." Binding="{Binding Count}" Width="60" MinWidth="55"/>
                                        <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="70" MinWidth="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Get starts live inventory (unique tags aggregate with per-tag counts). Stop ends the session. Export writes CSV. Test-only – nothing here affects weighing." FontSize="11" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Discovered Scanners (GetScanners)" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,6"/>
                        <DataGrid Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Discovered}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12" MinHeight="60" MaxHeight="180"
                                  ColumnHeaderStyle="{StaticResource AppDataGridHeaderStyle}"
                                  VerticalAlignment="Top" CanUserResizeRows="False"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  MinRowHeight="32">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="32"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ScannerId}" Width="50"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                                <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Copy Serial to Filter to lock to one scanner when multiple are connected." FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
