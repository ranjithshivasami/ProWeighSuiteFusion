<UserControl x:Class="ProWeighSuitePlatforms.Views.PrinterConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">

	<Border Style="{StaticResource PageBackgroundStyle}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
	

			<ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
				<Border Style="{StaticResource CardBorderStyle}" Padding="15" Margin="10">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- Header -->
						<Grid Grid.Row="0" Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Column="0"
                                       Text="Zebra Printer Setup"
                                       Style="{StaticResource PageTitleStyle}"
                                       VerticalAlignment="Center"/>

							<TextBlock Grid.Column="1"
                                       FontSize="12"
                                       Foreground="Gray"
                                       VerticalAlignment="Center">
                                <Run Text="*" Foreground="Red" FontSize="14"/>
                                <Run Text=" indicates required fields"/>
							</TextBlock>
						</Grid>

						<!-- Form Fields -->
						<Grid Grid.Row="1" Margin="0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="20" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<!-- Connection Type -->
								<RowDefinition Height="Auto" />
								<!-- COM / IP row -->
								<RowDefinition Height="Auto" />
								<!-- Baud / Port row -->
								<RowDefinition Height="Auto" />
								<!-- DataBits / Subnet row -->
								<RowDefinition Height="Auto" />
								<!-- Parity / Gateway row -->
								<RowDefinition Height="Auto" />
								<!-- StopBits row -->
								<RowDefinition Height="Auto" />
								<!-- Flow / Discovered list -->
								<RowDefinition Height="Auto" />
								<!-- Detect / Find buttons -->
							</Grid.RowDefinitions>

							<!-- Connection Type (full width) -->
							<DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" LastChildFill="True" Margin="0,0,0,8">
								<TextBlock DockPanel.Dock="Left"
                                           Text="* "
                                           Foreground="Red"
                                           FontSize="20"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>

								<ComboBox FontSize="16"
										  Style="{StaticResource FormComboBoxStyle}"
                                          materialDesign:HintAssist.Hint="Connection Type"
                                          materialDesign:HintAssist.Background="White"
                                          Padding="5"
                                          Background="Transparent"
                                          BorderBrush="#d9dee7"
                                          ItemsSource="{Binding ConnectionTypes}"
                                          SelectedItem="{Binding SelectedConnectionType, Mode=TwoWay}"/>
							</DockPanel>


							<!-- Row 1: COM Port (serial) -->
							<DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="True" Margin="0,6,0,8"
                                       Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock DockPanel.Dock="Left" Text="* " Foreground="Red" FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
								<ComboBox Width="220"
                                          ItemsSource="{Binding AvailablePorts}"
                                          SelectedItem="{Binding SelectedComPort, Mode=TwoWay}"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          materialDesign:HintAssist.Hint="COM Port"
                                          materialDesign:HintAssist.Background="White"
                                          Padding="5"/>
								<Button ToolTip="Refresh ports" Margin="6,0,0,0" Padding="6" Command="{Binding RefreshPortsCommand}" Style="{StaticResource MaterialDesignIconButton}">
									<materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
								</Button>
							</DockPanel>

							<!-- Row 1: IP Address (tcp) -->
							<DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="True" Margin="0,8,0,8"
                                       Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock DockPanel.Dock="Left" Text="* " Foreground="Red" FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
								<TextBox Width="220"
										 HorizontalAlignment="Left"
                                         Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Ip Address"
                                         materialDesign:HintAssist.Background="White"
                                         Padding="5"/>
							</DockPanel>

							<!-- Row 2: Baud Rate (serial) -->
							<DockPanel Grid.Row="2" Grid.Column="0" LastChildFill="True" Margin="20,8,0,8"
                                       Visibility="{Binding IsComMode, Converter={StaticResource BoolToVisibilityConverter}}">
								<ComboBox Width="220" HorizontalAlignment="Left"
                                          ItemsSource="{Binding BaudRates}"
                                          SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          materialDesign:HintAssist.Hint="Baud Rate"
                                          materialDesign:HintAssist.Background="White"
                                          Padding="5"/>
							</DockPanel>

							<!-- Row 2: Port (tcp) -->
							<DockPanel Grid.Row="2" Grid.Column="0" LastChildFill="True" Margin="15,8,0,8"
                                       Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVisibilityConverter}}">

								<TextBox Width="220"
										 HorizontalAlignment="Left"
                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="port"
                                         materialDesign:HintAssist.Background="White"
                                         Padding="5"/>
							</DockPanel>

							<!-- Row 3: Data Bits (serial) -->
							<DockPanel Grid.Row="3" Grid.Column="0" LastChildFill="True" Margin="20,8,0,8"
                                       Visibility="{Binding IsComMode, Converter={StaticResource BoolToVisibilityConverter}}">

								<ComboBox Width="220"
										  HorizontalAlignment="Left"
                                          ItemsSource="{Binding DataBitsOptions}"
                                          SelectedItem="{Binding SelectedDataBits, Mode=TwoWay}"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          materialDesign:HintAssist.Hint="Data Bits"
                                          materialDesign:HintAssist.Background="White"
                                          Padding="5"/>
							</DockPanel>

							<!-- Row 3: Subnet Mask (tcp) -->
							<DockPanel Grid.Row="3" Grid.Column="0" LastChildFill="True" Margin="15,8,0,8"
                                       Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBox Width="220"
										 HorizontalAlignment="Left"
                                         Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Subnet Mask"
                                         materialDesign:HintAssist.Background="White"
                                         Padding="5"/>
							</DockPanel>

							<!-- Row 4: Parity (serial) -->
							<DockPanel Grid.Row="4" Grid.Column="0" LastChildFill="True" Margin="20,8,0,8"
                                       Visibility="{Binding IsComMode, Converter={StaticResource BoolToVisibilityConverter}}">
								<ComboBox Width="220"
										  HorizontalAlignment="Left"
                                          ItemsSource="{Binding ParityOptions}"
                                          SelectedItem="{Binding SelectedParity, Mode=TwoWay}"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          materialDesign:HintAssist.Hint="Parity"
                                          materialDesign:HintAssist.Background="White"
                                          Padding="5"/>
							</DockPanel>

							<!-- Row 4: Gateway (tcp) -->
							<DockPanel Grid.Row="4" Grid.Column="0" LastChildFill="True" Margin="15,8,0,8"
                                       Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBox Width="220"
										 HorizontalAlignment="Left"
                                         Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Gateway"
                                         materialDesign:HintAssist.Background="White"
                                         Padding="5"/>
							</DockPanel>

							<!-- Row 5: Stop Bits (serial) -->
							<DockPanel Grid.Row="5" Grid.Column="0" LastChildFill="True" Margin="20,8,0,8"
                                       Visibility="{Binding IsComMode, Converter={StaticResource BoolToVisibilityConverter}}">
								<ComboBox Width="220"
										  HorizontalAlignment="Left"
                                          ItemsSource="{Binding StopBitsOptions}"
                                          SelectedItem="{Binding SelectedStopBits, Mode=TwoWay}"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          materialDesign:HintAssist.Hint="Stop Bits"
                                          materialDesign:HintAssist.Background="White"
                                          Padding="5"/>
							</DockPanel>

							<!-- Row 6: Flow Control (serial) -->
							<DockPanel Grid.Row="6" Grid.Column="0" LastChildFill="True" Margin="20,8,0,8"
                                       Visibility="{Binding IsComMode, Converter={StaticResource BoolToVisibilityConverter}}">
								<ComboBox Width="220"
										  HorizontalAlignment="Left"
                                          ItemsSource="{Binding FlowControlOptions}"
                                          SelectedItem="{Binding SelectedFlowControl, Mode=TwoWay}"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          materialDesign:HintAssist.Hint="Flow Control"
                                          materialDesign:HintAssist.Background="White"
                                          Padding="5"/>
							</DockPanel>

							<!-- Row 6: Discovered Printers (tcp) -->

							<!-- Row 7: Buttons -->
							<StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
										HorizontalAlignment="Left" Margin="20,8,0,8">
								<Button Content="Detect Printer" Command="{Binding DetectPrinterCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="12,6" Margin="0,0,12,0"
                                        Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

								<Button Content="Test Connection" Command="{Binding TestConnectionCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6" Margin="0,0,8,0"
                                        Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

								<Button Content="Find Printers" Command="{Binding FindPrintersCommand}"
                                        Style="{StaticResource InfoButtonStyle}"
                                        Padding="12,6"
                                        Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
							</StackPanel>

						</Grid>

						<!-- Status and Actions -->
						<Grid Grid.Row="2" Margin="0,16,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Fill="#BDBDBD">
									<Ellipse.Style>
										<Style TargetType="Ellipse">
											<Setter Property="Fill" Value="#BDBDBD"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsConnected}" Value="True">
													<Setter Property="Fill" Value="{StaticResource SuccessGreenBrush}"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Ellipse.Style>
								</Ellipse>

								<TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="13" Foreground="#333"/>
							</StackPanel>

							<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
								<Button Command="{Binding TestPrintCommand}" Margin="6,0" Padding="12,6" Style="{StaticResource InfoButtonStyle}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
										<TextBlock Text="Test Print" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<Button Command="{Binding SaveCommand}" Margin="6,0" Padding="12,6" Style="{StaticResource PrimaryButtonStyle}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
										<TextBlock Text="Save Configuration" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>

								<Button Command="{Binding LoadDefaultsCommand}" Margin="6,0" Padding="12,6" Style="{StaticResource SecondaryButtonStyle}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon Kind="Restore" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
										<TextBlock Text="Default Settings" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
							</StackPanel>
						</Grid>

						<!-- Test ZPL Reference -->
						<StackPanel Grid.Row="3" Margin="0,18,0,0">
							<TextBlock Text="Test ZPL Command" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
							<Border Padding="10" Style="{StaticResource SettingsCardBorderStyle}">
								<TextBlock Text="^XA^FO50,50^ADN,36,20^FDPrinter Test^FS^FO50,100^ADN,18,10^FDZT231 Connected^FS^XZ" FontFamily="Consolas" FontSize="11"/>
							</Border>
						</StackPanel>

					</Grid>
				</Border>
			</ScrollViewer>
		</Grid>
	</Border>
</UserControl>
