<UserControl x:Class="ProWeighSuitePlatforms.Views.ScaleSettingsCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
             xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Required fields note (title now shown in top bar dynamically) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock HorizontalAlignment="Right"
                       FontSize="12"
                       Foreground="Gray"
                       VerticalAlignment="Center">
                <Run Text="*" Foreground="Red" FontSize="14"/>
                <Run Text=" indicates required fields"/>
            </TextBlock>
        </Grid>

        <!-- Two Column Layout for Form Fields -->
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left Column - Row 0: Scale Name Field -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <TextBox FontSize="16"
                             Style="{StaticResource FormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Scale Name"
                             materialDesign:HintAssist.Background="White"
                             Padding="5"
                             Background="Transparent"
                             BorderBrush="#d9dee7"
                             MaxLength="100"
                             Text="{Binding CreateScaleName, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="Must be 2-100 characters" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
                <TextBlock Text="{Binding ScaleNameError}" 
                           FontSize="11" 
                           Foreground="Red"
                           Margin="30,3,0,0"
                           Visibility="{Binding ScaleNameError, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Right Column - Row 0: Connection Type -->
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <ComboBox FontSize="16"
                              Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Connection Type"
                              materialDesign:HintAssist.Background="White"
                              Padding="5"
                              Background="Transparent"
                              BorderBrush="#d9dee7"
                              ItemsSource="{Binding ConnectionTypes}"
                              SelectedItem="{Binding ConnectionType}" SelectionChanged="ComboBox_SelectionChanged"/>
                </DockPanel>
                <TextBlock Text="Choose SerialPort or TCP connection" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Serial Port Settings (Visible only when SerialPort is selected) -->
            <!-- Left Column - Row 1: Port Field -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20" Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                 Content="Refresh"
                                 Command="{Binding RefreshPortsCommand}"
                                 Margin="5,0,0,0"
                                 Padding="8,4"
                                 Style="{StaticResource SecondaryButtonStyle}"/>
                        <ComboBox FontSize="16"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  materialDesign:HintAssist.Hint="Port"
                                  materialDesign:HintAssist.Background="White"
                                  Padding="5"
                                  Background="Transparent"
                                  BorderBrush="#d9dee7"
                                  ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}"/>
                    </DockPanel>
                </DockPanel>
                <TextBlock Text="Select the COM port for the scale" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Right Column - Row 1: Baud Rate Field -->
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20" Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <ComboBox FontSize="16"
                              Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Baud Rate"
                              materialDesign:HintAssist.Background="White"
                              Padding="5"
                              Background="Transparent"
                              BorderBrush="#d9dee7"
                              SelectedValue="{Binding BaudRate}" 
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="1200"/>
                        <ComboBoxItem Content="2400"/>
                        <ComboBoxItem Content="4800"/>
                        <ComboBoxItem Content="9600"/>
                        <ComboBoxItem Content="19200"/>
                        <ComboBoxItem Content="38400"/>
                        <ComboBoxItem Content="57600"/>
                        <ComboBoxItem Content="115200"/>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="Communication speed (typically 9600)" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- TCP/IP Settings (Visible only when TCP is selected) -->
            <!-- Left Column - Row 1: IP Address Field -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20" Visibility="{Binding IsTcp, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <TextBox FontSize="16"
                             Style="{StaticResource FormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="IP Address"
                             materialDesign:HintAssist.Background="White"
                             Padding="5"
                             Background="Transparent"
                             BorderBrush="#d9dee7"
                             Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="IP address of the scale (e.g., 192.168.1.100)" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Right Column - Row 1: TCP Port Field -->
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20" Visibility="{Binding IsTcp, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <TextBox FontSize="16"
                             Style="{StaticResource FormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Port"
                             materialDesign:HintAssist.Background="White"
                             Padding="5"
                             Background="Transparent"
                             BorderBrush="#d9dee7"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="TCP port number (typically 5000 or 9100)" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Connection Error Display -->
            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding ConnectionError}" 
                       FontSize="11" 
                       Foreground="Red"
                       Margin="30,0,0,10"
                       Visibility="{Binding ConnectionError, Converter={StaticResource NullToVisibilityConverter}}"/>

            <!-- Left Column - Row 3: Parity Field (Serial Port Only) -->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20" Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="   " 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <ComboBox FontSize="16"
                              Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Parity"
                              materialDesign:HintAssist.Background="White"
                              Padding="5"
                              Background="Transparent"
                              BorderBrush="#d9dee7"
                              SelectedValue="{Binding Parity}" 
                              SelectedValuePath="Tag">
                        <ComboBoxItem Tag="{x:Static ports:Parity.None}" Content="None"/>
                        <ComboBoxItem Tag="{x:Static ports:Parity.Odd}" Content="Odd"/>
                        <ComboBoxItem Tag="{x:Static ports:Parity.Even}" Content="Even"/>
                        <ComboBoxItem Tag="{x:Static ports:Parity.Mark}" Content="Mark"/>
                        <ComboBoxItem Tag="{x:Static ports:Parity.Space}" Content="Space"/>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="Error checking method (typically None)" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Right Column - Row 3: Data Bits Field (Serial Port Only) -->
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20" Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="   " 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <ComboBox FontSize="16"
                              Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Data Bits"
                              materialDesign:HintAssist.Background="White"
                              Padding="5"
                              Background="Transparent"
                              BorderBrush="#d9dee7"
                              SelectedValue="{Binding DataBits}" 
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="Number of data bits per byte (typically 8)" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Left Column - Row 4: Stop Bits Field (Serial Port Only) -->
            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,20" Visibility="{Binding IsSerialPort, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="   " 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <ComboBox FontSize="16"
                              Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Stop Bits"
                              materialDesign:HintAssist.Background="White"
                              Padding="5"
                              Background="Transparent"
                              BorderBrush="#d9dee7"
                              SelectedValue="{Binding StopBits}" 
                              SelectedValuePath="Tag">
                        <ComboBoxItem Tag="{x:Static ports:StopBits.One}" Content="One"/>
                        <ComboBoxItem Tag="{x:Static ports:StopBits.Two}" Content="Two"/>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="Stop bits to signal end of transmission (typically One)" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Right Column - Row 4: Request Mode Field -->
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" 
                               Text="* " 
                               Foreground="Red" 
                               FontSize="20" 
                               Margin="0,0,5,0" 
                               VerticalAlignment="Center"/>
                    <ComboBox FontSize="16"
                              Style="{StaticResource FormComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Request Mode"
                              materialDesign:HintAssist.Background="White"
                              Padding="5"
                              Background="Transparent"
                              BorderBrush="#d9dee7"
                              SelectedValue="{Binding Mode}" 
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="Continuous"/>
                        <ComboBoxItem Content="SICS"/>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="Scale request mode (Continuous or SICS)" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
                <TextBlock Text="{Binding ModeError}" 
                           FontSize="11" 
                           Foreground="Red"
                           Margin="30,3,0,0"
                           Visibility="{Binding ModeError, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Left Column - Row 5: Status Field -->
            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,5,0,0">
                <CheckBox Content="Active"
                          FontSize="16"
                          IsChecked="{Binding IsActive}"
                          Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Right Column - Row 5: Zero Return -->
            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,5,0,0">
                <TextBlock Text="Zero Return" 
                           FontSize="16" 
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="True" 
                                 FontSize="14"
                                 Margin="0,0,20,0"
                                 IsChecked="{Binding ZeroReturn}"
                                 GroupName="ZeroReturnCreate"/>
                    <RadioButton Content="False" 
                                 FontSize="14"
                                 IsChecked="{Binding ZeroReturn, Converter={StaticResource InverseBooleanConverter}}"
                                 GroupName="ZeroReturnCreate"/>
                </StackPanel>
                <TextBlock Text="Enable or disable zero return on the scale" 
                           FontSize="11" 
                           Foreground="Gray"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Left Column - Row 6: Location -->
            <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,20,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="   "
                               FontSize="20"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                    <TextBox FontSize="16"
                             Style="{StaticResource FormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Location"
                             materialDesign:HintAssist.Background="White"
                             Padding="5"
                             Background="Transparent"
                             BorderBrush="#d9dee7"
                             MaxLength="100"
                             Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="Physical location of the scale"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
            </StackPanel>

            <!-- Right Column - Row 6: Scale Code -->
            <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,20,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="* "
                               Foreground="Red"
                               FontSize="20"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                    <TextBox FontSize="16"
                             Style="{StaticResource FormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Scale Code"
                             materialDesign:HintAssist.Background="White"
                             Padding="5"
                             Background="Transparent"
                             BorderBrush="#d9dee7"
                             MaxLength="4"
                             Text="{Binding ScaleCode, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="ScaleCode_PreviewTextInput"/>
                </DockPanel>
                <TextBlock Text="Numeric code between 1 and 9999"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="30,3,0,0"/>
                <TextBlock Text="{Binding ScaleCodeError}"
                           FontSize="11"
                           Foreground="Red"
                           Margin="30,3,0,0"
                           Visibility="{Binding ScaleCodeError, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Received Data Preview (Full Width) -->
        <StackPanel Grid.Row="2" Margin="0,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Test Connection"
                        Command="{Binding TestConnectionCommand}"
                        Margin="5,0,0,5"
                        Style="{StaticResource InfoButtonStyle}"/>
                <TextBlock Text="Received Data Preview" 
                           Style="{StaticResource SectionTitleStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,5"/>
            </DockPanel>
            <Border Padding="8" 
                    Style="{StaticResource SettingsCardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="100">
                    <TextBlock Text="{Binding ReceivedData}" 
                               TextWrapping="Wrap"
                               Foreground="#333333"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <!-- Save button shown when not updating -->
            <Button Content="Save" Command="{Binding CreateCommand}" Margin="6,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Update button shown when updating -->
            <Button Content="Update" Command="{Binding UpdateCommand}" Margin="6,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Cancel" Command="{Binding CancelCreateCommand}" Margin="6,0"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
