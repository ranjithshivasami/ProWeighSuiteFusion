<UserControl x:Class="ProWeighSuitePlatforms.Views.RecentTransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Style="{StaticResource PageBackgroundStyle}" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter Bar -->
            <Border Grid.Row="1" Margin="10,0,10,10" Padding="12,20,12,20" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        
                    </Grid.RowDefinitions>

                    <!-- Date pickers + Sync Status + Filter/Reset -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="From date"
                                        materialDesign:HintAssist.Background="White"
                                        Width="105" 
                                        Style="{StaticResource FormDatePickerStyle}"
                                        Padding="5"
                                        FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        materialDesign:HintAssist.Hint="To date"
                                        materialDesign:HintAssist.Background="White"
                                        Width="105" 
                                        Style="{StaticResource FormDatePickerStyle}"
                                        Padding="5"
                                        FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <ComboBox ItemsSource="{Binding SyncFilterOptions}" 
                                      SelectedItem="{Binding SelectedSyncFilter}" 
                                      Width="100" 
                                      FontSize="14"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="Sync Status"
                                      materialDesign:HintAssist.Background="White"
                                      Padding="5"/>
                        </StackPanel>
                        <Button Command="{Binding ApplyFilterCommand}"
                                Content="Filter" Width="75" Height="30" Margin="0,0,6,4"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Command="{Binding ClearFilterCommand}"
                                Content="Reset" Width="75" Height="30" Margin="0,0,6,4"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                       
                    </StackPanel>

                    <!-- Middle: Search like Report -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180"
                                 MinWidth="120"
                                 HorizontalAlignment="Left"
                                 FontSize="14"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 materialDesign:HintAssist.Hint="Search all columns"
                                 Padding="5"
                                 materialDesign:HintAssist.Background="White" />
                    </StackPanel>

                    <!-- Page Size (right side) -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <TextBlock FontSize="14" Text="Page Size:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="60" FontSize="14" HorizontalContentAlignment="Right" SelectedValue="{Binding PageSize}" SelectedValuePath="Content">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="20" IsSelected="True"/>
                            <ComboBoxItem Content="50"/>
                            <ComboBoxItem Content="100"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Status message -->
                    
                </Grid>
            </Border>

            <!-- DataGrid -->
            <Border Grid.Row="2" Margin="10,0,10,10" Padding="0" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              Padding="8">
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding PagedTransactions}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="6 3 6 3"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8 4 8 4"
                              materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent"
                              Style="{StaticResource AppDataGridStyle}"
                              RowStyle="{StaticResource AppDataGridRowStyle}"
                              CellStyle="{StaticResource AppDataGridCellStyle}"
                              SelectionChanged="DataGrid_SelectionChanged"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto"
                              EnableColumnVirtualization="False"
                              EnableRowVirtualization="False"
                              MinWidth="1200"
                              Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderStyle}">
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- # -->
                        <DataGridTextColumn Header="#" Width="50" MinWidth="50" IsReadOnly="True" Binding="{Binding SlNo}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderCenterStyle}">
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Trans No -->
                        <DataGridTemplateColumn Header="Transaction UUID" Width="*" MinWidth="300" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IdUpperCase}" 
                                               Padding="6,3,6,3" 
                                               FontSize="13" 
                                               HorizontalAlignment="Left"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu Padding="0">
                                                <MenuItem Header="Copy" 
                                                          Command="{Binding PlacementTarget.Tag.CopyTransactionIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding}"
                                                          Padding="6,1,6,1"
                                                          Height="20"
                                                          MinHeight="20">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Batch Number -->
                        <DataGridTemplateColumn Header="Batch Number" Width="*" MinWidth="140" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BatchNumber}" 
                                               Padding="6,3,6,3" 
                                               FontSize="13" 
                                               FontWeight="Medium" 
                                               HorizontalAlignment="Left"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu Padding="0">
                                                <MenuItem Header="Copy" 
                                                          Command="{Binding PlacementTarget.Tag.CopyBatchNumberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding}"
                                                          Padding="6,1,6,1"
                                                          Height="20"
                                                          MinHeight="20">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Material Code -->
                        <DataGridTemplateColumn Header="Material Code" Width="Auto" MinWidth="100" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MaterialCode}" 
                                               Padding="6,3,6,3" 
                                               FontSize="13" 
                                               HorizontalAlignment="Left"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu Padding="0">
                                                <MenuItem Header="Copy" 
                                                          Command="{Binding PlacementTarget.Tag.CopyMaterialCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                          CommandParameter="{Binding}"
                                                          Padding="6,1,6,1"
                                                          Height="20"
                                                          MinHeight="20">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Material Name -->
                        <DataGridTextColumn Header="Material Name" Binding="{Binding MaterialName}" Width="*" IsReadOnly="True" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Category -->
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto" MinWidth="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Variant -->
                        <DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="Auto" MinWidth="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Weight -->
                        <DataGridTextColumn Header="Achieved Weight" Binding="{Binding ActualWeight, StringFormat=F3}" Width="Auto" MinWidth="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextRightStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- UOM -->
                        <DataGridTextColumn Header="UOM" Binding="{Binding Unit}" Width="Auto" MinWidth="50" IsReadOnly="True">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderCenterStyle}">
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextCenterStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Weighed By -->
                        <DataGridTextColumn Header="Weighed By" Binding="{Binding WeighedBy}" Width="Auto" MinWidth="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Weighed Date & Time -->
                        <DataGridTextColumn Header="Weighed Date &amp; Time" Binding="{Binding WeighedDate}" Width="Auto" MinWidth="150" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextLeftStyle}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Sync Status -->
                        <DataGridTemplateColumn Header="Sync Status" Width="Auto" MinWidth="100" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="8,6">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="CloseCircle"/>
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="{Binding SyncStatusText}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="240" IsReadOnly="True">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderCenterStyle}">
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="2">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding DataContext.ViewTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}"
                                                     Style="{StaticResource InfoButtonStyle}"
                                                     Padding="6,1" Margin="0,0,10,0" FontSize="12"
                                                     Cursor="Hand"
                                                     Height="24">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Eye" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="View" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DataContext.ViewServerResponseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}"
                                                     Style="{StaticResource SecondaryButtonStyle}"
                                                     Padding="6,1" Margin="0,0,10,0" FontSize="12"
                                                     Cursor="Hand"
                                                     ToolTip="View the server response for this transaction"
                                                     Height="24">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Web" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="Response" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DataContext.SyncTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}"
                                                     Style="{StaticResource PrimaryButtonStyle}"
                                                     Padding="6,1" Margin="0" FontSize="12"
                                                     Cursor="Hand"
                                                     IsEnabled="{Binding CanSync}"
                                                     Height="24">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="{Binding SyncButtonIcon}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{Binding SyncButtonLabel}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </ScrollViewer>
            </Border>

            <!-- Pagination Controls (keeping current style) -->
            <Border Grid.Row="3" 
                    Margin="10,5,10,5" 
                    Style="{StaticResource PaginationBarStyle}"
                    VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page info -->
                    <TextBlock Grid.Column="0" Text="{Binding PageInfo}" VerticalAlignment="Center" FontSize="13" Style="{StaticResource SubtitleStyle}" Margin="8,0"/>

                    <!-- Page navigation -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button Command="{Binding FirstPageCommand}" 
                                Style="{StaticResource PaginationButtonStyle}"
                                Width="25" Height="25" Padding="0" Margin="0,0,4,0"
                                ToolTip="First page">
                            <materialDesign:PackIcon Kind="PageFirst" Width="20" Height="20" Foreground="#434242"/>
                        </Button>
                        <Button Command="{Binding PrevPageCommand}" 
                                Style="{StaticResource PaginationButtonStyle}"
                                Width="25" Height="25" Padding="0" Margin="0,0,4,0"
                                ToolTip="Previous page">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="24" Height="24" Foreground="#434242"/>
                        </Button>
                        <Border Background="#F5F5F5" 
                                CornerRadius="4" 
                                Padding="15,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Page " FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentPage}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock Text=" of " FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalPages}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding NextPageCommand}" 
                                Style="{StaticResource PaginationButtonStyle}"
                                Width="25" Height="25" Padding="0" Margin="4,0,4,0"
                                ToolTip="Next page">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24" Foreground="#434242"/>
                        </Button>
                        <Button Command="{Binding LastPageCommand}" 
                                Style="{StaticResource PaginationButtonStyle}"
                                Width="25" Height="25" Padding="0"
                                ToolTip="Last page">
                            <materialDesign:PackIcon Kind="PageLast" Width="20" Height="20" Foreground="#434242"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="4" Margin="10,0,10,0" Padding="8,4">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubtitleStyle}" FontStyle="Italic"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
