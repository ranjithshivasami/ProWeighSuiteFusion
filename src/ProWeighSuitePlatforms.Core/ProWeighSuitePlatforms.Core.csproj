<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ProWeigh Fusion core: one consolidated library that contains the former
    Core.Abstractions, Core, Core.Wpf, Platform.Hardware, Platform.Reporting,
    Platform.Reporting.Wpf, Platform.Weighing, Platform.Weighing.Wpf and
    Host.Wpf projects. All shared shell, admin (Master, Configuration, Audit
    logs, Users, Permissions, Info), weighing, reporting and hosting code.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <RootNamespace>ProWeighSuitePlatforms</RootNamespace>
    <AssemblyName>ProWeighSuitePlatforms.Core</AssemblyName>
    <!-- ZebraScannerProvider / PrintService use Windows-only APIs; the app is
         a Windows-only WPF executable, so CA1416 warnings are noise. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images\tray-icon.ico">
      <LogicalName>ProWeighSuitePlatforms.Images.tray-icon.ico</LogicalName>
    </EmbeddedResource>
    <Resource Include="Images\ta-logo.jpeg" />
    <Resource Include="Images\icon-role-permissions.png" />
    <Resource Include="Images\edit.png" />
    <Resource Include="Images\delete.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="DotNetKit.Wpf.AutoCompleteComboBox" />
    <PackageReference Include="LiteQueue" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="MaterialDesignColors" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Polly" />
    <PackageReference Include="SkiaSharp.Views.WPF" NoWarn="NU1701" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="UUIDNext" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
