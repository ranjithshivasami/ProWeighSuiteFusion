<UserControl x:Class="ProWeighSuitePlatforms.Views.ReportScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border Style="{StaticResource PageBackgroundStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="5">
                    <StackPanel MaxWidth="1200">
                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="EmailOutline" Width="32" Height="32" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Report Schedule Settings" Style="{StaticResource PageTitleStyle}"/>
                                    <TextBlock Text="Email the daily Transaction Report and Summary Report on a configurable schedule" Style="{StaticResource SubtitleStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Daily Transaction Report -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Daily Transaction Report" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                <CheckBox Content="Enable daily Transaction Report email" IsChecked="{Binding Settings.ReportEnabled}" FontSize="14" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Send time:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <ComboBox Width="90" ItemsSource="{Binding Hours}" SelectedItem="{Binding ReportHour, Mode=TwoWay}" FontSize="16" Padding="5"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" FontSize="16" Margin="4,0"/>
                                    <ComboBox Width="90" ItemsSource="{Binding Minutes}" SelectedItem="{Binding ReportMinute, Mode=TwoWay}" FontSize="16" Padding="5"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ReportTimeError}" FontSize="11" Foreground="Red" Margin="4,0,0,0" Visibility="{Binding ReportTimeError, Converter={StaticResource NullToVisibilityConverter}}"/>

                                <Button Content="Send Transaction Report Now (test)" Command="{Binding SendReportNowCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Padding="12,8" FontSize="12" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Summary Report -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Daily Summary Report" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                <CheckBox Content="Enable daily Summary Report email" IsChecked="{Binding Settings.SummaryEnabled}" FontSize="14" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Send time:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <ComboBox Width="90" ItemsSource="{Binding Hours}" SelectedItem="{Binding SummaryHour, Mode=TwoWay}" FontSize="16" Padding="5"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" FontSize="16" Margin="4,0"/>
                                    <ComboBox Width="90" ItemsSource="{Binding Minutes}" SelectedItem="{Binding SummaryMinute, Mode=TwoWay}" FontSize="16" Padding="5"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SummaryTimeError}" FontSize="11" Foreground="Red" Margin="4,0,0,0" Visibility="{Binding SummaryTimeError, Converter={StaticResource NullToVisibilityConverter}}"/>

                                <Button Content="Send Summary Report Now (test)" Command="{Binding SendSummaryNowCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Padding="12,8" FontSize="12" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Recipients -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Recipients" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                <TextBlock FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Run FontWeight="SemiBold">Company Report Email: </Run>
                                    <Run Text="{Binding CompanyReportEmail, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Text="If no override is set below, reports are emailed to the Company Report Email (configured in Company Settings)."/>
                                </TextBlock>

                                <TextBox FontSize="16"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Recipients override (comma-separated, optional)"
                                         materialDesign:HintAssist.Background="White"
                                         Padding="5"
                                         Background="Transparent"
                                         BorderBrush="#d9dee7"
                                         MaxLength="500"
                                         Text="{Binding Settings.RecipientsOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding RecipientsError}" FontSize="11" Foreground="Red" Margin="4,3,0,0" Visibility="{Binding RecipientsError, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Info -->
                        <Border Background="#E3F2FD" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#1565C0">
                                <Run FontWeight="SemiBold">How it works:</Run>
                                <Run Text=" Reports are emailed daily at the configured times. Each report covers the previous day's data. Scheduling runs while the app is open; if the app starts after the configured time on a given day, the report is sent immediately (catch-up). If the app is closed at the configured time, the report is not sent for that day."/>
                            </TextBlock>
                        </Border>

                        <!-- Status -->
                        <Border Background="#FFF8E1" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12" Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#F57C00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#5D4037" TextWrapping="Wrap" />
                             </StackPanel>
                         </Border>

                        <!-- Save -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Save Schedule" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,10" Height="45">
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
