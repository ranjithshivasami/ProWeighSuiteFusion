<Window x:Class="ProWeighSuitePlatforms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProWeighSuitePlatforms.ViewModels"
             xmlns:corevm="clr-namespace:ProWeighSuitePlatforms.ViewModels"
             xmlns:coreviews="clr-namespace:ProWeighSuitePlatforms.Views"
        xmlns:weighingvm="clr-namespace:ProWeighSuitePlatforms.ViewModels"
        xmlns:weighingviews="clr-namespace:ProWeighSuitePlatforms.Views"
        xmlns:reportingvm="clr-namespace:ProWeighSuitePlatforms.ViewModels"
        xmlns:reportingviews="clr-namespace:ProWeighSuitePlatforms.Views"
        xmlns:views="clr-namespace:ProWeighSuitePlatforms.Views"
        xmlns:behaviors="clr-namespace:ProWeighSuitePlatforms.Behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"             
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResize"
        MinWidth="800" MinHeight="600"
        FontSize="16"        
        FontFamily="{DynamicResource MaterialDesignFont}"       
        >
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}">
            <views:ShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type weighingvm:DashboardViewModel}">
            <weighingviews:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type weighingvm:SettingsViewModel}">
            <weighingviews:ScaleSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type corevm:UserManagementViewModel}">
            <coreviews:UserManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type reportingvm:ReportsViewModel}">
            <reportingviews:ReportsView />
        </DataTemplate>
        <!-- Sync Settings mapping (ensure window-level template available) -->
        <DataTemplate DataType="{x:Type corevm:SyncSettingsViewModel}">
            <coreviews:SyncSettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid behaviors:TouchKeyboardBehavior.IsEnabled="True">
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
